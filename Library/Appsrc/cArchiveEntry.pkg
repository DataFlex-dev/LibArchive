Use Archive.h.pkg

// The C runtime free function. archive_entry_acl_to_text and archive_entry_acl_to_text_w return malloc'ed memory that
// the caller has to release. archive.dll uses the universal C runtime, so ucrtbase.dll frees it.
External_Function archive_wrapper_crt_free "free" ucrtbase.dll ;
    Pointer pMemory ;
    Returns Void_Type

// Windows API functions used to turn the ANSI code page names libarchive returns for ACL entries into DataFlex strings.
External_Function archive_wrapper_MultiByteToWideChar "MultiByteToWideChar" kernel32.dll ;
    UInteger iCodePage ;
    UInteger iFlags ;
    Pointer pMultiByte ;
    Integer iMultiByteLength ;
    Pointer pWideChar ;
    Integer iWideCharLength ;
    Returns Integer

External_Function archive_wrapper_lstrlenA "lstrlenA" kernel32.dll ;
    Pointer pText ;
    Returns Integer

// One ACL entry as returned by cArchiveEntry.AclNext. eType is ARCHIVE_ENTRY_ACL_TYPE_* (0 means "no more entries"),
// iPermset the permission bits (ARCHIVE_ENTRY_ACL_*), eTag the tag (ARCHIVE_ENTRY_ACL_USER, _GROUP, ...), iQualifier the
// numeric user or group id and sName the user or group name.
Struct tArchiveEntryAcl
    Integer eType
    Integer iPermset
    Integer eTag
    Integer iQualifier
    String sName
End_Struct

// One extended attribute as returned by cArchiveEntry.XattrNext (sName is empty when there are no more attributes).
Struct tArchiveEntryXattr
    String sName
    UChar[] ucValue
End_Struct

// One data region of a sparse file as returned by cArchiveEntry.SparseNext (iLength is -1 when there are no more regions).
Struct tArchiveEntrySparse
    BigInt iOffset
    BigInt iLength
End_Struct

// Wrapper around a libarchive "struct archive_entry": the metadata of one archive member.
// An entry is either owned (created by CreateEntry, CreateEntryForArchive or CloneEntry, freed by FreeEntry / when the
// object is destroyed) or borrowed (AttachEntry with bOwns False, for example the entry that archive_read_next_header
// returned; libarchive owns it and it is only valid until the next header is read).
//
// Getters of an object without an entry return 0, False or an empty string; setters and methods do nothing (methods that
// return a libarchive result report ARCHIVE_FAILED). See Help\Classes\cArchiveEntry.md for the full reference.
Class cArchiveEntry is a cObject

    Procedure Construct_Object
        Forward Send Construct_Object

        // The libarchive entry (struct archive_entry *). 0 when there is none.
        { DesignTime = False }
        Property Pointer ppEntry 0
        // True when this object frees the entry (archive_entry_free).
        { DesignTime = False }
        Property Boolean pbOwnsEntry False
        // True: a libarchive result of ARCHIVE_FAILED or worse (ACL and xattr methods) raises a DataFlex error.
        Property Boolean pbRaiseErrors True

        // False when the last UTF-8 name setter (psPathname, psHardlink, psSymlink, psUname, psGname, psLink) stored valid text
        // that could not be converted to the ANSI code page without loss (libarchive keeps the UTF-8 text anyway). Treat it as
        // read only.
        { DesignTime = False }
        Property Boolean pbLastTextLossless True
    End_Procedure

    Procedure Destroy_Object
        Send FreeEntry
        Forward Send Destroy_Object
    End_Procedure

    // ---- helpers ------------------------------------------------------------------------------------------------

    // True when the text is valid UTF-8 (MultiByteToWideChar with MB_ERR_INVALID_CHARS). The UTF-8 name setters call this
    // before they call libarchive: invalid text is rejected with a DataFlex error, libarchive never sees it.
    Function IsValidUtf8 String sText Returns Boolean
        Integer iLength

        If (sText = "") Begin
            Function_Return True
        End
        // code page 65001 is CP_UTF8, flag 8 is MB_ERR_INVALID_CHARS; a length of -1 means zero terminated
        Move (archive_wrapper_MultiByteToWideChar (65001, 8, AddressOf (sText), -1, 0, 0)) to iLength
        Function_Return (iLength > 0)
    End_Function

    // Converts a zero terminated string pointer returned by libarchive to a DataFlex string. 0 gives "".
    Function PointerText Pointer pText Returns String
        If (pText = 0) Begin
            Function_Return ""
        End
        Function_Return (PointerToString (pText))
    End_Function

    // Converts a zero terminated string pointer in the ANSI code page of the program (what libarchive returns for ACL user
    // and group names) to a DataFlex string. 0 gives "".
    Function AnsiPointerText Pointer pText Returns String
        Integer iLength iWide
        UChar[] ucWide

        If (pText = 0) Begin
            Function_Return ""
        End
        Move (archive_wrapper_lstrlenA (pText)) to iLength
        If (iLength = 0) Begin
            Function_Return ""
        End
        Move (ResizeArray (ucWide, (iLength + 1) * 2)) to ucWide
        // code page 0 is CP_ACP
        Move (archive_wrapper_MultiByteToWideChar (0, 0, pText, iLength, AddressOf (ucWide), iLength)) to iWide
        If (iWide = 0) Begin
            Function_Return (PointerToString (pText))
        End
        Function_Return (PointerToWString (AddressOf (ucWide)))
    End_Function

    // Converts a zero terminated wide string pointer returned by libarchive to a DataFlex string. 0 gives "".
    Function PointerWideText Pointer pText Returns String
        If (pText = 0) Begin
            Function_Return ""
        End
        Function_Return (PointerToWString (pText))
    End_Function

    // Passes a libarchive result on; ARCHIVE_FAILED or worse raises a DataFlex error when pbRaiseErrors is True.
    Function CheckResult Integer iResult String sOperation Returns Integer
        If (iResult <= ARCHIVE_FAILED and pbRaiseErrors (Self)) Begin
            Error DFERR_PROGRAM (SFormat ("%1 failed (%2)", sOperation, String (iResult)))
        End
        Function_Return iResult
    End_Function

    // ---- life cycle ---------------------------------------------------------------------------------------------

    // True when the object wraps an entry.
    Function HasEntry Returns Boolean
        Function_Return (ppEntry (Self) <> 0)
    End_Function

    // Frees the current entry (when owned) and creates a new empty owned entry (archive_entry_new).
    Procedure CreateEntry
        Pointer pEntry
        Send FreeEntry
        Move (archive_entry_new ()) to pEntry
        Set ppEntry to pEntry
        Set pbOwnsEntry to True
    End_Procedure

    // Like CreateEntry, but the entry takes its character set conversion settings from a libarchive handle
    // (archive_entry_new2). pArchive is the ppArchive of a wrapper object or 0 (same as CreateEntry).
    Procedure CreateEntryForArchive Pointer pArchive
        Pointer pEntry
        Send FreeEntry
        Move (archive_entry_new2 (pArchive)) to pEntry
        Set ppEntry to pEntry
        Set pbOwnsEntry to True
    End_Procedure

    // Frees the current entry (when owned) and wraps an existing entry. When bOwns is True the object frees it.
    Procedure AttachEntry Pointer pEntry Boolean bOwns
        Send FreeEntry
        Set ppEntry to pEntry
        Set pbOwnsEntry to bOwns
    End_Procedure

    // Frees the entry when it is owned and forgets it.
    Procedure FreeEntry
        Pointer pEntry
        Void_Type iVoid

        Get ppEntry to pEntry
        If (pEntry <> 0 and pbOwnsEntry (Self)) Begin
            Move (archive_entry_free (pEntry)) to iVoid
        End
        Set ppEntry to 0
        Set pbOwnsEntry to False
    End_Procedure

    // Resets every field of the entry to its default (archive_entry_clear). The entry stays attached.
    Procedure Clear
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            Move (archive_entry_clear (pEntry)) to pEntry
        End
    End_Procedure

    // Creates a deep copy of the entry (archive_entry_clone) in a NEW cArchiveEntry object that owns the copy. The new
    // object is a sibling of this one (same parent); the caller destroys it (Send Destroy of the handle) when done.
    // Returns 0 when this object has no entry.
    Function CloneEntry Returns Handle
        Pointer pEntry pClone
        Handle hoParent hoClone

        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Move (archive_entry_clone (pEntry)) to pClone
        If (pClone = 0) Begin
            Error DFERR_PROGRAM "archive_entry_clone failed (out of memory)"
            Function_Return 0
        End
        Get Parent to hoParent
        Get Create of hoParent U_cArchiveEntry to hoClone
        Send AttachEntry of hoClone pClone True
        Function_Return hoClone
    End_Function

    // ---- names -------------------------------------------------------------------------------------------------
    // Path name, hard link, symbolic link, user name and group name have the same accessors:
    //   psX          UTF-8 text (archive_entry_X_utf8). The setter uses archive_entry_update_X_utf8. It raises a DataFlex
    //                error only when the text is not valid UTF-8 (libarchive is not called then). Valid text that can not be
    //                converted to the ANSI code page without loss (for example Japanese text on a Western Windows) is
    //                stored as it is; pbLastTextLossless tells whether the last setter call converted without loss.
    //                Setting an empty string removes the name.
    //   psXLocale    narrow text through archive_entry_X / archive_entry_set_X: the bytes of the DataFlex string (UTF-8) are
    //                passed and returned unchanged, libarchive interprets them in the ANSI code page. Only ASCII text is
    //                portable; use psX or psXWide for everything else.
    //   psXWide      wide (UTF-16) text (archive_entry_X_w / archive_entry_copy_X_w); lossless for every character.
    //   SetXUtf8     archive_entry_set_X_utf8 (no validity report; psX is the checked variant).
    //   CopyXLocale  archive_entry_copy_X (same as setting psXLocale).

    // Path name as UTF-8 text (archive_entry_pathname_utf8 / archive_entry_update_pathname_utf8). Empty when not set.
    { MethodType = Property }
    Function psPathname Returns String
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        Function_Return (PointerText (Self, archive_entry_pathname_utf8 (pEntry)))
    End_Function

    { MethodType = Property }
    Procedure Set psPathname String sValue
        Pointer pEntry
        Integer iResult
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            If (sValue = "") Begin
                Move (archive_entry_set_pathname_utf8 (pEntry, 0)) to iVoid
            End
            Else Begin
                If (not (IsValidUtf8 (Self, sValue))) Begin
                    Error DFERR_PROGRAM "Could not set the path name: the text is not valid UTF-8"
                End
                Else Begin
                    Move (archive_entry_update_pathname_utf8 (pEntry, AddressOf (sValue))) to iResult
                    Set pbLastTextLossless to (iResult <> 0)
                End
            End
        End
    End_Procedure

    // Path name in the current ANSI code page (archive_entry_pathname / archive_entry_set_pathname).
    { MethodType = Property }
    Function psPathnameLocale Returns String
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        Function_Return (PointerText (Self, archive_entry_pathname (pEntry)))
    End_Function

    { MethodType = Property }
    Procedure Set psPathnameLocale String sValue
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            If (sValue = "") Begin
                Move (archive_entry_set_pathname (pEntry, 0)) to iVoid
            End
            Else Begin
                Move (archive_entry_set_pathname (pEntry, AddressOf (sValue))) to iVoid
            End
        End
    End_Procedure

    // Path name as wide (UTF-16) text (archive_entry_pathname_w / archive_entry_copy_pathname_w).
    { MethodType = Property }
    Function psPathnameWide Returns String
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        Function_Return (PointerWideText (Self, archive_entry_pathname_w (pEntry)))
    End_Function

    { MethodType = Property }
    Procedure Set psPathnameWide String sValue
        Pointer pEntry
        Void_Type iVoid
        WString wsValue
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            If (sValue = "") Begin
                Move (archive_entry_copy_pathname_w (pEntry, 0)) to iVoid
            End
            Else Begin
                Move sValue to wsValue
                Move (archive_entry_copy_pathname_w (pEntry, AddressOf (wsValue))) to iVoid
            End
        End
    End_Procedure

    // Sets the path name from UTF-8 text without a validity report (archive_entry_set_pathname_utf8). Empty removes it.
    Procedure SetPathnameUtf8 String sValue
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            If (sValue = "") Begin
                Move (archive_entry_set_pathname_utf8 (pEntry, 0)) to iVoid
            End
            Else Begin
                Move (archive_entry_set_pathname_utf8 (pEntry, AddressOf (sValue))) to iVoid
            End
        End
    End_Procedure

    // Copies the path name from text in the current ANSI code page (archive_entry_copy_pathname). Empty removes it.
    Procedure CopyPathnameLocale String sValue
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            If (sValue = "") Begin
