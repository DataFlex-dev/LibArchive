        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_gid (pEntry))
    End_Function

    { MethodType = Property }
    Procedure Set piGid BigInt iValue
        Pointer pEntry
        Void_Type iVoid
