    Function pbDataEncrypted Returns Boolean
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return False
        End
        Function_Return (archive_entry_is_data_encrypted (pEntry) <> 0)
    End_Function

    { MethodType = Property }
    Procedure Set pbDataEncrypted Boolean iValue
        Pointer pEntry
        Void_Type iVoid
        Integer iFlag
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            If iValue Begin
                Move 1 to iFlag
            End
            Else Begin
                Move 0 to iFlag
            End
            Move (archive_entry_set_is_data_encrypted (pEntry, iFlag)) to iVoid
        End
    End_Procedure

    // True when the metadata (name, times, ...) of the entry is encrypted (archive_entry_is_metadata_encrypted / archive_entry_set_is_metadata_encrypted).
    { MethodType = Property }
    Function pbMetadataEncrypted Returns Boolean
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return False
        End
        Function_Return (archive_entry_is_metadata_encrypted (pEntry) <> 0)
    End_Function

    { MethodType = Property }
    Procedure Set pbMetadataEncrypted Boolean iValue
        Pointer pEntry
        Void_Type iVoid
        Integer iFlag
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            If iValue Begin
                Move 1 to iFlag
            End
            Else Begin
                Move 0 to iFlag
            End
            Move (archive_entry_set_is_metadata_encrypted (pEntry, iFlag)) to iVoid
        End
    End_Procedure

    // True when the data or the metadata of the entry is encrypted, read only (archive_entry_is_encrypted).
    { MethodType = Property }
    Function pbEncrypted Returns Boolean
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return False
        End
        Function_Return (archive_entry_is_encrypted (pEntry) <> 0)
    End_Function

    // ---- file flags --------------------------------------------------------------------------------------------

    // Bits of the file flags that are set (archive_entry_fflags / archive_entry_set_fflags). The setter keeps the clear bits.
    { MethodType = Property }
    Function piFFlagsSet Returns UInteger
        Pointer pEntry
        UInteger iSet iClear
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Move (archive_entry_fflags (pEntry, AddressOf (iSet), AddressOf (iClear))) to iVoid
        Function_Return iSet
    End_Function

    { MethodType = Property }
    Procedure Set piFFlagsSet UInteger iSet
        Pointer pEntry
        UInteger iOldSet iClear
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            Move (archive_entry_fflags (pEntry, AddressOf (iOldSet), AddressOf (iClear))) to iVoid
            Move (archive_entry_set_fflags (pEntry, iSet, iClear)) to iVoid
        End
    End_Procedure

    // Bits of the file flags that are cleared (archive_entry_fflags / archive_entry_set_fflags). The setter keeps the set bits.
    { MethodType = Property }
    Function piFFlagsClear Returns UInteger
        Pointer pEntry
        UInteger iSet iClear
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Move (archive_entry_fflags (pEntry, AddressOf (iSet), AddressOf (iClear))) to iVoid
        Function_Return iClear
    End_Function

    { MethodType = Property }
    Procedure Set piFFlagsClear UInteger iClear
        Pointer pEntry
        UInteger iSet iOldClear
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            Move (archive_entry_fflags (pEntry, AddressOf (iSet), AddressOf (iOldClear))) to iVoid
            Move (archive_entry_set_fflags (pEntry, iSet, iClear)) to iVoid
        End
    End_Procedure

    // Sets the file flags to set and to clear in one call (archive_entry_set_fflags).
    Procedure SetFFlags UInteger iSet UInteger iClear
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            Move (archive_entry_set_fflags (pEntry, iSet, iClear)) to iVoid
        End
    End_Procedure

    // File flags as text like "nodump,uappnd" (archive_entry_fflags_text). Empty when not set. The setter parses the text
    // (CopyFFlagsText) and raises a DataFlex error naming the first invalid token; an empty string clears the flags.
    { MethodType = Property }
    Function psFFlagsText Returns String
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        Function_Return (PointerText (Self, archive_entry_fflags_text (pEntry)))
    End_Function

    // Sets the file flags from text (archive_entry_copy_fflags_text). Returns the first invalid token, or "" when the
    // whole text was valid (valid tokens are applied either way). An empty text clears the flags.
    Function CopyFFlagsText String sFlags Returns String
        Pointer pEntry pBad
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        If (sFlags = "") Begin
            Move (archive_entry_set_fflags (pEntry, 0, 0)) to iVoid
            Function_Return ""
        End
        Move (archive_entry_copy_fflags_text (pEntry, AddressOf (sFlags))) to pBad
        Function_Return (PointerText (Self, pBad))
    End_Function

    // Like CopyFFlagsText, but only the first iLength bytes of the text are used (archive_entry_copy_fflags_text_len).
    Function CopyFFlagsTextLen String sFlags Integer iLength Returns String
        Pointer pEntry pBad
        Get ppEntry to pEntry
        If (pEntry = 0 or sFlags = "") Begin
            Function_Return ""
        End
        Move (archive_entry_copy_fflags_text_len (pEntry, AddressOf (sFlags), iLength)) to pBad
        Function_Return (PointerText (Self, pBad))
    End_Function

    // Like CopyFFlagsText with wide text (archive_entry_copy_fflags_text_w).
    Function CopyFFlagsTextWide String sFlags Returns String
        Pointer pEntry pBad
        WString wsFlags
        Get ppEntry to pEntry
        If (pEntry = 0 or sFlags = "") Begin
            Function_Return ""
        End
        Move sFlags to wsFlags
        Move (archive_entry_copy_fflags_text_w (pEntry, AddressOf (wsFlags))) to pBad
        Function_Return (PointerWideText (Self, pBad))
    End_Function

    { MethodType = Property }
    Procedure Set psFFlagsText String sFlags
        String sBad
        Get CopyFFlagsText sFlags to sBad
        If (sBad <> "") Begin
            Error DFERR_PROGRAM ("Invalid file flag:" * sBad)
        End
    End_Procedure

    // ---- stat and platform data --------------------------------------------------------------------------------

    // Pointer to a C runtime struct stat filled from the entry (archive_entry_stat). The memory is owned by the entry and is
    // only valid until the entry is changed. Its layout is that of the C runtime archive.dll was built with.
    Function StatPointer Returns Pointer
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_stat (pEntry))
    End_Function

    // Copies the fields of a C runtime struct stat into the entry (archive_entry_copy_stat), for example the pointer
    // returned by StatPointer of another entry.
    Procedure CopyStat Pointer pStat
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0 and pStat <> 0) Begin
            Move (archive_entry_copy_stat (pEntry, pStat)) to iVoid
        End
    End_Procedure

    // Copies the fields of a Windows BY_HANDLE_FILE_INFORMATION structure into the entry (archive_entry_copy_bhfi).
    Procedure CopyBhfi Pointer pFileInfo
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0 and pFileInfo <> 0) Begin
            Move (archive_entry_copy_bhfi (pEntry, pFileInfo)) to iVoid
        End
    End_Procedure

    // The Mac OS AppleDouble metadata blob of the entry as bytes (archive_entry_mac_metadata). Empty array when there is none.
    Function MacMetadata Returns UChar[]
        Pointer pEntry pData
        BigInt iSize
        Integer iLength
        Boolean bOk
        UChar[] ucData
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ucData
        End
        Move (archive_entry_mac_metadata (pEntry, AddressOf (iSize))) to pData
        If (pData = 0 or iSize <= 0) Begin
            Function_Return ucData
        End
        Move iSize to iLength
        Move (ResizeArray (ucData, iLength)) to ucData
        Move (MemCopy (AddressOf (ucData), pData, iLength)) to bOk
        Function_Return ucData
    End_Function

    // Stores a Mac OS AppleDouble metadata blob in the entry (archive_entry_copy_mac_metadata). An empty array removes it.
    Procedure SetMacMetadata UChar[] ucData
        Pointer pEntry
        Integer iLength
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Procedure_Return
        End
        Move (SizeOfArray (ucData)) to iLength
        If (iLength = 0) Begin
            Move (archive_entry_copy_mac_metadata (pEntry, 0, 0)) to iVoid
        End
        Else Begin
            Move (archive_entry_copy_mac_metadata (pEntry, AddressOf (ucData), iLength)) to iVoid
        End
    End_Procedure

    // Byte length of a digest type (ARCHIVE_ENTRY_DIGEST_*): MD5 16, RMD160 20, SHA1 20, SHA256 32, SHA384 48, SHA512 64. 0 for unknown types.
    Function DigestLength Integer eType Returns Integer
        Case Begin
            Case (eType = ARCHIVE_ENTRY_DIGEST_MD5)    Function_Return 16
            Case (eType = ARCHIVE_ENTRY_DIGEST_RMD160) Function_Return 20
            Case (eType = ARCHIVE_ENTRY_DIGEST_SHA1)   Function_Return 20
            Case (eType = ARCHIVE_ENTRY_DIGEST_SHA256) Function_Return 32
            Case (eType = ARCHIVE_ENTRY_DIGEST_SHA384) Function_Return 48
            Case (eType = ARCHIVE_ENTRY_DIGEST_SHA512) Function_Return 64
        Case End
        Function_Return 0
    End_Function

    // The digest the archive format provided for the entry (archive_entry_digest) as lower case hexadecimal text, for
    // example 32 characters for ARCHIVE_ENTRY_DIGEST_MD5. Empty when the entry has no such digest (only some formats, e.g.
    // mtree and xar, provide digests): libarchive always returns the digest bytes and zero filled bytes mean "not set".
    Function Digest Integer eType Returns String
        Pointer pEntry pDigest
        Integer iLength iIndex iByte iHigh iLow
        Boolean bOk bNonZero
        UChar[] ucDigest
        String sHex sDigits

        Get ppEntry to pEntry
        Get DigestLength eType to iLength
        If (pEntry = 0 or iLength = 0) Begin
            Function_Return ""
        End
        Move (archive_entry_digest (pEntry, eType)) to pDigest
        If (pDigest = 0) Begin
            Function_Return ""
        End
        Move (ResizeArray (ucDigest, iLength)) to ucDigest
        Move (MemCopy (AddressOf (ucDigest), pDigest, iLength)) to bOk
        Move "0123456789abcdef" to sDigits
        Move "" to sHex
        Move False to bNonZero
        For iIndex from 0 to (iLength - 1)
            Move ucDigest[iIndex] to iByte
            If (iByte <> 0) Begin
                Move True to bNonZero
            End
            Move (Mod (iByte, 16)) to iLow
            Move ((iByte - iLow) / 16) to iHigh
            Move (sHex + Mid (sDigits, 1, iHigh + 1) + Mid (sDigits, 1, iLow + 1)) to sHex
        Loop
        If (not (bNonZero)) Begin
            Function_Return ""
        End
        Function_Return sHex
    End_Function

    // ---- ACL ----------------------------------------------------------------------------------------------------
    // ACL types are ARCHIVE_ENTRY_ACL_TYPE_* (ACCESS, DEFAULT for POSIX.1e; ALLOW, DENY, AUDIT, ALARM for NFSv4), tags
    // ARCHIVE_ENTRY_ACL_USER / _USER_OBJ / _GROUP / _GROUP_OBJ / _MASK / _OTHER / _EVERYONE, permissions
    // ARCHIVE_ENTRY_ACL_* bits. For POSIX.1e the owner, group and other entries of an access ACL are stored in the mode of the
    // entry (piMode) and only reported by AclReset/AclNext/AclCount/AclToText when the ACL has extended entries; they come
    // first (owner, group, other), followed by the extended entries (user, group, mask) in the order they were added.
    // libarchive keeps the names of ACL entries in the ANSI code page: AclNext converts them to DataFlex strings, AclAddEntry
    // takes the bytes of its name as they are (ASCII names only), AclAddEntryWide takes any text.

    // Pointer to the opaque ACL object of the entry (archive_entry_acl). Nothing a client can do with it; provided for completeness.
    Function AclPointer Returns Pointer
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_acl (pEntry))
    End_Function

    // Removes all ACL entries (archive_entry_acl_clear).
    Procedure AclClear
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            Move (archive_entry_acl_clear (pEntry)) to iVoid
        End
    End_Procedure

    // Adds an ACL entry (archive_entry_acl_add_entry). sName is the user or group name ("" for none). Returns ARCHIVE_OK or
    // ARCHIVE_FAILED (invalid type or tag; raises an error when pbRaiseErrors).
    Function AclAddEntry Integer eType Integer iPermset Integer eTag Integer iQualifier String sName Returns Integer
        Pointer pEntry pName
        Integer iResult
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Get CheckResult ARCHIVE_FAILED "archive_entry_acl_add_entry (no entry)" to iResult
            Function_Return iResult
        End
        If (sName = "") Begin
            Move 0 to pName
        End
        Else Begin
            Move (AddressOf (sName)) to pName
        End
        Move (archive_entry_acl_add_entry (pEntry, eType, iPermset, eTag, iQualifier, pName)) to iResult
        Get CheckResult iResult "archive_entry_acl_add_entry" to iResult
        Function_Return iResult
    End_Function

    // Like AclAddEntry with a wide user or group name (archive_entry_acl_add_entry_w).
    Function AclAddEntryWide Integer eType Integer iPermset Integer eTag Integer iQualifier String sName Returns Integer
        Pointer pEntry pName
        Integer iResult
        WString wsName
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Get CheckResult ARCHIVE_FAILED "archive_entry_acl_add_entry_w (no entry)" to iResult
            Function_Return iResult
        End
        If (sName = "") Begin
            Move 0 to pName
        End
        Else Begin
            Move sName to wsName
            Move (AddressOf (wsName)) to pName
        End
        Move (archive_entry_acl_add_entry_w (pEntry, eType, iPermset, eTag, iQualifier, pName)) to iResult
        Get CheckResult iResult "archive_entry_acl_add_entry_w" to iResult
        Function_Return iResult
    End_Function

    // Starts an enumeration of the ACL entries of the wanted types (a combination of ARCHIVE_ENTRY_ACL_TYPE_*) and returns
    // the number of entries (archive_entry_acl_reset).
    Function AclReset Integer iWantType Returns Integer
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_acl_reset (pEntry, iWantType))
    End_Function

    // Returns the next ACL entry of the enumeration started with AclReset (archive_entry_acl_next). eType of the result is 0
    // when there are no more entries.
    Function AclNext Integer iWantType Returns tArchiveEntryAcl
        Pointer pEntry pName
        Integer iResult iType iPermset iTag iQualifier
        tArchiveEntryAcl stAcl

        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return stAcl
        End
        Move (archive_entry_acl_next (pEntry, iWantType, AddressOf (iType), AddressOf (iPermset), AddressOf (iTag), AddressOf (iQualifier), AddressOf (pName))) to iResult
        If (iResult = ARCHIVE_OK) Begin
            Move iType to stAcl.eType
            Move iPermset to stAcl.iPermset
            Move iTag to stAcl.eTag
            Move iQualifier to stAcl.iQualifier
            Move (AnsiPointerText (Self, pName)) to stAcl.sName
        End
        Function_Return stAcl
    End_Function

    // All ACL entries of the wanted types as an array (AclReset followed by AclNext until the end).
    Function AclEntries Integer iWantType Returns tArchiveEntryAcl[]
        Integer iCount iIndex
        tArchiveEntryAcl stAcl
        tArchiveEntryAcl[] astAcl

        Get AclReset iWantType to iCount
        For iIndex from 1 to iCount
            Get AclNext iWantType to stAcl
            If (stAcl.eType = 0) Begin
                Function_Return astAcl
            End
            Move stAcl to astAcl[SizeOfArray (astAcl)]
        Loop
        Function_Return astAcl
    End_Function

    // Number of ACL entries of the wanted types (archive_entry_acl_count).
    Function AclCount Integer iWantType Returns Integer
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_acl_count (pEntry, iWantType))
    End_Function

    // Bit mask of the ARCHIVE_ENTRY_ACL_TYPE_* values present in the entry (archive_entry_acl_types). 0 when there is no ACL.
    Function AclTypes Returns Integer
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_acl_types (pEntry))
    End_Function

    // Text form of the ACL (archive_entry_acl_to_text). iFlags combines the wanted types (ARCHIVE_ENTRY_ACL_TYPE_ACCESS,
    // _DEFAULT, _NFS4, ...) with ARCHIVE_ENTRY_ACL_STYLE_* flags. Empty when there is nothing to output. The memory libarchive
    // allocates for the text is released here.
    Function AclToText Integer iFlags Returns String
        Pointer pEntry pText
        String sText
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        Move (archive_entry_acl_to_text (pEntry, 0, iFlags)) to pText
        If (pText = 0) Begin
            Function_Return ""
        End
        Move (PointerToString (pText)) to sText
        Move (archive_wrapper_crt_free (pText)) to iVoid
        Function_Return sText
    End_Function

    // Wide text variant of AclToText (archive_entry_acl_to_text_w).
    Function AclToTextWide Integer iFlags Returns String
        Pointer pEntry pText
        String sText
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        Move (archive_entry_acl_to_text_w (pEntry, 0, iFlags)) to pText
        If (pText = 0) Begin
            Function_Return ""
        End
        Move (PointerToWString (pText)) to sText
        Move (archive_wrapper_crt_free (pText)) to iVoid
        Function_Return sText
    End_Function

    // Text form of the ACL of the deprecated archive_entry_acl_text (text owned by the entry). Prefer AclToText.
    Function AclTextLegacy Integer iFlags Returns String
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        Function_Return (PointerText (Self, archive_entry_acl_text (pEntry, iFlags)))
    End_Function

    // Wide text variant of AclTextLegacy (archive_entry_acl_text_w).
    Function AclTextLegacyWide Integer iFlags Returns String
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        Function_Return (PointerWideText (Self, archive_entry_acl_text_w (pEntry, iFlags)))
    End_Function

    // Parses ACL text (archive_entry_acl_from_text) of the type eType (ARCHIVE_ENTRY_ACL_TYPE_ACCESS, _DEFAULT or _NFS4)
    // and adds the entries to the ACL; entries that are already there stay (call AclClear first to replace the ACL).
    // Returns ARCHIVE_OK, ARCHIVE_WARN (some entries were not understood) or ARCHIVE_FAILED (raises an error when
    // pbRaiseErrors).
    Function AclFromText String sText Integer eType Returns Integer
        Pointer pEntry
        Integer iResult
        Get ppEntry to pEntry
        If (pEntry = 0 or sText = "") Begin
            Get CheckResult ARCHIVE_FAILED "archive_entry_acl_from_text (no entry or text)" to iResult
            Function_Return iResult
        End
        Move (archive_entry_acl_from_text (pEntry, AddressOf (sText), eType)) to iResult
        Get CheckResult iResult "archive_entry_acl_from_text" to iResult
        Function_Return iResult
    End_Function

    // Wide text variant of AclFromText (archive_entry_acl_from_text_w).
    Function AclFromTextWide String sText Integer eType Returns Integer
        Pointer pEntry
        Integer iResult
        WString wsText
        Get ppEntry to pEntry
        If (pEntry = 0 or sText = "") Begin
            Get CheckResult ARCHIVE_FAILED "archive_entry_acl_from_text_w (no entry or text)" to iResult
            Function_Return iResult
        End
        Move sText to wsText
        Move (archive_entry_acl_from_text_w (pEntry, AddressOf (wsText), eType)) to iResult
        Get CheckResult iResult "archive_entry_acl_from_text_w" to iResult
        Function_Return iResult
    End_Function

    // ---- extended attributes -----------------------------------------------------------------------------------

    // Removes all extended attributes (archive_entry_xattr_clear).
    Procedure XattrClear
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            Move (archive_entry_xattr_clear (pEntry)) to iVoid
        End
    End_Procedure

    // Adds an extended attribute; name and value are copied (archive_entry_xattr_add_entry).
    Procedure XattrAdd String sName UChar[] ucValue
        Pointer pEntry
        Integer iLength
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Procedure_Return
        End
        Move (SizeOfArray (ucValue)) to iLength
        If (iLength = 0) Begin
            Move (archive_entry_xattr_add_entry (pEntry, AddressOf (sName), 0, 0)) to iVoid
        End
        Else Begin
            Move (archive_entry_xattr_add_entry (pEntry, AddressOf (sName), AddressOf (ucValue), iLength)) to iVoid
        End
    End_Procedure

    // Adds an extended attribute whose value is the bytes of a string (archive_entry_xattr_add_entry).
    Procedure XattrAddText String sName String sValue
        Pointer pEntry
        Integer iLength
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Procedure_Return
        End
        Move (SizeOfString (sValue)) to iLength
        If (iLength = 0) Begin
            Move (archive_entry_xattr_add_entry (pEntry, AddressOf (sName), 0, 0)) to iVoid
        End
        Else Begin
            Move (archive_entry_xattr_add_entry (pEntry, AddressOf (sName), AddressOf (sValue), iLength)) to iVoid
        End
    End_Procedure

    // Number of extended attributes (archive_entry_xattr_count).
    Function XattrCount Returns Integer
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_xattr_count (pEntry))
    End_Function

    // Starts an enumeration of the extended attributes and returns their number (archive_entry_xattr_reset).
    Function XattrReset Returns Integer
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_xattr_reset (pEntry))
    End_Function

    // Returns the next extended attribute of the enumeration started with XattrReset (archive_entry_xattr_next). sName of
    // the result is empty when there are no more attributes.
    Function XattrNext Returns tArchiveEntryXattr
        Pointer pEntry pName pValue
        Integer iResult iLength
        Boolean bOk
        BigInt iSize
        tArchiveEntryXattr stXattr

        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return stXattr
        End
        Move (archive_entry_xattr_next (pEntry, AddressOf (pName), AddressOf (pValue), AddressOf (iSize))) to iResult
        If (iResult = ARCHIVE_OK and pName <> 0) Begin
            Move (PointerToString (pName)) to stXattr.sName
            Move iSize to iLength
            If (iLength > 0 and pValue <> 0) Begin
                Move (ResizeArray (stXattr.ucValue, iLength)) to stXattr.ucValue
                Move (MemCopy (AddressOf (stXattr.ucValue), pValue, iLength)) to bOk
            End
        End
        Function_Return stXattr
    End_Function

    // All extended attributes as an array (XattrReset followed by XattrNext until the end).
    Function XattrEntries Returns tArchiveEntryXattr[]
        Integer iCount iIndex
        tArchiveEntryXattr stXattr
        tArchiveEntryXattr[] astXattr

        Get XattrReset to iCount
        For iIndex from 1 to iCount
            Get XattrNext to stXattr
            If (stXattr.sName = "") Begin
                Function_Return astXattr
            End
            Move stXattr to astXattr[SizeOfArray (astXattr)]
        Loop
        Function_Return astXattr
    End_Function

    // ---- sparse regions ----------------------------------------------------------------------------------------

    // Removes all sparse regions (archive_entry_sparse_clear).
    Procedure SparseClear
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            Move (archive_entry_sparse_clear (pEntry)) to iVoid
        End
    End_Procedure

    // Adds a sparse region (data block) with offset and length (archive_entry_sparse_add_entry).
    Procedure SparseAdd BigInt iOffset BigInt iLength
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            Move (archive_entry_sparse_add_entry (pEntry, iOffset, iLength)) to iVoid
        End
    End_Procedure

    // Number of sparse regions (archive_entry_sparse_count).
    Function SparseCount Returns Integer
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_sparse_count (pEntry))
    End_Function

    // Starts an enumeration of the sparse regions and returns their number (archive_entry_sparse_reset).
    Function SparseReset Returns Integer
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_entry_sparse_reset (pEntry))
    End_Function

    // Returns the next sparse region of the enumeration started with SparseReset (archive_entry_sparse_next). iLength of the
    // result is -1 when there are no more regions.
    Function SparseNext Returns tArchiveEntrySparse
        Pointer pEntry
        Integer iResult
        BigInt iOffset iLength
        tArchiveEntrySparse stSparse

        Move -1 to stSparse.iLength
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return stSparse
        End
        Move (archive_entry_sparse_next (pEntry, AddressOf (iOffset), AddressOf (iLength))) to iResult
        If (iResult = ARCHIVE_OK) Begin
            Move iOffset to stSparse.iOffset
            Move iLength to stSparse.iLength
        End
        Function_Return stSparse
    End_Function

    // All sparse regions as an array (SparseReset followed by SparseNext until the end).
    Function SparseEntries Returns tArchiveEntrySparse[]
        Integer iCount iIndex
        tArchiveEntrySparse stSparse
        tArchiveEntrySparse[] astSparse

        Get SparseReset to iCount
        For iIndex from 1 to iCount
            Get SparseNext to stSparse
            If (stSparse.iLength < 0) Begin
                Function_Return astSparse
            End
            Move stSparse to astSparse[SizeOfArray (astSparse)]
        Loop
        Function_Return astSparse
    End_Function
End_Class
