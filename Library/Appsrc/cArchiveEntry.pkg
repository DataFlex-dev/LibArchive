    // ---- times -------------------------------------------------------------------------------------------------
    // Seconds are Unix time (seconds since 1970-01-01 UTC, BigInt), the nanosecond part is 0..999999999. Setting
    // piXtime or piXtimeNsec alone keeps the other part and marks the time as set; SetXtime sets both.

    // Seconds of the access time (archive_entry_atime / archive_entry_set_atime).
    { MethodType = Property }
    Function piAtime Returns BigInt
