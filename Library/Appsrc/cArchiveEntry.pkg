            End
        End
    End_Procedure

    // ---- link target of the kind that is currently set -----------------------------------------------------------

    // Link target: the hard link target when the entry has one, otherwise the symbolic link target. Hard link and symbolic
    // link share one storage in libarchive: an entry has either one or the other. Setting uses archive_entry_update_link_utf8
    // (keeps the kind that is currently set; an entry that has neither becomes a hard link unless SetLinkToSymlink was
    // called) and raises a DataFlex error only when the text is not valid UTF-8 (nothing is stored then).
    { MethodType = Property }
    Function psLink Returns String
        Pointer pEntry
        Get ppEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return ""
        End
        If (archive_entry_hardlink_is_set (pEntry) <> 0) Begin
            Function_Return (PointerText (Self, archive_entry_hardlink_utf8 (pEntry)))
        End
        Function_Return (PointerText (Self, archive_entry_symlink_utf8 (pEntry)))
    End_Function

    { MethodType = Property }
    Procedure Set psLink String sValue
        Pointer pEntry
        Integer iResult
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            If (sValue = "") Begin
                Move (archive_entry_set_link_utf8 (pEntry, 0)) to iVoid
            End
            Else Begin
                If (not (IsValidUtf8 (Self, sValue))) Begin
                    Error DFERR_PROGRAM "Could not set the link target: the text is not valid UTF-8"
                End
                Else Begin
                    Move (archive_entry_update_link_utf8 (pEntry, AddressOf (sValue))) to iResult
                    Set pbLastTextLossless to (iResult <> 0)
                End
            End
        End
    End_Procedure

    // Sets the link target from text in the current ANSI code page (archive_entry_set_link).
    Procedure SetLinkLocale String sValue
        Pointer pEntry
        Void_Type iVoid
        Get ppEntry to pEntry
        If (pEntry <> 0) Begin
            If (sValue = "") Begin
                Move (archive_entry_set_link (pEntry, 0)) to iVoid
            End
            Else Begin
                Move (archive_entry_set_link (pEntry, AddressOf (sValue))) to iVoid
            End
        End
    End_Procedure

