    // Enables an external program as a filter that is applied to every input without detection
    // (archive_read_support_filter_program). The program must be in the PATH.
    Function SupportFilterProgram String sCommand Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_filter_program" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_filter_program (pArchive, AddressOf (sCommand))) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_filter_program"))
    End_Function

    // Enables an external program as a filter that is used when the start of the input equals ucSignature
    // (archive_read_support_filter_program_signature).
    Function SupportFilterProgramSignature String sCommand UChar[] ucSignature Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_filter_program_signature" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_filter_program_signature (pArchive, AddressOf (sCommand), AddressOf (ucSignature), SizeOfArray (ucSignature))) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_filter_program_signature"))
    End_Function

    // Called by every Open* method right before libarchive opens the archive: marks the handle as used and applies
    // pbUtf8HeaderCharset.
    { Visibility = Private }
    Procedure BeginOpen
        Pointer pArchive
        Integer iResult
        String sOptions
        Void_Type iVoid

        Get ppArchive to pArchive
        Set pbOpenCalled to True
        If (pArchive <> 0 and pbUtf8HeaderCharset (Self)) Begin
            // Fails (and is ignored) when no registered reader knows the option.
            Move "hdrcharset=UTF-8" to sOptions
            Move (archive_read_set_options (pArchive, AddressOf (sOptions))) to iResult
            If (iResult <> ARCHIVE_OK) Begin
                Move (archive_clear_error (pArchive)) to iVoid
            End
        End
    End_Procedure

    // Appends one filter by its code to the pipeline without detection (archive_read_append_filter).
    Function AppendFilter Integer eFilter Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_append_filter" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (eFilter = ARCHIVE_FILTER_COMPRESS) Begin
            // archive_read_append_filter crashes (access violation) for the compress filter in libarchive 3.7.7, so
            // the filter is enabled for detection instead.
            Move (archive_read_support_filter_compress (pArchive)) to iResult
            Function_Return (CheckResult (Self, iResult, "archive_read_support_filter_compress"))
        End
        Move (archive_read_append_filter (pArchive, eFilter)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_append_filter"))
    End_Function

    // Appends an external decompression program to the pipeline without detection (archive_read_append_filter_program).
    Function AppendFilterProgram String sCommand Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_append_filter_program" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_append_filter_program (pArchive, AddressOf (sCommand))) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_append_filter_program"))
    End_Function

    // Appends an external decompression program that is used when the start of the input equals ucSignature
    // (archive_read_append_filter_program_signature).
    Function AppendFilterProgramSignature String sCommand UChar[] ucSignature Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_append_filter_program_signature" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_append_filter_program_signature (pArchive, AddressOf (sCommand), AddressOf (ucSignature), SizeOfArray (ucSignature))) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_append_filter_program_signature"))
    End_Function

    // ---- options and passphrases (call before opening) ------------------------------------------------------------

    // Sets an option for the format readers only (archive_read_set_format_option). sModule "" matches any module.
    // Returns ARCHIVE_OK, or ARCHIVE_FAILED (an error is raised with pbRaiseErrors) when no module knows the option.
    Function SetFormatOption String sModule String sOption String sValue Returns Integer
        Pointer pArchive pModule
        Integer iResult

        Get HandleFor "archive_read_set_format_option" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move 0 to pModule
        If (sModule <> "") Begin
            Move (AddressOf (sModule)) to pModule
        End
        Move (archive_read_set_format_option (pArchive, pModule, AddressOf (sOption), AddressOf (sValue))) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_set_format_option"))
    End_Function

    // Sets an option for the filters only (archive_read_set_filter_option). sModule "" matches any module.
    Function SetFilterOption String sModule String sOption String sValue Returns Integer
        Pointer pArchive pModule
        Integer iResult

        Get HandleFor "archive_read_set_filter_option" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move 0 to pModule
        If (sModule <> "") Begin
            Move (AddressOf (sModule)) to pModule
        End
        Move (archive_read_set_filter_option (pArchive, pModule, AddressOf (sOption), AddressOf (sValue))) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_set_filter_option"))
    End_Function

    // Sets an option for the format readers and the filters (archive_read_set_option). sModule "" matches any module.
    Function SetOption String sModule String sOption String sValue Returns Integer
        Pointer pArchive pModule
        Integer iResult

        Get HandleFor "archive_read_set_option" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move 0 to pModule
        If (sModule <> "") Begin
            Move (AddressOf (sModule)) to pModule
        End
        Move (archive_read_set_option (pArchive, pModule, AddressOf (sOption), AddressOf (sValue))) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_set_option"))
    End_Function

    // Sets options from a string like "module:option=value,option2,!option3" (archive_read_set_options).
    Function SetOptions String sOptions Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_set_options" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_set_options (pArchive, AddressOf (sOptions))) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_set_options"))
    End_Function

    // Adds a passphrase that is tried when decrypting entries; can be called several times (archive_read_add_passphrase).
    Function AddPassphrase String sPassphrase Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_add_passphrase" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_add_passphrase (pArchive, AddressOf (sPassphrase))) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_add_passphrase"))
    End_Function

    // ---- open ---------------------------------------------------------------------------------------------------

    // Opens an archive file (archive_read_open_filename_w, so the name can contain any Unicode character). iBlockSize
    // <= 0 uses 10240. Reading from stdin is not supported (empty name is refused).
    Function OpenFile String sFileName Integer iBlockSize Returns Integer
        Pointer pArchive
        Integer iResult
        WString wsFileName

        Get HandleForOpen "archive_read_open_filename_w" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (sFileName = "") Begin
            Function_Return (ReportFailure (Self, ARCHIVE_FAILED, "archive_read_open_filename_w", "an empty file name (stdin) is not supported"))
        End
        If (iBlockSize <= 0) Begin
            Move 10240 to iBlockSize
        End
        Move sFileName to wsFileName
        Send BeginOpen
        Move (archive_read_open_filename_w (pArchive, AddressOf (wsFileName), iBlockSize)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_open_filename_w"))
    End_Function

    // Opens a multi volume archive, the volumes in the order they must be read (archive_read_open_filenames_w).
    // iBlockSize <= 0 uses 10240.
    Function OpenFiles String[] asFileNames Integer iBlockSize Returns Integer
        Pointer pArchive pName pTarget
        Integer iResult iCount iIndex iChars iTotal iOffset iBytes iVoid
        WString wsName
        UChar[] ucNames ucPointers

        Get HandleForOpen "archive_read_open_filenames_w" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (SizeOfArray (asFileNames)) to iCount
        If (iCount = 0) Begin
            Function_Return (ReportFailure (Self, ARCHIVE_FAILED, "archive_read_open_filenames_w", "no file names"))
        End
        If (iBlockSize <= 0) Begin
            Move 10240 to iBlockSize
        End
        // Size of the wide strings, each with its terminating zero.
        Move 0 to iTotal
        For iIndex from 0 to (iCount - 1)
            Move asFileNames[iIndex] to wsName
            Move (ArchiveReaderWideLength (AddressOf (wsName))) to iChars
            Move (iTotal + (iChars + 1) * 2) to iTotal
        Loop
        Move (ResizeArray (ucNames, iTotal)) to ucNames
        // The pointer table: one 8 byte pointer per name and a terminating 0 pointer.
        Move (ResizeArray (ucPointers, (iCount + 1) * 8)) to ucPointers
        Move 0 to iOffset
        For iIndex from 0 to (iCount - 1)
            Move asFileNames[iIndex] to wsName
            Move (ArchiveReaderWideLength (AddressOf (wsName))) to iChars
            Move ((iChars + 1) * 2) to iBytes
            Move (AddressOf (ucNames) + iOffset) to pName
            Move (CopyMemory (pName, AddressOf (wsName), iBytes)) to iVoid
            Move (AddressOf (ucPointers) + (iIndex * 8)) to pTarget
            Move (CopyMemory (pTarget, AddressOf (pName), 8)) to iVoid
            Move (iOffset + iBytes) to iOffset
        Loop
        Move 0 to pName
        Move (AddressOf (ucPointers) + (iCount * 8)) to pTarget
        Move (CopyMemory (pTarget, AddressOf (pName), 8)) to iVoid
        Send BeginOpen
        Move (archive_read_open_filenames_w (pArchive, AddressOf (ucPointers), iBlockSize)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_open_filenames_w"))
    End_Function

    // Opens an archive that is in memory (archive_read_open_memory). The bytes are copied to a buffer that the object
    // keeps (ppMemory, piMemorySize) until the handle is freed, so ucBuffer can be changed or freed afterwards.
    Function OpenMemory UChar[] ByRef ucBuffer Returns Integer
        Pointer pArchive pMemory
        Integer iResult iSize iVoid

        Get HandleForOpen "archive_read_open_memory" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Send ReleaseMemory
        Move (SizeOfArray (ucBuffer)) to iSize
        Move (Alloc (iSize + 1)) to pMemory
        If (iSize > 0) Begin
            Move (CopyMemory (pMemory, AddressOf (ucBuffer), iSize)) to iVoid
        End
        Set ppMemory to pMemory
        Set piMemorySize to iSize
        Send BeginOpen
        Move (archive_read_open_memory (pArchive, pMemory, iSize)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_open_memory"))
    End_Function

    // Like OpenMemory but libarchive receives the data in chunks of iReadSize bytes (archive_read_open_memory2; meant for
    // testing the readers with small reads).
    Function OpenMemoryChunked UChar[] ByRef ucBuffer Integer iReadSize Returns Integer
        Pointer pArchive pMemory
        Integer iResult iSize iVoid

        Get HandleForOpen "archive_read_open_memory2" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (iReadSize <= 0) Begin
            Function_Return (ReportFailure (Self, ARCHIVE_FAILED, "archive_read_open_memory2", "the read size must be greater than 0"))
        End
        Send ReleaseMemory
        Move (SizeOfArray (ucBuffer)) to iSize
        Move (Alloc (iSize + 1)) to pMemory
        If (iSize > 0) Begin
            Move (CopyMemory (pMemory, AddressOf (ucBuffer), iSize)) to iVoid
        End
        Set ppMemory to pMemory
        Set piMemorySize to iSize
        Send BeginOpen
        Move (archive_read_open_memory2 (pArchive, pMemory, iSize, iReadSize)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_open_memory2"))
    End_Function

    // Opens an archive from a C runtime file descriptor (archive_read_open_fd). The caller keeps ownership of the
    // descriptor and closes it after the archive was closed. iBlockSize <= 0 uses 10240.
    Function OpenFd Integer iFileDescriptor Integer iBlockSize Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleForOpen "archive_read_open_fd" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (iBlockSize <= 0) Begin
            Move 10240 to iBlockSize
        End
        Send BeginOpen
        Move (archive_read_open_fd (pArchive, iFileDescriptor, iBlockSize)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_open_fd"))
    End_Function

    // Opens an archive from a C runtime FILE pointer (archive_read_open_FILE). The caller keeps ownership of the FILE
    // and closes it after the archive was closed.
    Function OpenFilePtr Pointer pFile Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleForOpen "archive_read_open_FILE" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Send BeginOpen
        Move (archive_read_open_FILE_Ptr (pArchive, pFile)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_open_FILE"))
    End_Function

    // Opens the archive with the callbacks that were set earlier (archive_read_open1). Callbacks cannot be set from
    // DataFlex, so this fails with ARCHIVE_FATAL ("no reader function"); it is only exposed for completeness.
    Function Open1 Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleForOpen "archive_read_open1" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Send BeginOpen
        Move (archive_read_open1 (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_open1"))
    End_Function

    // ---- header and data ----------------------------------------------------------------------------------------

    // Reads the next entry header into an entry object you own (archive_read_next_header2). hoEntry is a cArchiveEntry;
    // an entry is created for it when it has none. Unlike NextHeader the entry stays valid after the next header was
    // read. Returns ARCHIVE_OK, ARCHIVE_WARN, ARCHIVE_EOF or a failure.
    Function NextHeaderInto Handle hoEntry Returns Integer
        Pointer pArchive pEntry
        Integer iResult

        Get HandleFor "archive_read_next_header2" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (not (HasEntry (hoEntry))) Begin
            Send CreateEntry of hoEntry
        End
        Get ppEntry of hoEntry to pEntry
        Move (archive_read_next_header2 (pArchive, pEntry)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_next_header2"))
    End_Function

    // Byte offset in the uncompressed data where the last read header started (archive_read_header_position).
    Function HeaderPosition Returns BigInt
        Pointer pArchive

        Get HandleFor "archive_read_header_position" to pArchive
        If (pArchive = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_read_header_position (pArchive))
    End_Function

    // Skips the remaining data of the current entry (archive_read_data_skip).
    Function SkipData Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_data_skip" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_data_skip (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_data_skip"))
    End_Function

    // Seeks within the data of the current entry (archive_seek_data); eWhence is ARCHIVE_SEEK_SET, ARCHIVE_SEEK_CUR or
    // ARCHIVE_SEEK_END. Returns the new offset, or a negative ARCHIVE_* code when the format cannot seek. libarchive 3.7.7
    // does not seek in the zip, tar, 7zip, cpio, iso9660 and rar5 readers (ARCHIVE_FATAL, the archive is unusable afterwards).
    Function SeekData BigInt iOffset Integer eWhence Returns BigInt
        Pointer pArchive
        BigInt iNewOffset
        Integer iResult

        Get HandleFor "archive_seek_data" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_seek_data (pArchive, iOffset, eWhence)) to iNewOffset
        If (iNewOffset < 0) Begin
            Get CheckResult iNewOffset "archive_seek_data" to iResult
        End
        Function_Return iNewOffset
    End_Function

    // ---- archive information ------------------------------------------------------------------------------------

    // Raw result of archive_read_has_encrypted_entries: 1 when an encrypted entry was found, 0 when none was found
    // yet, ARCHIVE_READ_FORMAT_ENCRYPTION_DONT_KNOW or ARCHIVE_READ_FORMAT_ENCRYPTION_UNSUPPORTED when unknown.
    Function EncryptedEntriesState Returns Integer
        Pointer pArchive

        Get ppArchive to pArchive
        If (pArchive = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_read_has_encrypted_entries (pArchive))
    End_Function

    // True when at least one encrypted entry was found among the headers read so far (archive_read_has_encrypted_entries).
    { MethodType = Property }
    Function pbHasEncryptedEntries Returns Boolean
        Integer iState
        Get EncryptedEntriesState to iState
        Function_Return (iState = 1)
    End_Function

    // Bit mask of ARCHIVE_READ_FORMAT_CAPS_* values: what the format reader can tell about encryption
    // (archive_read_format_capabilities). Valid after the first header was read.
    { MethodType = Property }
    Function peFormatCapabilities Returns Integer
        Pointer pArchive

        Get ppArchive to pArchive
        If (pArchive = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_read_format_capabilities (pArchive))
    End_Function

    // ---- extract ------------------------------------------------------------------------------------------------

    // Extracts the current entry (header and data) to disk relative to the current directory, or to the absolute path
    // of the entry (archive_read_extract). A refused entry (for example "Path contains '..'" with
    // ARCHIVE_EXTRACT_SECURE_NODOTDOT) returns ARCHIVE_WARN and is not written. iFlags is a combination of ARCHIVE_EXTRACT_* values. To extract elsewhere
    // change psPathname of phoEntry first.
    Function ExtractCurrent Integer iFlags Returns Integer
        Pointer pArchive pEntry
        Integer iResult

        Get HandleFor "archive_read_extract" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Get ppEntry of (phoEntry (Self)) to pEntry
        If (pEntry = 0) Begin
            Function_Return (ReportFailure (Self, ARCHIVE_FAILED, "archive_read_extract", "there is no current entry"))
        End
        Move (archive_read_extract (pArchive, pEntry, iFlags)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_extract"))
    End_Function

    // Extracts the current entry through an archive_write_disk handle (archive_read_extract2). hoDiskWriter is a
    // wrapper object with the write disk handle in ppArchive (cArchiveDiskWriter).
    Function ExtractCurrentTo Handle hoDiskWriter Returns Integer
        Pointer pArchive pEntry pDisk
        Integer iResult

        Get HandleFor "archive_read_extract2" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Get ppEntry of (phoEntry (Self)) to pEntry
        If (pEntry = 0) Begin
            Function_Return (ReportFailure (Self, ARCHIVE_FAILED, "archive_read_extract2", "there is no current entry"))
        End
        Get ppArchive of hoDiskWriter to pDisk
        If (pDisk = 0) Begin
            Function_Return (ReportFailure (Self, ARCHIVE_FAILED, "archive_read_extract2", "the disk writer has no handle"))
        End
        Move (archive_read_extract2 (pArchive, pEntry, pDisk)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_extract2"))
    End_Function

    // Records the device and inode of a file that extraction must not overwrite, normally the archive being read
    // (archive_read_extract_set_skip_file). Applies to ExtractCurrent, which then returns ARCHIVE_WARN ("Refusing to
    // overwrite archive") for an entry that would replace that file.
    Procedure SetExtractSkipFile BigInt iDevice BigInt iInode
        Pointer pArchive
        Void_Type iVoid

        Get HandleFor "archive_read_extract_set_skip_file" to pArchive
        If (pArchive <> 0) Begin
            Move (archive_read_extract_set_skip_file (pArchive, iDevice, iInode)) to iVoid
        End
    End_Procedure

    // ---- convenience: one call per task ---------------------------------------------------------------------------

    // Creates a new handle with all formats and filters, adds psPassphrase (when set) and opens the archive file.
    // Returns the result of OpenFile; on failure the handle is kept so the error text can be read.
    Function OpenArchive String sFileName Returns Integer
        Integer iResult
        String sPassphrase

        Send CreateReaderAll
        If (not (HasHandle (Self))) Begin
            Function_Return ARCHIVE_FATAL
        End
        Get psPassphrase to sPassphrase
        If (sPassphrase <> "") Begin
            Get AddPassphrase sPassphrase to iResult
        End
        Get OpenFile sFileName 0 to iResult
        Function_Return iResult
    End_Function

    // Lists the entries of an archive file: opens it (OpenArchive), reads all headers, closes and frees the handle.
    // The array is empty when the archive cannot be opened. Uses (and frees) the handle of this object.
    Function ListEntries String sFileName Returns tArchiveEntryInfo[]
        tArchiveEntryInfo[] aEntries
        tArchiveEntryInfo tInfo
        Integer iResult iCount

        Get OpenArchive sFileName to iResult
        If (iResult <> ARCHIVE_OK) Begin
            Send FreeHandle
            Function_Return aEntries
        End
        Move 0 to iCount
        Get NextHeader to iResult
        While (iResult = ARCHIVE_OK or iResult = ARCHIVE_WARN)
            Get EntryInfo to tInfo
            Move tInfo to aEntries[iCount]
            Increment iCount
            Get NextHeader to iResult
        Loop
        Send FreeHandle
        Function_Return aEntries
    End_Function

    // Extracts all entries of an archive file below sTargetFolder (created when missing) through an archive_write_disk
    // handle with iFlags (ARCHIVE_EXTRACT_* values; ARCHIVE_EXTRACT_TIME ior ARCHIVE_EXTRACT_PERM ior
    // ARCHIVE_EXTRACT_SECURE_NODOTDOT ior ARCHIVE_EXTRACT_SECURE_SYMLINKS is a sensible choice for untrusted archives).
    // Returns ARCHIVE_OK, or the first result that was not ARCHIVE_OK (the remaining entries are still extracted unless
    // the failure was ARCHIVE_FATAL). libarchive reports entries it refuses (path with "..", absolute path, ...)
    // as ARCHIVE_WARN and does not write them. piExtractedCount holds the number of entries that were extracted with
    // ARCHIVE_OK. Uses (and frees) the handle of this object.
    Function ExtractAll String sArchiveFile String sTargetFolder Integer iFlags Returns Integer
        Pointer pArchive pDisk pEntry pText
        Integer iResult iExtract iFirst iVoid
        Handle hoEntry
        String sFolder sName sLink sNew
        Boolean bOk

        Set piExtractedCount to 0
        Move sTargetFolder to sFolder
        While (sFolder <> "" and (Right (sFolder, 1) = "\" or Right (sFolder, 1) = "/"))
            Move (Left (sFolder, Length (sFolder) - 1)) to sFolder
        Loop
        If (sFolder <> "" and not (IsDirectory (sFolder + "\"))) Begin
            Move (CreateDirectoryRecursive (sFolder + "\")) to bOk
            If (not (bOk)) Begin
                Function_Return (ReportFailure (Self, ARCHIVE_FAILED, "ExtractAll", "cannot create the folder" * sFolder))
            End
        End
        Get OpenArchive sArchiveFile to iResult
        If (iResult <> ARCHIVE_OK) Begin
            Send FreeHandle
            Function_Return iResult
        End
        Get ppArchive to pArchive
        Get phoEntry to hoEntry
        Move (archive_write_disk_new ()) to pDisk
        Move (archive_write_disk_set_options (pDisk, iFlags)) to iResult
        Move (archive_write_disk_set_standard_lookup (pDisk)) to iResult
        Move ARCHIVE_OK to iFirst
        Get NextHeader to iResult
        While (iResult = ARCHIVE_OK or iResult = ARCHIVE_WARN)
            Get ppEntry of hoEntry to pEntry
            If (sFolder <> "") Begin
                // Move the entry below the target folder (also the target of a hard link).
                Get psPathname of hoEntry to sName
                Move (sFolder + "/" + sName) to sNew
                Move (archive_entry_update_pathname_utf8 (pEntry, AddressOf (sNew))) to iExtract
                Move (archive_entry_hardlink_utf8 (pEntry)) to pText
                If (pText <> 0) Begin
                    Move (PointerToString (pText)) to sLink
                    Move (sFolder + "/" + sLink) to sNew
                    Move (archive_entry_update_hardlink_utf8 (pEntry, AddressOf (sNew))) to iExtract
                End
            End
            Move (archive_read_extract2 (pArchive, pEntry, pDisk)) to iExtract
            Get CheckResult iExtract "archive_read_extract2" to iExtract
            If (iExtract = ARCHIVE_OK) Begin
                Set piExtractedCount to (piExtractedCount (Self) + 1)
            End
            If (iExtract < ARCHIVE_OK and iFirst = ARCHIVE_OK) Begin
                Move iExtract to iFirst
            End
            If (iExtract = ARCHIVE_FATAL) Begin
                Move ARCHIVE_EOF to iResult
            End
            Else Begin
                Get NextHeader to iResult
            End
        Loop
        If (iResult < ARCHIVE_OK and iFirst = ARCHIVE_OK) Begin
            Move iResult to iFirst
        End
        Move (archive_write_close (pDisk)) to iResult
        If (iResult < ARCHIVE_OK and iFirst = ARCHIVE_OK) Begin
            Move iResult to iFirst
        End
        Move (archive_write_free (pDisk)) to iResult
        Send FreeHandle
        Function_Return iFirst
    End_Function

    // Reads the data of one entry of an archive file into ucData: opens the archive (OpenArchive), searches the first
    // entry whose path name equals sPathname (exact comparison, "/" separators), reads its data and frees the handle.
    // Returns False when the archive cannot be opened, the entry does not exist or its data cannot be read (ucData is
    // empty then). Uses (and frees) the handle of this object.
    Function ReadEntryData String sArchiveFile String sPathname UChar[] ByRef ucData Returns Boolean
        Integer iResult
        String sName
        Boolean bFound bOk
        UChar[] ucEmpty

        Move ucEmpty to ucData
        Get OpenArchive sArchiveFile to iResult
        If (iResult <> ARCHIVE_OK) Begin
            Send FreeHandle
            Function_Return False
        End
        Move False to bFound
        Move False to bOk
        Get NextHeader to iResult
        While (iResult = ARCHIVE_OK or iResult = ARCHIVE_WARN)
            Get psPathname of (phoEntry (Self)) to sName
            If (sName = sPathname) Begin
                Move True to bFound
                Get ReadAllData (&ucData) to iResult
                Move (iResult = ARCHIVE_OK) to bOk
                Move ARCHIVE_EOF to iResult
            End
            Else Begin
                Get NextHeader to iResult
            End
        Loop
        Send FreeHandle
        Function_Return (bFound and bOk)
    End_Function

    // Reads ZIP metadata and extracts ZIP entries through bounded, application-owned
    // writes. It intentionally does not call archive_read_extract because that API
    // cannot stop before an application byte limit is exceeded.
    { Visibility = Private }
    Procedure SetFailure Integer iErrorCode String sMessage tArchiveOperationResult ByRef Result
        Move False to Result.bSuccess
        Move iErrorCode to Result.iErrorCode
        Move sMessage to Result.sErrorMessage
    End_Procedure

    { Visibility = Private }
    Function NativeError Pointer pArchive String sPrefix Returns String
        Pointer pError
        String sNativeError

        If (pArchive <> 0) Begin
            Move (archive_error_string(pArchive)) to pError
            If (pError <> 0) ;
                Move (PointerToString(pError)) to sNativeError
        End

        If (sNativeError <> "") ;
            Function_Return (sPrefix + ": " + sNativeError)

        Function_Return sPrefix
    End_Function

    // Unlimited values are intentionally unsupported. Positive limits make all
    // additions overflow-safe and keep metadata arrays bounded as well as data.
    { Visibility = Private }
    Function ValidateConfiguration String ByRef sReason Returns Boolean
        If (piMaxEntryUncompressedBytes(Self) <= 0) Begin
            Move "Maximum entry size must be positive." to sReason
            Function_Return False
        End
        If (piMaxTotalUncompressedBytes(Self) <= 0) Begin
            Move "Maximum total size must be positive." to sReason
            Function_Return False
        End
        If (piMaxArchiveBytes(Self) <= 0) Begin
            Move "Maximum archive size must be positive." to sReason
            Function_Return False
        End
        If (piMaxCentralDirectoryBytes(Self) <= 0 or ;
            piMaxCentralDirectoryBytes(Self) > 67108864) Begin
            Move "Maximum central-directory size must be between 1 byte and 64 MiB." to sReason
            Function_Return False
        End
        If (piMaxEntries(Self) <= 0 or piMaxEntries(Self) >= C_ARCHIVE_ZIP_UINT16_MAX) Begin
            Move "Maximum entry count must be between 1 and 65,534." to sReason
            Function_Return False
        End
        If (piMaxPathLength(Self) <= 0 or piMaxPathLength(Self) >= 260) Begin
            Move "Maximum relative path length must be between 1 and 259." to sReason
            Function_Return False
        End
        If (piMaxPathComponents(Self) <= 0) Begin
            Move "Maximum aggregate path-component count must be positive." to sReason
            Function_Return False
        End
        If (piReadBlockSize(Self) < 4096 or piReadBlockSize(Self) > 1048576) Begin
            Move "Read block size must be between 4 KiB and 1 MiB." to sReason
            Function_Return False
        End

        Function_Return True
    End_Function

    { Visibility = Private }
    Function LittleEndianUInt16 UChar[] ByRef aucBytes Integer iOffset Returns Integer
        // DataFlex expressions are evaluated left-to-right, so each product
        // needs explicit parentheses before it is added.
        Function_Return (Integer(aucBytes[iOffset]) + (Integer(aucBytes[iOffset + 1]) * 256))
    End_Function

    { Visibility = Private }
    Function LittleEndianUInt32 UChar[] ByRef aucBytes Integer iOffset Returns BigInt
        BigInt biValue biByte

        Move aucBytes[iOffset] to biValue
        Move aucBytes[iOffset + 1] to biByte
        Move (biValue + (biByte * 256)) to biValue
        Move aucBytes[iOffset + 2] to biByte
        Move (biValue + (biByte * 65536)) to biValue
        Move aucBytes[iOffset + 3] to biByte
        Move (biValue + (biByte * 16777216)) to biValue
        Function_Return biValue
    End_Function

    { Visibility = Private }
    Procedure SetZipMetadataFailure Integer iErrorCode String sMessage tZipDirectoryMetadata ByRef Metadata
        Move False to Metadata.bSuccess
        Move iErrorCode to Metadata.iErrorCode
        Move sMessage to Metadata.sErrorMessage
    End_Procedure

    // Restrict local headers too: libarchive treats their compression method as
    // authoritative even when the central directory reports another method.
    { Visibility = Private }
    Function ValidateZipLocalHeader Integer iChannel BigInt biLocalOffset BigInt biCentralOffset ;
        BigInt biCentralCompressedSize Integer iCentralCompression Integer ByRef iErrorCode ;
        String ByRef sReason Returns Boolean
        Integer iLocalFlags iLocalCompression iNameLength iExtraLength
        BigInt biLocalCompressedSize biLocalUncompressedSize biDataOffset
        UChar[] aucHeader

        If (biLocalOffset < 0 or biLocalOffset + 30 > biCentralOffset) Begin
            Move C_ARCHIVE_RESULT_MALFORMED to iErrorCode
            Move "ZIP local-header offset is outside the bounded file-data region." to sReason
            Function_Return False
        End

        Move False to Err
        Set_Channel_Position iChannel to biLocalOffset
        Read_Block channel iChannel aucHeader 30
        If (Err or SizeOfArray(aucHeader) <> 30) Begin
            Move C_ARCHIVE_RESULT_IO_ERROR to iErrorCode
            Move "Unable to read a ZIP local header." to sReason
            Function_Return False
        End

        If (aucHeader[0] <> $50 or aucHeader[1] <> $4B or ;
            aucHeader[2] <> $03 or aucHeader[3] <> $04) Begin
            Move C_ARCHIVE_RESULT_MALFORMED to iErrorCode
            Move "Central-directory entry does not reference a ZIP local header." to sReason
            Function_Return False
        End

        Get LittleEndianUInt16 (&aucHeader) 6 to iLocalFlags
        Get LittleEndianUInt16 (&aucHeader) 8 to iLocalCompression
        Get LittleEndianUInt32 (&aucHeader) 18 to biLocalCompressedSize
        Get LittleEndianUInt32 (&aucHeader) 22 to biLocalUncompressedSize
        Get LittleEndianUInt16 (&aucHeader) 26 to iNameLength
        Get LittleEndianUInt16 (&aucHeader) 28 to iExtraLength

        If ((iLocalFlags iand C_ARCHIVE_ZIP_ENCRYPTION_FLAGS) <> 0) Begin
            Move C_ARCHIVE_RESULT_ENCRYPTED to iErrorCode
            Move "Encrypted ZIP local headers are not allowed." to sReason
            Function_Return False
        End
        If (iLocalCompression <> C_ARCHIVE_ZIP_METHOD_STORE and ;
            iLocalCompression <> C_ARCHIVE_ZIP_METHOD_DEFLATE) Begin
            Move C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT to iErrorCode
            Move "Only stored and deflated ZIP entries are supported." to sReason
            Function_Return False
        End
        If (iLocalCompression <> iCentralCompression) Begin
            Move C_ARCHIVE_RESULT_MALFORMED to iErrorCode
            Move "Local and central ZIP compression methods differ." to sReason
            Function_Return False
        End
        If (biLocalCompressedSize = 4294967295 or biLocalUncompressedSize = 4294967295) Begin
            Move C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT to iErrorCode
            Move "ZIP local header requires ZIP64 metadata." to sReason
            Function_Return False
        End
        Move (biLocalOffset + 30 + iNameLength + iExtraLength) to biDataOffset
        If (biDataOffset > biCentralOffset) Begin
            Move C_ARCHIVE_RESULT_MALFORMED to iErrorCode
            Move "ZIP local header fields overlap the central directory." to sReason
            Function_Return False
        End
        // A forged compressed size must not make libarchive scan through the
        // directory or beyond the validated archive region.
        If (biCentralCompressedSize > (biCentralOffset - biDataOffset)) Begin
            Move C_ARCHIVE_RESULT_MALFORMED to iErrorCode
            Move "ZIP compressed data extends into the central directory." to sReason
            Function_Return False
        End

        Function_Return True
    End_Function

    // The seekable ZIP reader slurps the central directory on its first header.
    // Validate the EOCD and every fixed-size directory record first so native
    // allocation is bounded by both byte and entry limits.
    { Visibility = Private }
    Function ReadZipDirectoryMetadata String sArchivePath Returns tZipDirectoryMetadata
        Boolean bOk bEocdComplete
        Integer iChannel iTailSize iEocd iOffset iCommentLength iEocdEnd iPaddingOffset
        Integer iDiskNumber iCentralDisk iEntriesOnDisk iEntriesTotal
        Integer iPosition iNameLength iExtraLength iEntryCommentLength iEntryDiskNumber iRecordLength iActualEntries
        Integer iCentralFlags iCentralCompression iLocalErrorCode
        BigInt biFileSize biTailStart biEocdAbsolute biCentralSize biCentralOffset
        BigInt biEntryCompressedSize biEntryUncompressedSize biEntryLocalOffset biDeclaredTotal biCompressedTotal
        UChar[] aucTail aucCentralDirectory
        tZipDirectoryMetadata Metadata

        Move (Seq_New_Channel()) to iChannel
        If (iChannel = DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
            Send SetZipMetadataFailure C_ARCHIVE_RESULT_IO_ERROR ;
                "No sequential input channel is available." (&Metadata)
            Function_Return Metadata
        End

        Move False to Err
        Direct_Input channel iChannel ("BINARY:" + sArchivePath)
        If (Err or SeqEof) Begin
            Close_Input channel iChannel
            Send Seq_Release_Channel iChannel
            Send SetZipMetadataFailure C_ARCHIVE_RESULT_OPEN_FAILED ;
                "Unable to open archive for ZIP metadata validation." (&Metadata)
            Function_Return Metadata
        End

        Get_Channel_Size iChannel to biFileSize
        Move biFileSize to Metadata.biArchiveBytes
        Move True to bOk

        If (biFileSize > piMaxArchiveBytes(Self)) Begin
            Send SetZipMetadataFailure C_ARCHIVE_RESULT_ARCHIVE_TOO_LARGE ;
                "Archive exceeds the configured compressed-size limit." (&Metadata)
            Move False to bOk
        End
        Else If (biFileSize < C_ARCHIVE_ZIP_EOCD_MIN_SIZE) Begin
            Send SetZipMetadataFailure C_ARCHIVE_RESULT_MALFORMED ;
                "Archive is too small to contain a ZIP end record." (&Metadata)
            Move False to bOk
        End

        If (bOk) Begin
            If (biFileSize > C_ARCHIVE_ZIP_EOCD_MAX_SEARCH) ;
                Move C_ARCHIVE_ZIP_EOCD_MAX_SEARCH to iTailSize
            Else ;
                Move (Integer(biFileSize)) to iTailSize

            Move (biFileSize - iTailSize) to biTailStart
            Move False to Err
            Set_Channel_Position iChannel to biTailStart
            Read_Block channel iChannel aucTail iTailSize
            If (Err or SizeOfArray(aucTail) <> iTailSize) Begin
                Send SetZipMetadataFailure C_ARCHIVE_RESULT_IO_ERROR ;
                    "Unable to read the ZIP end record." (&Metadata)
                Move False to bOk
            End
        End

        If (bOk) Begin
            Move -1 to iEocd
            Move (SizeOfArray(aucTail) - C_ARCHIVE_ZIP_EOCD_MIN_SIZE) to iOffset
            While (iOffset >= 0 and iEocd < 0)
                If (aucTail[iOffset] = $50 and aucTail[iOffset + 1] = $4B and ;
                    aucTail[iOffset + 2] = $05 and aucTail[iOffset + 3] = $06) Begin
                    Get LittleEndianUInt16 (&aucTail) (iOffset + 20) to iCommentLength
                    Move (iOffset + C_ARCHIVE_ZIP_EOCD_MIN_SIZE + iCommentLength) to iEocdEnd
                    Move (iEocdEnd = SizeOfArray(aucTail)) to bEocdComplete

                    // The opt-in relaxes only zero padding. Arbitrary trailing
                    // data still rejects so executable/polyglot suffixes cannot
                    // hide behind the compatibility flag.
                    If (not(bEocdComplete) and pbAllowTrailingZeroPadding(Self) and ;
                        iEocdEnd < SizeOfArray(aucTail)) Begin
                        Move True to bEocdComplete
                        Move iEocdEnd to iPaddingOffset
                        While (bEocdComplete and iPaddingOffset < SizeOfArray(aucTail))
                            If (aucTail[iPaddingOffset] <> 0) ;
                                Move False to bEocdComplete
                            Increment iPaddingOffset
                        Loop
                    End

                    If (bEocdComplete) ;
                        Move iOffset to iEocd
                End
                Decrement iOffset
            Loop

            If (iEocd < 0) Begin
                Send SetZipMetadataFailure C_ARCHIVE_RESULT_MALFORMED ;
                    "ZIP end record was not found at the end of the archive." (&Metadata)
                Move False to bOk
            End
        End

        If (bOk) Begin
            // libarchive 3.7.7 selects the rightmost EOCD signature in its
            // search window without first proving that the comment reaches EOF.
            // A later signature inside the real comment must therefore reject.
            Move (iEocd + 1) to iOffset
            While (bOk and iOffset <= SizeOfArray(aucTail) - 4)
                If (aucTail[iOffset] = $50 and aucTail[iOffset + 1] = $4B and ;
                    aucTail[iOffset + 2] = $05 and aucTail[iOffset + 3] = $06) Begin
                    Send SetZipMetadataFailure C_ARCHIVE_RESULT_MALFORMED ;
                        "ZIP comment contains an ambiguous end-record signature." (&Metadata)
                    Move False to bOk
                End
                Increment iOffset
            Loop
        End

        If (bOk) Begin
            // libarchive honors a ZIP64 locator even when the ordinary EOCD
            // fields are not sentinels. Reject the locator itself so it cannot
            // redirect the native reader around the bounded directory above.
            If (iEocd >= 20 and aucTail[iEocd - 20] = $50 and ;
                aucTail[iEocd - 19] = $4B and aucTail[iEocd - 18] = $06 and ;
                aucTail[iEocd - 17] = $07) Begin
                Send SetZipMetadataFailure C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT ;
                    "ZIP64 locator records are not supported by the bounded metadata reader." (&Metadata)
                Move False to bOk
            End
        End

        If (bOk) Begin
            Get LittleEndianUInt16 (&aucTail) (iEocd + 4) to iDiskNumber
            Get LittleEndianUInt16 (&aucTail) (iEocd + 6) to iCentralDisk
            Get LittleEndianUInt16 (&aucTail) (iEocd + 8) to iEntriesOnDisk
            Get LittleEndianUInt16 (&aucTail) (iEocd + 10) to iEntriesTotal
            Get LittleEndianUInt32 (&aucTail) (iEocd + 12) to biCentralSize
            Get LittleEndianUInt32 (&aucTail) (iEocd + 16) to biCentralOffset
            Move biCentralSize to Metadata.biCentralDirectoryBytes

            If (iDiskNumber <> 0 or iCentralDisk <> 0 or iEntriesOnDisk <> iEntriesTotal) Begin
                Send SetZipMetadataFailure C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT ;
                    "Multi-volume ZIP archives are not supported." (&Metadata)
                Move False to bOk
            End
            Else If (iEntriesTotal = C_ARCHIVE_ZIP_UINT16_MAX or ;
                biCentralSize = 4294967295 or biCentralOffset = 4294967295) Begin
                Send SetZipMetadataFailure C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT ;
                    "ZIP64 archives are not supported by the bounded metadata reader." (&Metadata)
                Move False to bOk
            End
            Else If (iEntriesTotal = 0 or biCentralSize = 0) Begin
                Send SetZipMetadataFailure C_ARCHIVE_RESULT_MALFORMED ;
                    "Archive contains no central-directory entries." (&Metadata)
                Move False to bOk
            End
            Else If (iEntriesTotal > piMaxEntries(Self)) Begin
                Send SetZipMetadataFailure C_ARCHIVE_RESULT_TOO_MANY_ENTRIES ;
                    ("ZIP end record has " + String(iEntriesTotal) + " entries; configured maximum is " + ;
                     String(piMaxEntries(Self)) + ".") (&Metadata)
                Move False to bOk
            End
            Else If (biCentralSize > piMaxCentralDirectoryBytes(Self)) Begin
                Send SetZipMetadataFailure C_ARCHIVE_RESULT_CENTRAL_DIRECTORY_TOO_LARGE ;
                    "ZIP central directory exceeds the configured byte limit." (&Metadata)
                Move False to bOk
            End
            Else Begin
                Move (biTailStart + iEocd) to biEocdAbsolute
                // libarchive's seekable reader also derives a start position
                // from EOCD minus central size. Requiring exact adjacency makes
                // that position identical to the offset validated here.
                If (biCentralOffset + biCentralSize <> biEocdAbsolute) Begin
                    Send SetZipMetadataFailure C_ARCHIVE_RESULT_MALFORMED ;
                        "ZIP central directory is not directly adjacent to its end record." (&Metadata)
                    Move False to bOk
                End
            End
        End

        If (bOk) Begin
            Move False to Err
            Set_Channel_Position iChannel to biCentralOffset
            Read_Block channel iChannel aucCentralDirectory (Integer(biCentralSize))
            If (Err or SizeOfArray(aucCentralDirectory) <> Integer(biCentralSize)) Begin
                Send SetZipMetadataFailure C_ARCHIVE_RESULT_IO_ERROR ;
                    "Unable to read the ZIP central directory." (&Metadata)
                Move False to bOk
            End
        End

        If (bOk) Begin
            Move 0 to iPosition
            While (bOk and iPosition < SizeOfArray(aucCentralDirectory))
                If (SizeOfArray(aucCentralDirectory) - iPosition < C_ARCHIVE_ZIP_CENTRAL_HEADER_SIZE or ;
                    aucCentralDirectory[iPosition] <> $50 or aucCentralDirectory[iPosition + 1] <> $4B or ;
                    aucCentralDirectory[iPosition + 2] <> $01 or aucCentralDirectory[iPosition + 3] <> $02) Begin
                    Send SetZipMetadataFailure C_ARCHIVE_RESULT_MALFORMED ;
                        "ZIP central directory contains an invalid record." (&Metadata)
                    Move False to bOk
                End
                Else Begin
                    Get LittleEndianUInt32 (&aucCentralDirectory) (iPosition + 20) to biEntryCompressedSize
                    Get LittleEndianUInt32 (&aucCentralDirectory) (iPosition + 24) to biEntryUncompressedSize
                    Get LittleEndianUInt32 (&aucCentralDirectory) (iPosition + 42) to biEntryLocalOffset
                    Get LittleEndianUInt16 (&aucCentralDirectory) (iPosition + 8) to iCentralFlags
                    Get LittleEndianUInt16 (&aucCentralDirectory) (iPosition + 10) to iCentralCompression
                    Get LittleEndianUInt16 (&aucCentralDirectory) (iPosition + 28) to iNameLength
                    Get LittleEndianUInt16 (&aucCentralDirectory) (iPosition + 30) to iExtraLength
                    Get LittleEndianUInt16 (&aucCentralDirectory) (iPosition + 32) to iEntryCommentLength
                    Get LittleEndianUInt16 (&aucCentralDirectory) (iPosition + 34) to iEntryDiskNumber
                    Move (C_ARCHIVE_ZIP_CENTRAL_HEADER_SIZE + iNameLength + ;
                        iExtraLength + iEntryCommentLength) to iRecordLength
                    If (biEntryCompressedSize = 4294967295 or ;
                        biEntryUncompressedSize = 4294967295 or ;
                        biEntryLocalOffset = 4294967295) Begin
                        Send SetZipMetadataFailure C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT ;
                            "Central-directory entry requires ZIP64 metadata." (&Metadata)
                        Move False to bOk
                    End
                    Else If ((iCentralFlags iand C_ARCHIVE_ZIP_ENCRYPTION_FLAGS) <> 0) Begin
                        Send SetZipMetadataFailure C_ARCHIVE_RESULT_ENCRYPTED ;
                            "Encrypted ZIP central-directory entries are not allowed." (&Metadata)
                        Move False to bOk
                    End
                    Else If (iCentralCompression <> C_ARCHIVE_ZIP_METHOD_STORE and ;
                        iCentralCompression <> C_ARCHIVE_ZIP_METHOD_DEFLATE) Begin
                        Send SetZipMetadataFailure C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT ;
                            "Only stored and deflated ZIP entries are supported." (&Metadata)
                        Move False to bOk
                    End
                    Else If (iEntryDiskNumber <> 0) Begin
                        Send SetZipMetadataFailure C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT ;
                            "Central-directory entry references another volume." (&Metadata)
                        Move False to bOk
                    End
                    Else If (biEntryUncompressedSize > piMaxEntryUncompressedBytes(Self)) Begin
                        Send SetZipMetadataFailure C_ARCHIVE_RESULT_ENTRY_TOO_LARGE ;
                            "Central-directory entry exceeds the configured uncompressed-size limit." (&Metadata)
                        Move False to bOk
                    End
                    Else If (biEntryUncompressedSize > ;
                        (piMaxTotalUncompressedBytes(Self) - biDeclaredTotal)) Begin
                        Send SetZipMetadataFailure C_ARCHIVE_RESULT_TOTAL_TOO_LARGE ;
                            "Central directory exceeds the configured total uncompressed-size limit." (&Metadata)
                        Move False to bOk
                    End
                    // Even overlapping entries cannot amplify compressed input
                    // work beyond the physical pre-directory byte region.
                    Else If (biEntryCompressedSize > (biCentralOffset - biCompressedTotal)) Begin
                        Send SetZipMetadataFailure C_ARCHIVE_RESULT_MALFORMED ;
                            "Aggregate ZIP compressed sizes exceed the bounded file-data region." (&Metadata)
                        Move False to bOk
                    End
                    Else If (iRecordLength > SizeOfArray(aucCentralDirectory) - iPosition) Begin
                        Send SetZipMetadataFailure C_ARCHIVE_RESULT_MALFORMED ;
                            "ZIP central-directory record exceeds its declared bounds." (&Metadata)
                        Move False to bOk
                    End
                    Else Begin
                        Get ValidateZipLocalHeader iChannel biEntryLocalOffset biCentralOffset ;
                            biEntryCompressedSize iCentralCompression (&iLocalErrorCode) ;
                            (&Metadata.sErrorMessage) to bOk
                        If (not(bOk)) Begin
                            Move iLocalErrorCode to Metadata.iErrorCode
                            Move False to Metadata.bSuccess
                        End
                        Else Begin
                            Increment iActualEntries
                            If (iActualEntries > piMaxEntries(Self)) Begin
                                Send SetZipMetadataFailure C_ARCHIVE_RESULT_TOO_MANY_ENTRIES ;
                                    "ZIP central directory exceeds the configured entry-count limit." (&Metadata)
                                Move False to bOk
                            End
                            Else Begin
                                Move (biCompressedTotal + biEntryCompressedSize) to biCompressedTotal
                                Move (biDeclaredTotal + biEntryUncompressedSize) to biDeclaredTotal
                                Move (iPosition + iRecordLength) to iPosition
                            End
                        End
                    End
                End
            Loop
        End

        Close_Input channel iChannel
        Send Seq_Release_Channel iChannel

        If (bOk and iActualEntries <> iEntriesTotal) Begin
            Send SetZipMetadataFailure C_ARCHIVE_RESULT_MALFORMED ;
                "ZIP end-record and central-directory entry counts differ." (&Metadata)
            Move False to bOk
        End

        If (bOk) Begin
            Move True to Metadata.bSuccess
            Move C_ARCHIVE_RESULT_OK to Metadata.iErrorCode
            Move iActualEntries to Metadata.iEntryCount
            Move biDeclaredTotal to Metadata.biDeclaredUncompressedBytes
            Move "" to Metadata.sErrorMessage
        End

        Function_Return Metadata
    End_Function

    // Opens only a plain, seekable ZIP. Restricting format and filter support
    // reduces parser surface and ensures entry sizes come from the central directory.
    { Visibility = Private }
    Function OpenZipReader String sArchivePath String ByRef sErrorMessage Returns Pointer
        Boolean bExists
        Integer iResult iIgnored
        Pointer pArchive
        WString wArchivePath

        File_Exist sArchivePath bExists
        If (not(bExists)) Begin
            Move "Archive file does not exist." to sErrorMessage
            Function_Return 0
        End

        Move (archive_read_new()) to pArchive
        If (pArchive = 0) Begin
            Move "Unable to allocate a libarchive reader." to sErrorMessage
            Function_Return 0
        End

        Move (archive_read_support_filter_none(pArchive)) to iResult
        If (iResult <> ARCHIVE_OK) Begin
            Get NativeError pArchive "Unable to enable the unfiltered reader" to sErrorMessage
            Move (archive_read_free(pArchive)) to iIgnored
            Function_Return 0
        End

        Move (archive_read_support_format_zip_seekable(pArchive)) to iResult
        If (iResult <> ARCHIVE_OK) Begin
            Get NativeError pArchive "Unable to enable the seekable ZIP reader" to sErrorMessage
            Move (archive_read_free(pArchive)) to iIgnored
            Function_Return 0
        End

        Move sArchivePath to wArchivePath
        Move (archive_read_open_filename_w(pArchive, AddressOf(wArchivePath), C_ARCHIVE_READ_OPEN_BLOCK_SIZE)) to iResult
        If (iResult <> ARCHIVE_OK) Begin
            Get NativeError pArchive "Unable to open archive" to sErrorMessage
            Move (archive_read_free(pArchive)) to iIgnored
            Function_Return 0
        End

        Function_Return pArchive
    End_Function

    // Always frees the native object. The close result matters only when the
    // preceding operation otherwise succeeded.
    { Visibility = Private }
    Function CloseZipReader Pointer pArchive Returns Boolean
        Integer iCloseResult iFreeResult

        If (pArchive = 0) ;
            Function_Return True

        Move (archive_read_close(pArchive)) to iCloseResult
        Move (archive_read_free(pArchive)) to iFreeResult

        Function_Return (iCloseResult = ARCHIVE_OK and iFreeResult = ARCHIVE_OK)
    End_Function

    { Visibility = Private }
    Procedure DiscardZipReader Pointer pArchive
        Integer iIgnored

        If (pArchive <> 0) Begin
            Move (archive_read_close(pArchive)) to iIgnored
            Move (archive_read_free(pArchive)) to iIgnored
        End
    End_Procedure

    { Visibility = Private }
    Function IsReservedWindowsName String sComponent Returns Boolean
        Integer iDot
        String sBase

        Move (Uppercase(sComponent)) to sBase
        Move (Pos(".", sBase)) to iDot
        If (iDot > 0) ;
            Move (Left(sBase, iDot - 1)) to sBase

        If (sBase = "CON" or sBase = "PRN" or sBase = "AUX" or sBase = "NUL" or ;
            sBase = "CLOCK$" or sBase = "CONIN$" or sBase = "CONOUT$") ;
            Function_Return True

        If (Length(sBase) = 4 and (Left(sBase, 3) = "COM" or Left(sBase, 3) = "LPT") and ;
            Right(sBase, 1) >= "0" and Right(sBase, 1) <= "9") ;
            Function_Return True

        // Windows also recognizes ISO-8859-1 superscript 1, 2 and 3 as device
        // suffixes. Literal Unicode keeps this check readable in DataFlex 25.
        If (sBase = "COM¹" or sBase = "COM²" or sBase = "COM³" or ;
            sBase = "LPT¹" or sBase = "LPT²" or sBase = "LPT³") ;
            Function_Return True

        Function_Return False
    End_Function

    // Normalizes ZIP separators and rejects Windows aliases that could escape
    // or overwrite the intended destination (UNC, drive paths, ADS and devices).
    Function IsSafeArchivePath String sArchivePath String ByRef sNormalizedPath String ByRef sReason Returns Boolean
        Integer i iCharacter
        String sPath sComponent
        String[] asComponents

        Move "" to sNormalizedPath
        Move "" to sReason
        // Replaces (plural) is essential: Replace changes only the first slash,
        // which would leave later "../" components for Win32 to normalize.
        Move (Replaces("/", sArchivePath, "\")) to sPath

        While (Length(sPath) > 0 and Right(sPath, 1) = "\")
            Move (Left(sPath, Length(sPath) - 1)) to sPath
        Loop

        If (sPath = "") Begin
            Move "Entry path is empty." to sReason
            Function_Return False
        End

        If (Left(sPath, 1) = "\" or Pos(":", sPath) > 0) Begin
            Move "Rooted, drive-relative and alternate-data-stream paths are not allowed." to sReason
            Function_Return False
        End

        If (Length(sPath) > piMaxPathLength(Self)) Begin
            Move "Entry path exceeds the configured path-length limit." to sReason
            Function_Return False
        End

        Move (ArchiveSplitString(sPath, "\")) to asComponents
        For i from 0 to (SizeOfArray(asComponents) - 1)
            Move asComponents[i] to sComponent

            If (sComponent = "" or sComponent = "." or sComponent = "..") Begin
                Move "Empty, current-directory and parent-directory path components are not allowed." to sReason
                Function_Return False
            End

            If (Trim(sComponent) <> sComponent or Right(sComponent, 1) = ".") Begin
                Move "Path components may not have leading/trailing spaces or trailing dots." to sReason
                Function_Return False
            End

            If (Pos("*", sComponent) > 0 or Pos("?", sComponent) > 0 or Pos('"', sComponent) > 0 or ;
                Pos("<", sComponent) > 0 or Pos(">", sComponent) > 0 or Pos("|", sComponent) > 0) Begin
                Move "Path contains characters that are invalid on Windows." to sReason
                Function_Return False
            End

            For iCharacter from 1 to (Length(sComponent))
                If (Ascii(Mid(sComponent, 1, iCharacter)) < 32) Begin
                    Move "Path contains a control character." to sReason
                    Function_Return False
                End
            Loop

            If (IsReservedWindowsName(Self, sComponent)) Begin
                Move "Path contains a reserved Windows device name." to sReason
                Function_Return False
            End

            If (sNormalizedPath = "") ;
                Move sComponent to sNormalizedPath
            Else ;
                Move (sNormalizedPath + "\" + sComponent) to sNormalizedPath
        Loop

        Function_Return True
    End_Function

    { Visibility = Private }
    Function EntryFailure Integer iErrorCode String sMessage Returns tZipEntryInfo
        tZipEntryInfo ZipEntryInfo

        Move False to ZipEntryInfo.bSuccess
        Move iErrorCode to ZipEntryInfo.iErrorCode
        Move sMessage to ZipEntryInfo.sErrorMessage
        Function_Return ZipEntryInfo
    End_Function

    // Validates metadata for one entry. The same safety checks are deliberately
    // run in both passes; callers must still keep the source file immutable.
    { Visibility = Private }
    Function ReadEntryInfo Pointer pArchive Pointer pEntry Integer iEntryNumber BigInt biCurrentTotal Returns tZipEntryInfo
        Boolean bSafePath
        Integer iFormat iEncrypted
        UShort usFileType
        BigInt biEntrySize biMaxEntry biMaxTotal
        Pointer pPath pLink
        String sRawPath sNormalizedPath sReason
        String[] asPathComponents
        tZipEntryInfo ZipEntryInfo

        If ((archive_format(pArchive) iand ARCHIVE_FORMAT_BASE_MASK) <> ARCHIVE_FORMAT_ZIP) ;
            Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT, "Input is not a ZIP archive."))

        If (piMaxEntries(Self) > 0 and iEntryNumber > piMaxEntries(Self)) ;
            Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_TOO_MANY_ENTRIES, "Archive exceeds the configured entry-count limit."))

        Move (archive_entry_pathname_w(pEntry)) to pPath
        If (pPath = 0) ;
            Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_UNSAFE_PATH, "Archive entry has no pathname."))

        Move (PointerToWString(pPath)) to sRawPath
        Get IsSafeArchivePath sRawPath (&sNormalizedPath) (&sReason) to bSafePath
        If (not(bSafePath)) ;
            Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_UNSAFE_PATH, sReason))

        Move (archive_entry_symlink_w(pEntry)) to pLink
        If (pLink = 0) ;
            Move (archive_entry_hardlink_w(pEntry)) to pLink
        If (pLink <> 0) ;
            Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_UNSAFE_TYPE, "Symbolic and hard links are not allowed."))

        Move (archive_entry_filetype(pEntry)) to usFileType
        If (usFileType <> AE_IFREG and usFileType <> AE_IFDIR) ;
            Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_UNSAFE_TYPE, "Only regular files and directories are allowed."))

        Move (archive_entry_is_encrypted(pEntry)) to iEncrypted
        If (iEncrypted <> 0) ;
            Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_ENCRYPTED, "Encrypted or encryption-indeterminate entries are not allowed."))

        Move True to ZipEntryInfo.bSuccess
        Move C_ARCHIVE_RESULT_OK to ZipEntryInfo.iErrorCode
        Move sNormalizedPath to ZipEntryInfo.sPath
        Move (usFileType = AE_IFDIR) to ZipEntryInfo.bDirectory
        Move (ArchiveSplitString(sNormalizedPath, "\")) to asPathComponents
        Move (SizeOfArray(asPathComponents)) to ZipEntryInfo.iPathComponentCount

        If (archive_entry_size_is_set(pEntry) = 0) ;
            Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_MALFORMED, "Entry has no declared uncompressed size."))

        Move (archive_entry_size(pEntry)) to biEntrySize
        If (biEntrySize < 0) ;
            Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_MALFORMED, "Entry has a negative uncompressed size."))

        If (usFileType = AE_IFDIR) Begin
            If (biEntrySize <> 0) ;
                Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_MALFORMED, "Directory entry contains a non-empty data body."))
        End
        Else Begin

            Get piMaxEntryUncompressedBytes to biMaxEntry
            If (biEntrySize > biMaxEntry) ;
                Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_ENTRY_TOO_LARGE, "Entry exceeds the configured uncompressed-size limit."))

            Get piMaxTotalUncompressedBytes to biMaxTotal
            // Compare before adding to avoid signed 64-bit overflow.
            If (biEntrySize > (biMaxTotal - biCurrentTotal)) ;
                Function_Return (EntryFailure(Self, C_ARCHIVE_RESULT_TOTAL_TOO_LARGE, "Archive exceeds the configured total uncompressed-size limit."))

            Move biEntrySize to ZipEntryInfo.biDeclaredSize
        End

        Function_Return ZipEntryInfo
    End_Function

    // Rejects case-insensitive duplicates and file/descendant collisions. It is
    // run before destination creation and again against the extraction pass.
    { Visibility = Private }
    Function ValidatePathCollection String[] asPaths String[] asFilePaths String ByRef sReason Returns Boolean
        Integer i iComponent iPathIndex
        String sParent
        String[] asComponents

        Move (SortArray(asPaths)) to asPaths
        Move (SortArray(asFilePaths)) to asFilePaths

        For i from 1 to (SizeOfArray(asPaths) - 1)
            If (asPaths[i] = asPaths[i - 1]) Begin
                Move ("Archive contains a duplicate path: " + asPaths[i]) to sReason
                Function_Return False
            End
        Loop

        // Check every parent rather than only the next sorted path: an unrelated
        // name such as "a!x" can sort between file "a" and "a\child".
        For i from 0 to (SizeOfArray(asPaths) - 1)
            Move (ArchiveSplitString(asPaths[i], "\")) to asComponents
            Move "" to sParent
            For iComponent from 0 to (SizeOfArray(asComponents) - 2)
                If (sParent = "") ;
                    Move asComponents[iComponent] to sParent
                Else ;
                    Move (sParent + "\" + asComponents[iComponent]) to sParent

                Move (BinarySearchArray(sParent, asFilePaths)) to iPathIndex
                If (iPathIndex >= 0) Begin
                    Move ("A regular file is also used as a parent path: " + sParent) to sReason
                    Function_Return False
                End
            Loop
        Loop

        Function_Return True
    End_Function

    Function InspectZipArchive String sArchivePath Returns tArchiveOperationResult
        Boolean bOk bReading
        Integer iHeaderResult iSkipResult iEncryptedEntries iPathComponentTotal
        Pointer pArchive pEntry
        BigInt biDeclaredTotal
        String sErrorMessage sPathReason
        String[] asPaths asFilePaths
        tZipEntryInfo ZipEntryInfo
        tZipDirectoryMetadata ZipMetadata
        tArchiveOperationResult Result

        If (Trim(sArchivePath) = "") Begin
            Send SetFailure C_ARCHIVE_RESULT_INVALID_ARGUMENT "Archive path is empty." (&Result)
            Function_Return Result
        End

        Get ValidateConfiguration (&sErrorMessage) to bOk
        If (not(bOk)) Begin
            Send SetFailure C_ARCHIVE_RESULT_INVALID_ARGUMENT sErrorMessage (&Result)
            Function_Return Result
        End

        Move (ArchiveFullPathName(sArchivePath)) to sArchivePath
        Get ReadZipDirectoryMetadata sArchivePath to ZipMetadata
        Move ZipMetadata.biArchiveBytes to Result.biArchiveBytes
        Move ZipMetadata.biCentralDirectoryBytes to Result.biCentralDirectoryBytes
        Move ZipMetadata.biDeclaredUncompressedBytes to Result.biDeclaredUncompressedBytes
        If (not(ZipMetadata.bSuccess)) Begin
            Send SetFailure ZipMetadata.iErrorCode ZipMetadata.sErrorMessage (&Result)
            Function_Return Result
        End

        Move (OpenZipReader(Self, sArchivePath, (&sErrorMessage))) to pArchive
        If (pArchive = 0) Begin
            Send SetFailure C_ARCHIVE_RESULT_OPEN_FAILED sErrorMessage (&Result)
            Function_Return Result
        End

        Move True to bOk
        Move True to bReading
        While (bReading)
            Move (archive_read_next_header(pArchive, AddressOf(pEntry))) to iHeaderResult
            If (iHeaderResult = ARCHIVE_EOF) Begin
                Move False to bReading
            End
            Else If (iHeaderResult <> ARCHIVE_OK) Begin
                Get NativeError pArchive "Unable to read an archive header" to sErrorMessage
                Send SetFailure C_ARCHIVE_RESULT_MALFORMED sErrorMessage (&Result)
                Move False to bOk
                Move False to bReading
            End
            Else Begin
                Increment Result.iEntryCount
                Get ReadEntryInfo pArchive pEntry Result.iEntryCount biDeclaredTotal to ZipEntryInfo
                If (not(ZipEntryInfo.bSuccess)) Begin
                    Send SetFailure ZipEntryInfo.iErrorCode ZipEntryInfo.sErrorMessage (&Result)
                    Move False to bOk
                    Move False to bReading
                End
                Else Begin
                    If (ZipEntryInfo.iPathComponentCount > ;
                        (piMaxPathComponents(Self) - iPathComponentTotal)) Begin
                        Send SetFailure C_ARCHIVE_RESULT_TOO_MANY_PATH_COMPONENTS ;
                            "Archive exceeds the configured aggregate path-component limit." (&Result)
                        Move False to bOk
                        Move False to bReading
                    End
                    Else Begin
                        Move (iPathComponentTotal + ZipEntryInfo.iPathComponentCount) to iPathComponentTotal
                        Move (biDeclaredTotal + ZipEntryInfo.biDeclaredSize) to biDeclaredTotal
                        Move (Lowercase(ZipEntryInfo.sPath)) to asPaths[-1]
                        If (not(ZipEntryInfo.bDirectory)) ;
                            Move (Lowercase(ZipEntryInfo.sPath)) to asFilePaths[-1]

                        Move (archive_read_data_skip(pArchive)) to iSkipResult
                        If (iSkipResult <> ARCHIVE_OK) Begin
                            Get NativeError pArchive "Unable to skip archive entry data" to sErrorMessage
                            Send SetFailure C_ARCHIVE_RESULT_MALFORMED sErrorMessage (&Result)
                            Move False to bOk
                            Move False to bReading
                        End
                    End
                End
            End
        Loop

        Move iPathComponentTotal to Result.iPathComponentCount
        Move biDeclaredTotal to Result.biDeclaredUncompressedBytes

        If (bOk and (Result.iEntryCount <> ZipMetadata.iEntryCount or ;
            biDeclaredTotal <> ZipMetadata.biDeclaredUncompressedBytes)) Begin
            Send SetFailure C_ARCHIVE_RESULT_MALFORMED ;
                "libarchive and the ZIP central directory report different metadata totals." (&Result)
            Move False to bOk
        End

        If (bOk) Begin
            Move (archive_read_has_encrypted_entries(pArchive)) to iEncryptedEntries
            If (iEncryptedEntries <> 0) Begin
                Send SetFailure C_ARCHIVE_RESULT_ENCRYPTED "Archive encryption status is encrypted or indeterminate." (&Result)
                Move False to bOk
            End
        End

        If (bOk) Begin
            Get ValidatePathCollection asPaths asFilePaths (&sPathReason) to bOk
            If (not(bOk)) ;
                Send SetFailure C_ARCHIVE_RESULT_DUPLICATE_PATH sPathReason (&Result)
        End

        If (bOk) Begin
            Get CloseZipReader pArchive to bOk
            Move 0 to pArchive
            If (not(bOk)) ;
                Send SetFailure C_ARCHIVE_RESULT_MALFORMED "Unable to close archive cleanly." (&Result)
        End
        Else Begin
            Send DiscardZipReader pArchive
            Move 0 to pArchive
        End

        If (bOk) Begin
            Move True to Result.bSuccess
            Move C_ARCHIVE_RESULT_OK to Result.iErrorCode
            Move "" to Result.sErrorMessage
        End

        Function_Return Result
    End_Function

    // Creates one private directory through libarchive's platform-native disk
    // writer. NO_OVERWRITE and SECURE_SYMLINKS are configured by the caller.
    { Visibility = Private }
    Function CreateDiskDirectory Pointer pDisk String sPath String[] ByRef asCreatedDirectories String ByRef sErrorMessage Returns Boolean
        Integer iResult iIgnored
        Pointer pEntry

        Move (archive_entry_new()) to pEntry
        If (pEntry = 0) Begin
            Move "Unable to allocate an extraction directory entry." to sErrorMessage
            Function_Return False
        End

        Move (archive_entry_set_pathname_utf8(pEntry, AddressOf(sPath))) to iIgnored
        Move (archive_entry_set_filetype(pEntry, AE_IFDIR)) to iIgnored
        Move (archive_entry_set_perm(pEntry, ARCHIVE_USER_ONLY_FULL_ACCESS)) to iIgnored
        Move (archive_write_header(pDisk, pEntry)) to iResult
        If (iResult = ARCHIVE_OK) Begin
            Move sPath to asCreatedDirectories[-1]
            Move (archive_write_finish_entry(pDisk)) to iResult
        End

        If (iResult <> ARCHIVE_OK) ;
            Get NativeError pDisk ("Unable to create destination directory: " + sPath) to sErrorMessage

        Move (archive_entry_free(pEntry)) to iIgnored
        Function_Return (iResult = ARCHIVE_OK)
    End_Function

    // Builds directories one component at a time under the new private root.
    { Visibility = Private }
    Function EnsureRelativeDirectory Pointer pDisk String sRoot String sRelativeDirectory String[] ByRef asCreatedDirectories String ByRef sErrorMessage Returns Boolean
        Integer i
        Boolean bExists bOk
        String sCurrentPath sSeparator
        String[] asComponents

        If (sRelativeDirectory = "") ;
            Function_Return True

        Move (SysConf(SYSCONF_DIR_SEPARATOR)) to sSeparator
        Move (ArchiveSplitString(sRelativeDirectory, sSeparator)) to asComponents
        Move sRoot to sCurrentPath

        For i from 0 to (SizeOfArray(asComponents) - 1)
            Move (sCurrentPath + sSeparator + asComponents[i]) to sCurrentPath
            File_Exist sCurrentPath bExists

            If (not(bExists or ArchivePathIsPhysicalDirectory(sCurrentPath))) Begin
                Get CreateDiskDirectory pDisk sCurrentPath (&asCreatedDirectories) (&sErrorMessage) to bOk
                If (not(bOk)) ;
                    Function_Return False
            End
            Else If (not(ArchivePathIsPhysicalDirectory(sCurrentPath))) Begin
                Move ("Destination path is not a safe directory: " + sCurrentPath) to sErrorMessage
                Function_Return False
            End
        Loop

        Function_Return True
    End_Function

    { Visibility = Private }
    Function ExtractCurrentFile Pointer pArchive Pointer pDisk String sFullPath BigInt biDeclaredSize BigInt ByRef biActualTotal String[] ByRef asCreatedFiles Integer ByRef iErrorCode String ByRef sErrorMessage Returns Boolean
        Boolean bOk
        Integer iBlockSize iWriteResult iHeaderResult iFinishResult iIgnored
        LongPtr lpBytesRead
        BigInt biEntryActual biMaxEntry biMaxTotal
        UChar[] aucBuffer
        Pointer pEntry

        Move (archive_entry_new()) to pEntry
        If (pEntry = 0) Begin
            Move C_ARCHIVE_RESULT_IO_ERROR to iErrorCode
            Move "Unable to allocate an extracted file entry." to sErrorMessage
            Function_Return False
        End

        Move (archive_entry_set_pathname_utf8(pEntry, AddressOf(sFullPath))) to iIgnored
        // Keep the disk-writer size unset. This class enforces the validated
        // declaration while streaming, and an unknown writer size lets a failed
        // entry close without padding a partial file up to its declared size.
        Move (archive_entry_set_filetype(pEntry, AE_IFREG)) to iIgnored
        Move (archive_entry_set_perm(pEntry, ARCHIVE_PRIVATE_USER_READABLE_WRITEABLE)) to iIgnored
        Move (archive_write_header(pDisk, pEntry)) to iHeaderResult
        If (iHeaderResult <> ARCHIVE_OK) Begin
            Get NativeError pDisk ("Unable to create extracted file: " + sFullPath) to sErrorMessage
            Move (archive_entry_free(pEntry)) to iIgnored
            Move C_ARCHIVE_RESULT_IO_ERROR to iErrorCode
            Function_Return False
        End
        Move sFullPath to asCreatedFiles[-1]

        Get piReadBlockSize to iBlockSize
        Move (ResizeArray(aucBuffer, iBlockSize)) to aucBuffer
        Get piMaxEntryUncompressedBytes to biMaxEntry
        Get piMaxTotalUncompressedBytes to biMaxTotal
        Move C_ARCHIVE_RESULT_IO_ERROR to iErrorCode
        Move True to bOk

        Repeat
            Move (archive_read_data(pArchive, AddressOf(aucBuffer), iBlockSize)) to lpBytesRead
            If (lpBytesRead < 0) Begin
                Move C_ARCHIVE_RESULT_MALFORMED to iErrorCode
                Get NativeError pArchive "Unable to decompress archive entry" to sErrorMessage
                Move False to bOk
            End
            Else If (lpBytesRead > 0) Begin
                // Enforce the declared size and configured limits before a byte
                // of the returned block is written to disk.
                If (lpBytesRead > (biDeclaredSize - biEntryActual)) Begin
                    Move C_ARCHIVE_RESULT_SIZE_MISMATCH to iErrorCode
                    Move "Actual decompressed data exceeds the declared entry size." to sErrorMessage
                    Move False to bOk
                End
                Else If (lpBytesRead > (biMaxEntry - biEntryActual)) Begin
                    Move C_ARCHIVE_RESULT_ENTRY_TOO_LARGE to iErrorCode
                    Move "Actual decompressed data exceeds the configured entry-size limit." to sErrorMessage
                    Move False to bOk
                End
                Else If (lpBytesRead > (biMaxTotal - biActualTotal)) Begin
                    Move C_ARCHIVE_RESULT_TOTAL_TOO_LARGE to iErrorCode
                    Move "Actual decompressed data exceeds the configured total-size limit." to sErrorMessage
                    Move False to bOk
                End
                Else Begin
                    Move (archive_write_data(pDisk, AddressOf(aucBuffer), Integer(lpBytesRead))) to iWriteResult
                    // archive_write_disk may return zero after a successful
                    // write, so only negative values indicate failure.
                    If (iWriteResult < 0) Begin
                        Move C_ARCHIVE_RESULT_IO_ERROR to iErrorCode
                        Get NativeError pDisk ("Unable to write extracted file: " + sFullPath) to sErrorMessage
                        Move False to bOk
                    End
                    Else Begin
                        Move (biEntryActual + lpBytesRead) to biEntryActual
                        Move (biActualTotal + lpBytesRead) to biActualTotal
                    End
                End
            End
        Until (not(bOk) or lpBytesRead = 0)

        If (bOk and biEntryActual <> biDeclaredSize) Begin
            Move C_ARCHIVE_RESULT_SIZE_MISMATCH to iErrorCode
            Move ("Actual and declared entry sizes differ for: " + sFullPath) to sErrorMessage
            Move False to bOk
        End

        If (bOk) Begin
            Move (archive_write_finish_entry(pDisk)) to iFinishResult
            If (iFinishResult <> ARCHIVE_OK) Begin
                Move C_ARCHIVE_RESULT_IO_ERROR to iErrorCode
                Get NativeError pDisk ("Unable to finish extracted file: " + sFullPath) to sErrorMessage
                Move False to bOk
            End
        End
        Else Begin
            // The writer has no declared size, so finishing only closes the
            // partial file and cannot allocate attacker-controlled padding.
            Move (archive_write_finish_entry(pDisk)) to iIgnored
        End

        Move (archive_entry_free(pEntry)) to iIgnored
        Function_Return bOk
    End_Function

    { Visibility = Private }
    Function CleanupExtraction String[] asCreatedFiles String[] asCreatedDirectories String ByRef sCleanupError Returns Boolean
        Integer i
        Boolean bExists bOk

        Move True to bOk
        Move "" to sCleanupError

        Move (SizeOfArray(asCreatedFiles) - 1) to i
        While (i >= 0)
            File_Exist asCreatedFiles[i] bExists
            If (bExists) Begin
                Move False to Err
                EraseFile asCreatedFiles[i]
                If (Err) Begin
                    Move False to bOk
                    If (sCleanupError = "") ;
                        Move ("Unable to remove partial file: " + asCreatedFiles[i]) to sCleanupError
                End
            End
            Decrement i
        Loop

        Move (SizeOfArray(asCreatedDirectories) - 1) to i
        While (i >= 0)
            Move False to Err
            Remove_Directory asCreatedDirectories[i]
            If (Err) Begin
                Move False to bOk
                If (sCleanupError = "") ;
                    Move ("Unable to remove partial directory: " + asCreatedDirectories[i]) to sCleanupError
            End
            Decrement i
        Loop

        Function_Return bOk
    End_Function

    // Performs metadata preflight first, then reopens and extracts through a
    // bounded stream. The destination must not already exist so failure cleanup
    // cannot delete or overwrite caller-owned data. Source and destination parent
    // must be application-owned and not writable by untrusted processes.
    Function ExtractZipArchive String sArchivePath String sDestination Returns tArchiveOperationResult
        Boolean bExists bOk bReading bCleanupOk
        Integer iHeaderResult iSkipResult iEncryptedEntries iExtractionEntryCount iExtractionErrorCode iExtractionPathComponents
        Integer iDiskResult iDiskCloseResult iDiskFreeResult iIgnored
        Pointer pArchive pEntry pDisk
        BigInt biExtractionDeclaredTotal biActualTotal
        String sErrorMessage sCleanupError sRoot sParent sRelativeParent sFullPath sPathReason
        String sSeparator sNativeRelativePath
        String[] asCreatedFiles asCreatedDirectories asExtractionPaths asExtractionFilePaths
        tZipEntryInfo ZipEntryInfo
        tZipDirectoryMetadata ZipMetadata
        tArchiveOperationResult Result

        Move (ArchiveFullPathName(sArchivePath)) to sArchivePath
        Get InspectZipArchive sArchivePath to Result
        If (not(Result.bSuccess)) ;
            Function_Return Result

        If (Trim(sDestination) = "") Begin
            Send SetFailure C_ARCHIVE_RESULT_INVALID_ARGUMENT "Destination path is empty." (&Result)
            Function_Return Result
        End

        Move (ArchiveFullPathName(sDestination)) to sRoot
        Move (SysConf(SYSCONF_DIR_SEPARATOR)) to sSeparator
        While (Length(sRoot) > 3 and Right(sRoot, 1) = sSeparator)
            Move (Left(sRoot, Length(sRoot) - 1)) to sRoot
        Loop

        File_Exist sRoot bExists
        If (bExists or ArchivePathIsPhysicalDirectory(sRoot)) Begin
            Send SetFailure C_ARCHIVE_RESULT_DESTINATION_EXISTS "Destination already exists." (&Result)
            Function_Return Result
        End

        Move (ArchivePathDirectory(sRoot)) to sParent
        While (Length(sParent) > 3 and Right(sParent, 1) = sSeparator)
            Move (Left(sParent, Length(sParent) - 1)) to sParent
        Loop
        If (not(ArchivePathIsPhysicalDirectory(sParent))) Begin
            Send SetFailure C_ARCHIVE_RESULT_INVALID_ARGUMENT ;
                "Destination parent must be an existing directory." (&Result)
            Function_Return Result
        End

        // Recheck immediately before destination creation so a source change
        // cannot substitute an over-budget central directory for the second pass.
        Get ReadZipDirectoryMetadata sArchivePath to ZipMetadata
        If (not(ZipMetadata.bSuccess)) Begin
            Send SetFailure ZipMetadata.iErrorCode ZipMetadata.sErrorMessage (&Result)
            Function_Return Result
        End
        If (ZipMetadata.iEntryCount <> Result.iEntryCount or ;
            ZipMetadata.biArchiveBytes <> Result.biArchiveBytes or ;
            ZipMetadata.biCentralDirectoryBytes <> Result.biCentralDirectoryBytes or ;
            ZipMetadata.biDeclaredUncompressedBytes <> Result.biDeclaredUncompressedBytes) Begin
            Send SetFailure C_ARCHIVE_RESULT_SIZE_MISMATCH ;
                "Archive metadata changed between inspection and extraction." (&Result)
            Function_Return Result
        End

        Move (archive_write_disk_new()) to pDisk
        If (pDisk = 0) Begin
            Send SetFailure C_ARCHIVE_RESULT_IO_ERROR "Unable to initialize the extraction disk writer." (&Result)
            Function_Return Result
        End

        Move (archive_write_disk_set_options(pDisk, ;
            (ARCHIVE_EXTRACT_NO_OVERWRITE ior ARCHIVE_EXTRACT_SECURE_SYMLINKS ior ;
             ARCHIVE_EXTRACT_SECURE_NODOTDOT ior ARCHIVE_EXTRACT_NO_AUTODIR))) to iDiskResult
        If (iDiskResult <> ARCHIVE_OK) Begin
            Get NativeError pDisk "Unable to configure the extraction disk writer" to sErrorMessage
            Send SetFailure C_ARCHIVE_RESULT_IO_ERROR sErrorMessage (&Result)
            Move (archive_write_free(pDisk)) to iIgnored
            Function_Return Result
        End

        Get CreateDiskDirectory pDisk sRoot (&asCreatedDirectories) (&sErrorMessage) to bOk
        If (not(bOk)) Begin
            Send SetFailure C_ARCHIVE_RESULT_IO_ERROR sErrorMessage (&Result)
            Move (archive_write_close(pDisk)) to iIgnored
            Move (archive_write_free(pDisk)) to iIgnored
            Move 0 to pDisk
            Get CleanupExtraction asCreatedFiles asCreatedDirectories (&sCleanupError) to bCleanupOk
            If (not(bCleanupOk)) ;
                Send SetFailure C_ARCHIVE_RESULT_CLEANUP_FAILED sCleanupError (&Result)
            Function_Return Result
        End

        Move (OpenZipReader(Self, sArchivePath, (&sErrorMessage))) to pArchive
        If (pArchive = 0) Begin
            Send SetFailure C_ARCHIVE_RESULT_OPEN_FAILED sErrorMessage (&Result)
            Move (archive_write_close(pDisk)) to iIgnored
            Move (archive_write_free(pDisk)) to iIgnored
            Move 0 to pDisk
            Get CleanupExtraction asCreatedFiles asCreatedDirectories (&sCleanupError) to bCleanupOk
            If (not(bCleanupOk)) ;
                Send SetFailure C_ARCHIVE_RESULT_CLEANUP_FAILED sCleanupError (&Result)
            Function_Return Result
        End

        Move True to bOk
        Move True to bReading
        While (bReading)
            Move (archive_read_next_header(pArchive, AddressOf(pEntry))) to iHeaderResult
            If (iHeaderResult = ARCHIVE_EOF) Begin
                Move False to bReading
            End
            Else If (iHeaderResult <> ARCHIVE_OK) Begin
                Get NativeError pArchive "Unable to read an archive header during extraction" to sErrorMessage
                Send SetFailure C_ARCHIVE_RESULT_MALFORMED sErrorMessage (&Result)
                Move False to bOk
                Move False to bReading
            End
            Else Begin
                Increment iExtractionEntryCount
                Get ReadEntryInfo pArchive pEntry iExtractionEntryCount biExtractionDeclaredTotal to ZipEntryInfo
                If (not(ZipEntryInfo.bSuccess)) Begin
                    Send SetFailure ZipEntryInfo.iErrorCode ZipEntryInfo.sErrorMessage (&Result)
                    Move False to bOk
                    Move False to bReading
                End
                Else Begin
                    If (ZipEntryInfo.iPathComponentCount > ;
                        (piMaxPathComponents(Self) - iExtractionPathComponents)) Begin
                        Send SetFailure C_ARCHIVE_RESULT_TOO_MANY_PATH_COMPONENTS ;
                            "Archive exceeds the configured aggregate path-component limit during extraction." (&Result)
                        Move False to bOk
                        Move False to bReading
                    End
                    Else Begin
                        Move (iExtractionPathComponents + ZipEntryInfo.iPathComponentCount) to iExtractionPathComponents
                        Move (biExtractionDeclaredTotal + ZipEntryInfo.biDeclaredSize) to biExtractionDeclaredTotal
                        Move (Lowercase(ZipEntryInfo.sPath)) to asExtractionPaths[-1]
                        If (not(ZipEntryInfo.bDirectory)) ;
                            Move (Lowercase(ZipEntryInfo.sPath)) to asExtractionFilePaths[-1]
                        Move (Replace("\", ZipEntryInfo.sPath, sSeparator)) to sNativeRelativePath
                        Move (ArchiveFullPathName(sRoot + sSeparator + sNativeRelativePath)) to sFullPath
                        // This is a defense-in-depth boundary check after path
                        // normalization; IsSafeArchivePath already rejects dots.
                        If (Left(Lowercase(sFullPath), Length(sRoot) + 1) <> ;
                            Lowercase(sRoot + sSeparator)) Begin
                            Send SetFailure C_ARCHIVE_RESULT_UNSAFE_PATH "Expanded destination path escapes the extraction root." (&Result)
                            Move False to bOk
                            Move False to bReading
                        End
                        Else If (ZipEntryInfo.bDirectory) Begin
                            Move C_ARCHIVE_RESULT_IO_ERROR to iExtractionErrorCode
                            Get EnsureRelativeDirectory pDisk sRoot sNativeRelativePath (&asCreatedDirectories) (&sErrorMessage) to bOk
                            If (bOk) Begin
                                Move (archive_read_data_skip(pArchive)) to iSkipResult
                                Move (iSkipResult = ARCHIVE_OK) to bOk
                                If (not(bOk)) Begin
                                    Move C_ARCHIVE_RESULT_MALFORMED to iExtractionErrorCode
                                    Get NativeError pArchive "Unable to skip directory entry data" to sErrorMessage
                                End
                            End
                            If (not(bOk)) Begin
                                Send SetFailure iExtractionErrorCode sErrorMessage (&Result)
                                Move False to bReading
                            End
                        End
                        Else Begin
                            Move (ArchivePathDirectory(sNativeRelativePath)) to sRelativeParent
                            While (Length(sRelativeParent) > 0 and Right(sRelativeParent, 1) = sSeparator)
                                Move (Left(sRelativeParent, Length(sRelativeParent) - 1)) to sRelativeParent
                            Loop

                            Move C_ARCHIVE_RESULT_IO_ERROR to iExtractionErrorCode
                            Get EnsureRelativeDirectory pDisk sRoot sRelativeParent (&asCreatedDirectories) (&sErrorMessage) to bOk
                            If (bOk) ;
                                Get ExtractCurrentFile pArchive pDisk sFullPath ZipEntryInfo.biDeclaredSize (&biActualTotal) ;
                                    (&asCreatedFiles) (&iExtractionErrorCode) (&sErrorMessage) to bOk

                            If (not(bOk)) Begin
                                Send SetFailure iExtractionErrorCode sErrorMessage (&Result)
                                Move False to bReading
                            End
                        End
                    End
                End
            End
        Loop

        If (bOk) Begin
            Get ValidatePathCollection asExtractionPaths asExtractionFilePaths (&sPathReason) to bOk
            If (not(bOk)) ;
                Send SetFailure C_ARCHIVE_RESULT_DUPLICATE_PATH sPathReason (&Result)
        End

        If (bOk) Begin
            Move (archive_read_has_encrypted_entries(pArchive)) to iEncryptedEntries
            If (iEncryptedEntries <> 0) Begin
                Send SetFailure C_ARCHIVE_RESULT_ENCRYPTED "Archive encryption status is encrypted or indeterminate." (&Result)
                Move False to bOk
            End
        End

        If (bOk and (iExtractionEntryCount <> Result.iEntryCount or ;
            iExtractionPathComponents <> Result.iPathComponentCount or ;
            biExtractionDeclaredTotal <> Result.biDeclaredUncompressedBytes)) Begin
            Send SetFailure C_ARCHIVE_RESULT_SIZE_MISMATCH "Archive changed between inspection and extraction." (&Result)
            Move False to bOk
        End

        If (bOk) Begin
            Get CloseZipReader pArchive to bOk
            Move 0 to pArchive
            If (not(bOk)) ;
                Send SetFailure C_ARCHIVE_RESULT_MALFORMED "Unable to close archive cleanly after extraction." (&Result)
        End
        Else Begin
            Send DiscardZipReader pArchive
            Move 0 to pArchive
        End

        // Close explicitly before freeing: the disk writer can otherwise keep
        // the current file open until its implicit close path has completed.
        Move (archive_write_close(pDisk)) to iDiskCloseResult
        Move (archive_write_free(pDisk)) to iDiskFreeResult
        Move 0 to pDisk
        If (bOk and (iDiskCloseResult <> ARCHIVE_OK or iDiskFreeResult <> ARCHIVE_OK)) Begin
            Send SetFailure C_ARCHIVE_RESULT_IO_ERROR "Unable to close the extraction disk writer cleanly." (&Result)
            Move False to bOk
        End

        Move biActualTotal to Result.biExtractedBytes
        If (bOk) Begin
            Move True to Result.bSuccess
            Move C_ARCHIVE_RESULT_OK to Result.iErrorCode
            Move "" to Result.sErrorMessage
        End
        Else Begin
            Get CleanupExtraction asCreatedFiles asCreatedDirectories (&sCleanupError) to bCleanupOk
            If (not(bCleanupOk)) ;
                Send SetFailure C_ARCHIVE_RESULT_CLEANUP_FAILED sCleanupError (&Result)
        End

        Function_Return Result
    End_Function
End_Class
