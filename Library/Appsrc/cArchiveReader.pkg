    End_Function

    // Enables reading of tar archives: v7, ustar, pax and GNU variants (archive_read_support_format_tar).
    Function SupportFormatTar Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_tar" to pArchive
