        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_warc"))
    End_Function

    // Enables reading of XAR archives (archive_read_support_format_xar).
    Function SupportFormatXar Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_xar" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
