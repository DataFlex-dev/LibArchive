        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_cpio"))
    End_Function

    // Enables reading of empty (zero byte) archives; they report no entries instead of an error (archive_read_support_format_empty).
    Function SupportFormatEmpty Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_empty" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_empty (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_empty"))
    End_Function

    // Enables reading of GNU tar archives and the tar variants it can detect (archive_read_support_format_gnutar).
    Function SupportFormatGnutar Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_gnutar" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_gnutar (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_gnutar"))
    End_Function

    // Enables reading of ISO 9660 images including Rock Ridge and Joliet (archive_read_support_format_iso9660).
    Function SupportFormatIso9660 Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_iso9660" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_iso9660 (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_iso9660"))
    End_Function

    // Enables reading of LHA/LZH archives (archive_read_support_format_lha).
    Function SupportFormatLha Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_lha" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_lha (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_lha"))
    End_Function

    // Enables reading of mtree manifests (archive_read_support_format_mtree).
    Function SupportFormatMtree Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_mtree" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_mtree (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_mtree"))
    End_Function

    // Enables reading of RAR archives up to version 4 (archive_read_support_format_rar).
    Function SupportFormatRar Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_rar" to pArchive
        If (pArchive = 0) Begin
