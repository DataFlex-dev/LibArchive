    // Enables reading of RAR 5 archives (archive_read_support_format_rar5). libarchive 3.7.7 crashes when this format is
    // registered twice (also through SupportFormatAll), so the call is skipped (and ARCHIVE_OK returned) when it was
    // done before on this handle.
    Function SupportFormatRar5 Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_rar5" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (pbRar5Registered (Self)) Begin
            Function_Return ARCHIVE_OK
        End
        Move (archive_read_support_format_rar5 (pArchive)) to iResult
        If (iResult = ARCHIVE_OK) Begin
            Set pbRar5Registered to True
        End
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_rar5"))
    End_Function

    // Enables all formats libarchive can read, except raw (archive_read_support_format_all). Calling it twice has no
    // effect. When SupportFormatRar5 was called before (libarchive 3.7.7 crashes on a second rar5 registration) the other
    // formats are enabled one by one instead. Returns ARCHIVE_OK or the first result that was not ARCHIVE_OK.
    Function SupportFormatAll Returns Integer
        Pointer pArchive
        Integer iResult iFirst

        Get HandleFor "archive_read_support_format_all" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (pbAllRegistered (Self)) Begin
            Function_Return ARCHIVE_OK
        End
        If (pbRar5Registered (Self)) Begin
            Move ARCHIVE_OK to iFirst
            Get SupportFormatAr to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatCpio to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatEmpty to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatIso9660 to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatLha to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatMtree to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatTar to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatXar to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatWarc to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormat7zip to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatCab to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatRar to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Get SupportFormatZip to iResult
            If (iResult <= ARCHIVE_FAILED and iFirst = ARCHIVE_OK) Begin
                Move iResult to iFirst
            End
            Set pbAllRegistered to True
            Function_Return iFirst
        End
        Move (archive_read_support_format_all (pArchive)) to iResult
        If (iResult = ARCHIVE_OK) Begin
            Set pbAllRegistered to True
            Set pbRar5Registered to True
        End
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_all"))
    End_Function


    // Enables reading of one format by its code, ARCHIVE_FORMAT_* base code such as ARCHIVE_FORMAT_ZIP
    // (archive_read_support_format_by_code).
    Function SupportFormatByCode Integer eFormat Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_by_code" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (eFormat = ARCHIVE_FORMAT_RAR_V5) Begin
            // goes through SupportFormatRar5 to avoid the double registration crash
            Get SupportFormatRar5 to iResult
            Function_Return iResult
        End
        Move (archive_read_support_format_by_code (pArchive, eFormat)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_by_code"))
    End_Function

    // Selects the format by its code and bypasses the format detection; use it when the format is known in advance
    // (archive_read_set_format).
    Function SetFormat Integer eFormat Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_set_format" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (eFormat = ARCHIVE_FORMAT_RAR_V5 and pbRar5Registered (Self)) Begin
            Function_Return ARCHIVE_OK
        End
        Move (archive_read_set_format (pArchive, eFormat)) to iResult
        If (eFormat = ARCHIVE_FORMAT_RAR_V5 and iResult = ARCHIVE_OK) Begin
            Set pbRar5Registered to True
        End
        Function_Return (CheckResult (Self, iResult, "archive_read_set_format"))
    End_Function

