Use cArchiveBase.pkg
Use cArchiveEntry.pkg
Use seq_chnl.pkg
Use ArchivePath.pkg

// Wrappers around the libarchive read functions (archive_read_*):
//   cArchiveReaderBase  - entry iteration and data reading that cArchiveReader and cArchiveDiskReader share
//   cArchiveReader      - reads archives (zip, tar, 7zip, ...) from files, memory, file descriptors and FILE pointers
//
// Callbacks: DataFlex cannot create native C callback function pointers. The libarchive functions that need
// callbacks (archive_read_open, archive_read_open2, archive_read_set_*_callback, archive_read_*_callback_data*,
// archive_read_set_passphrase_callback, archive_read_extract_set_progress_callback) are declared in
// ArchiveRead.h.pkg but are NOT exposed by these classes. Use the Open* methods, AddPassphrase and the
// convenience methods instead.

// Whence values of SeekData (the C constants SEEK_SET, SEEK_CUR and SEEK_END).
#IFNDEF ARCHIVE_SEEK_SET
Define ARCHIVE_SEEK_SET for 0 // From the start of the entry data.
Define ARCHIVE_SEEK_CUR for 1 // From the current position.
Define ARCHIVE_SEEK_END for 2 // From the end of the entry data.
#ENDIF

// Summary of one archive entry (or one file of a folder, see cArchiveDiskReader.ListFolder).
Struct tArchiveEntryInfo
    String sPathname    // Path name (UTF-8 text, "/" separated in archives).
    BigInt iSize        // Size of the data in bytes.
    BigInt iMtime       // Modification time, seconds since 1970-01-01 UTC.
    Integer eFileType   // AE_IFREG, AE_IFDIR, AE_IFLNK, ...
    Integer iPerm       // Permission bits (420 = 0644).
    Boolean bEncrypted  // True when the data or metadata of the entry is encrypted.
End_Struct

// ---- ZIP preflight and bounded extraction ----
// Conservative defaults keep accidental use bounded. Applications should set
// both byte limits to their own upload policy before inspecting or extracting.
Define C_ARCHIVE_DEFAULT_MAX_ENTRY_BYTES for 104857600  // 100 MiB
Define C_ARCHIVE_DEFAULT_MAX_TOTAL_BYTES for 104857600  // 100 MiB
Define C_ARCHIVE_DEFAULT_MAX_ARCHIVE_BYTES for 104857600 // 100 MiB
Define C_ARCHIVE_DEFAULT_MAX_CENTRAL_DIRECTORY_BYTES for 8388608 // 8 MiB
Define C_ARCHIVE_DEFAULT_MAX_ENTRIES     for 10000
Define C_ARCHIVE_DEFAULT_MAX_PATH_LENGTH for 240
Define C_ARCHIVE_DEFAULT_MAX_PATH_COMPONENTS for 100000
Define C_ARCHIVE_DEFAULT_READ_BLOCK_SIZE for 65536

// Stable application-level result codes. Native libarchive details are kept in
// sErrorMessage so a server can log them while returning a generic client error.
Define C_ARCHIVE_RESULT_OK                 for 0
Define C_ARCHIVE_RESULT_INVALID_ARGUMENT   for 1
Define C_ARCHIVE_RESULT_OPEN_FAILED        for 2
Define C_ARCHIVE_RESULT_MALFORMED          for 3
Define C_ARCHIVE_RESULT_UNSUPPORTED_FORMAT for 4
Define C_ARCHIVE_RESULT_ENCRYPTED          for 5
Define C_ARCHIVE_RESULT_TOO_MANY_ENTRIES   for 6
Define C_ARCHIVE_RESULT_ENTRY_TOO_LARGE    for 7
Define C_ARCHIVE_RESULT_TOTAL_TOO_LARGE    for 8
Define C_ARCHIVE_RESULT_UNSAFE_PATH        for 9
Define C_ARCHIVE_RESULT_UNSAFE_TYPE        for 10
Define C_ARCHIVE_RESULT_DUPLICATE_PATH     for 11
Define C_ARCHIVE_RESULT_DESTINATION_EXISTS for 12
Define C_ARCHIVE_RESULT_IO_ERROR           for 13
Define C_ARCHIVE_RESULT_SIZE_MISMATCH       for 14
Define C_ARCHIVE_RESULT_CLEANUP_FAILED      for 15
Define C_ARCHIVE_RESULT_TOO_MANY_PATH_COMPONENTS for 16
Define C_ARCHIVE_RESULT_ARCHIVE_TOO_LARGE for 17
Define C_ARCHIVE_RESULT_CENTRAL_DIRECTORY_TOO_LARGE for 18

Define C_ARCHIVE_READ_OPEN_BLOCK_SIZE for 10240
Define C_ARCHIVE_ZIP_EOCD_MIN_SIZE for 22
// EOCD (22) + maximum comment (65,535) + a possible ZIP64 locator (20).
Define C_ARCHIVE_ZIP_EOCD_MAX_SEARCH for 65577
Define C_ARCHIVE_ZIP_CENTRAL_HEADER_SIZE for 46
Define C_ARCHIVE_ZIP_UINT16_MAX for 65535
Define C_ARCHIVE_ZIP_ENCRYPTION_FLAGS for 8257 // Bits 0, 6 and 13
Define C_ARCHIVE_ZIP_METHOD_STORE for 0
Define C_ARCHIVE_ZIP_METHOD_DEFLATE for 8

Struct tArchiveOperationResult
    Boolean bSuccess
    Integer iErrorCode
    String sErrorMessage
    Integer iEntryCount
    Integer iPathComponentCount
    BigInt biArchiveBytes
    BigInt biCentralDirectoryBytes
    BigInt biDeclaredUncompressedBytes
    BigInt biExtractedBytes
End_Struct

// Metadata read directly from the ZIP records before libarchive is opened.
// This bounds the seekable reader's central-directory allocation.
Struct tZipDirectoryMetadata
    Boolean bSuccess
    Integer iErrorCode
    String sErrorMessage
    Integer iEntryCount
    BigInt biArchiveBytes
    BigInt biCentralDirectoryBytes
    BigInt biDeclaredUncompressedBytes
End_Struct

// Internal representation returned after validating one archive header.
Struct tZipEntryInfo
    Boolean bSuccess
    Integer iErrorCode
    String sErrorMessage
    String sPath
    Boolean bDirectory
    Integer iPathComponentCount
    BigInt biDeclaredSize
End_Struct

// Windows API used by DataToFile (names are prefixed to avoid clashes with other declarations).
External_Function ArchiveReaderCreateFile "CreateFileW" kernel32.dll ;
    WString wsFileName ;
    UInteger iAccess ;
    UInteger iShareMode ;
    Pointer pSecurity ;
    UInteger iDisposition ;
    UInteger iFlags ;
    Handle hTemplate ;
    Returns Handle

External_Function ArchiveReaderWriteFile "WriteFile" kernel32.dll ;
    Handle hFile ;
    Pointer pBuffer ;
    UInteger iBytes ;
    Pointer pBytesWritten ;
    Pointer pOverlapped ;
    Returns Integer

External_Function ArchiveReaderSetFilePointer "SetFilePointerEx" kernel32.dll ;
    Handle hFile ;
    BigInt iDistance ;
    Pointer pNewPosition ;
    UInteger iMethod ;
    Returns Integer

External_Function ArchiveReaderCloseHandle "CloseHandle" kernel32.dll ;
    Handle hObject ;
    Returns Integer

// Number of characters (without the terminating zero) of a wide string; used by OpenFiles.
External_Function ArchiveReaderWideLength "lstrlenW" kernel32.dll ;
    Pointer pText ;
    Returns Integer

// ====================================================================================================
// cArchiveReaderBase
// ====================================================================================================

// Shared part of cArchiveReader and cArchiveDiskReader: the "current entry" object (phoEntry), header iteration and
// reading of the entry data. Use one of the subclasses.
Class cArchiveReaderBase is a cArchiveBase
    Procedure Construct_Object
        Forward Send Construct_Object

        // The cArchiveEntry object that wraps the entry NextHeader returned. It borrows the entry: libarchive owns
        // it and it is only valid until the next header is read or the handle is freed.
        { DesignTime = False }
        Property Handle phoEntry 0

        Object oEntry is a cArchiveEntry
        End_Object
        Set phoEntry to (oEntry (Self))
    End_Procedure

    // ---- helpers ------------------------------------------------------------------------------------------------

    // Stores a failure that does not come from libarchive and reports it through OnError. Returns iResult.
    { Visibility = Private }
    Function ReportFailure Integer iResult String sOperation String sErrorText Returns Integer
        Set piLastResult to iResult
        Set psLastError to sErrorText
        Send OnError iResult sOperation sErrorText
        Function_Return iResult
    End_Function

    // Returns the libarchive handle. Without a handle the failure is reported (OnError) and 0 is returned.
    { Visibility = Private }
    Function HandleFor String sOperation Returns Pointer
        Pointer pArchive
        Integer iResult

        Get ppArchive to pArchive
        If (pArchive = 0) Begin
            Get ReportFailure ARCHIVE_FATAL sOperation "there is no libarchive handle, create or open one first" to iResult
        End
        Function_Return pArchive
    End_Function

    // Forgets the current entry (the entry belongs to the handle and is invalid after the handle is freed).
    { Visibility = Private }
    Procedure DetachEntry
        Handle hoEntry
        Get phoEntry to hoEntry
        Get Object_Id of hoEntry to hoEntry
        If (hoEntry <> 0) Begin
            Send AttachEntry of hoEntry 0 False
        End
    End_Procedure

    Procedure FreeHandle
        Send DetachEntry
        Forward Send FreeHandle
    End_Procedure

    // ---- iteration ----------------------------------------------------------------------------------------------

    // Reads the next entry header (archive_read_next_header). Returns ARCHIVE_OK (or ARCHIVE_WARN) when there is an
    // entry, ARCHIVE_EOF at the end. The entry is available through phoEntry until the next call. The data of the
    // previous entry that was not read is skipped.
    Function NextHeader Returns Integer
        Pointer pArchive pEntry
        Integer iResult
        Handle hoEntry

        Get HandleFor "archive_read_next_header" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Get phoEntry to hoEntry
        Move 0 to pEntry
        Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
        If (iResult = ARCHIVE_OK or iResult = ARCHIVE_WARN) Begin
            Send AttachEntry of hoEntry pEntry False
        End
        Else Begin
            Send AttachEntry of hoEntry 0 False
        End
        Function_Return (CheckResult (Self, iResult, "archive_read_next_header"))
    End_Function

    // Summary of the current entry (empty struct when there is none).
    Function EntryInfo Returns tArchiveEntryInfo
        tArchiveEntryInfo tInfo
        Pointer pEntry
        String sPathname
        BigInt iSize iMtime
        Integer eFileType iPerm iEncrypted
        Handle hoEntry

        Get phoEntry to hoEntry
        Get ppEntry of hoEntry to pEntry
        If (pEntry = 0) Begin
            Function_Return tInfo
        End
        Get psPathname of hoEntry to sPathname
        Move (archive_entry_size (pEntry)) to iSize
        Move (archive_entry_mtime (pEntry)) to iMtime
        Move (archive_entry_filetype (pEntry)) to eFileType
        Move (archive_entry_perm (pEntry)) to iPerm
        Move (archive_entry_is_encrypted (pEntry)) to iEncrypted
        Move sPathname to tInfo.sPathname
        Move iSize to tInfo.iSize
        Move iMtime to tInfo.iMtime
        Move eFileType to tInfo.eFileType
        Move iPerm to tInfo.iPerm
        Move (iEncrypted = 1) to tInfo.bEncrypted
        Function_Return tInfo
    End_Function

    // ---- entry data ---------------------------------------------------------------------------------------------

    // Reads up to iMaxBytes bytes of the current entry (archive_read_data). The array is empty at the end of the entry
    // and when the read failed (see piLastResult; with pbRaiseErrors an error is raised).
    Function ReadData Integer iMaxBytes Returns UChar[]
        Pointer pArchive
        BigInt iRead
        Integer iResult
        UChar[] ucBuffer ucEmpty

        Get HandleFor "archive_read_data" to pArchive
        If (pArchive = 0 or iMaxBytes <= 0) Begin
            Function_Return ucEmpty
        End
        Move (ResizeArray (ucBuffer, iMaxBytes)) to ucBuffer
        Move (archive_read_data (pArchive, AddressOf (ucBuffer), iMaxBytes)) to iRead
        If (iRead <= 0) Begin
            If (iRead < 0) Begin
                Get CheckResult iRead "archive_read_data" to iResult
            End
            Function_Return ucEmpty
        End
        If (iRead <> iMaxBytes) Begin
            Move (ResizeArray (ucBuffer, iRead)) to ucBuffer
        End
        Function_Return ucBuffer
    End_Function

    // Reads all remaining data of the current entry into ucData (replacing its content). Returns ARCHIVE_OK or the
    // failing result (ucData then holds what was read before the failure).
    Function ReadAllData UChar[] ByRef ucData Returns Integer
        Pointer pArchive pTarget pEntry
        BigInt iCapacity iUsed iRead
        Integer iResult
        UChar[] ucWork ucEmpty
        Boolean bMore

        Move ucEmpty to ucData
        Get HandleFor "archive_read_data" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        // Size the buffer from the entry when its size is known (+1 so the final read returns 0 without growing).
        Move 65536 to iCapacity
        Get ppEntry of (phoEntry (Self)) to pEntry
        If (pEntry <> 0) Begin
            If (archive_entry_size_is_set (pEntry) = 1) Begin
                Move (archive_entry_size (pEntry) + 1) to iCapacity
                // the size comes from the archive: never allocate more than 64 MB up front, the buffer grows while reading
                If (iCapacity > 67108864) Begin
                    Move 67108864 to iCapacity
                End
            End
        End
        Move (ResizeArray (ucWork, iCapacity)) to ucWork
        Move 0 to iUsed
        Move ARCHIVE_OK to iResult
        Move True to bMore
        While (bMore)
            If (iUsed >= iCapacity) Begin
                Move (iCapacity * 2) to iCapacity
                Move (ResizeArray (ucWork, iCapacity)) to ucWork
            End
            Move (AddressOf (ucWork) + iUsed) to pTarget
            Move (archive_read_data (pArchive, pTarget, (iCapacity - iUsed))) to iRead
            If (iRead > 0) Begin
                Move (iUsed + iRead) to iUsed
            End
            Else Begin
                Move False to bMore
                If (iRead < 0) Begin
                    Move iRead to iResult
                End
            End
        Loop
        If (iUsed > 0) Begin
            Move (ResizeArray (ucWork, iUsed)) to ucData
        End
        If (iResult <> ARCHIVE_OK) Begin
            Get CheckResult iResult "archive_read_data" to iResult
        End
        Function_Return iResult
    End_Function

    // Reads all remaining data of the current entry as a (binary safe) string. Empty on failure.
    Function ReadDataToString Returns String
        UChar[] ucData
        Integer iResult iBytes
        String sData

        Get ReadAllData (&ucData) to iResult
        Move (SizeOfArray (ucData)) to iBytes
        If (iBytes = 0) Begin
            Function_Return ""
        End
        Move (Repeat (Character (0), iBytes)) to sData
        Move (CopyMemory (AddressOf (sData), AddressOf (ucData), iBytes)) to iResult
        Function_Return sData
    End_Function

    // Reads the next data block of the current entry (archive_read_data_block). iOffset receives the offset of the
    // block within the entry data (blocks of sparse files do not start at the end of the previous block) and ucData the
    // block bytes. Returns ARCHIVE_OK, ARCHIVE_EOF at the end of the entry or a failure.
    Function ReadDataBlock BigInt ByRef iOffset UChar[] ByRef ucData Returns Integer
        Pointer pArchive pBlock
        BigInt iBlockSize iBlockOffset
        Integer iResult iCopied
        UChar[] ucEmpty

        Move ucEmpty to ucData
        Move 0 to iOffset
        Get HandleFor "archive_read_data_block" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move 0 to pBlock
        Move 0 to iBlockSize
        Move 0 to iBlockOffset
        Move (archive_read_data_block (pArchive, AddressOf (pBlock), AddressOf (iBlockSize), AddressOf (iBlockOffset))) to iResult
        If (iResult = ARCHIVE_OK or iResult = ARCHIVE_WARN) Begin
            Move iBlockOffset to iOffset
            If (iBlockSize > 0 and pBlock <> 0) Begin
                Move (ResizeArray (ucData, iBlockSize)) to ucData
                Move (CopyMemory (AddressOf (ucData), pBlock, iBlockSize)) to iCopied
            End
        End
        Function_Return (CheckResult (Self, iResult, "archive_read_data_block"))
    End_Function

    // Writes the remaining data of the current entry to a file (created or truncated; the name is a wide string so
    // Unicode names work). Uses archive_read_data_block and the Windows file API, holes of sparse entries are skipped
    // with a file pointer move. Returns ARCHIVE_OK or the failing result (ARCHIVE_FAILED when the file cannot be created).
    Function DataToFile String sFileName Returns Integer
        Pointer pArchive pBlock
        BigInt iBlockSize iBlockOffset iPosition
        Integer iResult iWritten iOk
        Handle hFile
        WString wsFileName
        Boolean bMore

        Get HandleFor "DataToFile" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move sFileName to wsFileName
        // GENERIC_WRITE, FILE_SHARE_READ, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL
        Move (ArchiveReaderCreateFile (wsFileName, 1073741824, 1, 0, 2, 128, 0)) to hFile
        If (hFile = -1) Begin
            Send SetError 0 ("Cannot create the file" * sFileName)
            Function_Return (CheckResult (Self, ARCHIVE_FAILED, "DataToFile"))
        End
        Move 0 to pBlock
        Move 0 to iBlockSize
        Move 0 to iBlockOffset
        Move 0 to iPosition
        Move 0 to iWritten
        Move ARCHIVE_OK to iResult
        Move True to bMore
        While (bMore)
            Move (archive_read_data_block (pArchive, AddressOf (pBlock), AddressOf (iBlockSize), AddressOf (iBlockOffset))) to iResult
            If (iResult = ARCHIVE_EOF) Begin
                Move ARCHIVE_OK to iResult
                Move False to bMore
            End
            Else If (iResult < ARCHIVE_WARN) Begin
                Move False to bMore
            End
            Else Begin
                Move ARCHIVE_OK to iResult
                If (iBlockOffset <> iPosition) Begin
                    Move (ArchiveReaderSetFilePointer (hFile, iBlockOffset, 0, 0)) to iOk
                End
                If (iBlockSize > 0) Begin
                    Move (ArchiveReaderWriteFile (hFile, pBlock, iBlockSize, AddressOf (iWritten), 0)) to iOk
                    If (iOk = 0 or iWritten <> iBlockSize) Begin
                        Send SetError 0 ("Cannot write to the file" * sFileName)
                        Move ARCHIVE_FAILED to iResult
                        Move False to bMore
                    End
                End
                Move (iBlockOffset + iBlockSize) to iPosition
            End
        Loop
        Move (ArchiveReaderCloseHandle (hFile)) to iOk
        If (iResult <> ARCHIVE_OK) Begin
            Get CheckResult iResult "DataToFile" to iResult
        End
        Function_Return iResult
    End_Function
End_Class

// ====================================================================================================
// cArchiveReader
// ====================================================================================================

// Reads archives with libarchive (archive_read_new / archive_read_open_* / archive_read_next_header / archive_read_data).
//
// Typical use:
//     Send CreateReaderAll                       // handle with all formats and filters enabled
//     Get OpenFile "C:\data\backup.zip" 0 to iResult
//     Get NextHeader to iResult
//     While (iResult = ARCHIVE_OK)
//         Get psPathname of (phoEntry (Self)) to sName
//         Get ReadAllData (&ucData) to iResult   // data of the current entry
//         Get NextHeader to iResult
//     Loop
//     Send FreeReader
//
// Enable the formats and filters BEFORE opening (CreateReaderAll, SupportFormat*, SupportFilter*). The convenience
// methods ListEntries, ExtractAll and ReadEntryData do everything in one call. All methods follow the conventions of
// cArchiveBase (result codes, pbRaiseErrors). Callback based functions of libarchive are not exposed (see the top of
// this file).
Class cArchiveReader is a cArchiveReaderBase
    Procedure Construct_Object
        Forward Send Construct_Object

        // Passphrase the convenience methods (OpenArchive, ListEntries, ExtractAll, ReadEntryData) add before they open
        // the archive. Use AddPassphrase when you open the archive yourself.
        Property String psPassphrase ""

        // Number of entries ExtractAll extracted with ARCHIVE_OK.
        { DesignTime = False }
        Property Integer piExtractedCount 0

        // True after SupportFormatRar5 / SupportFormatAll (libarchive 3.7.7 crashes when rar5 is registered twice).
        { DesignTime = False }
        Property Boolean pbRar5Registered False
        { DesignTime = False }
        Property Boolean pbAllRegistered False
        // True once an Open* method was called on the handle. libarchive can only open a handle once (a second open, also
        // after a failed one, corrupts the heap in 3.7.7), so the Open* methods refuse until CreateReader is called.
        { DesignTime = False }
        Property Boolean pbOpenCalled False

        // True: before opening, "hdrcharset=UTF-8" is set for the format readers that know the option (zip, tar, ...).
        // Default False: with the option libarchive 3.7.7 reports ARCHIVE_WARN for every non ASCII entry name and
        // returns no name for it (psPathname is empty, the entry cannot be extracted), because it tries to convert the
        // name to the locale of the process ("C" locale in DataFlex programs). Without the option names are returned
        // as UTF-8 correctly. ARCHIVE_WARN is never raised as an error by the wrapper.
        Property Boolean pbUtf8HeaderCharset False

        // The copy of the archive bytes OpenMemory made (libarchive reads from it until the archive is closed) and its size.
        { DesignTime = False }
        Property Pointer ppMemory 0
        { DesignTime = False }
        Property Integer piMemorySize 0
        Property BigInt piMaxEntryUncompressedBytes C_ARCHIVE_DEFAULT_MAX_ENTRY_BYTES
        Property BigInt piMaxTotalUncompressedBytes C_ARCHIVE_DEFAULT_MAX_TOTAL_BYTES
        Property BigInt piMaxArchiveBytes C_ARCHIVE_DEFAULT_MAX_ARCHIVE_BYTES
        Property Integer piMaxCentralDirectoryBytes C_ARCHIVE_DEFAULT_MAX_CENTRAL_DIRECTORY_BYTES
        Property Integer piMaxEntries C_ARCHIVE_DEFAULT_MAX_ENTRIES
        Property Integer piMaxPathLength C_ARCHIVE_DEFAULT_MAX_PATH_LENGTH
        Property Integer piMaxPathComponents C_ARCHIVE_DEFAULT_MAX_PATH_COMPONENTS
        Property Integer piReadBlockSize C_ARCHIVE_DEFAULT_READ_BLOCK_SIZE
        // Strict EOF validation remains the safe default. Callers that control
        // archive creation may opt into accepting only zero-filled writer block
        // padding after an otherwise complete ZIP end record.
        Property Boolean pbAllowTrailingZeroPadding False
    End_Procedure

    // ---- create and free ----------------------------------------------------------------------------------------

    // Frees the previous handle and creates a new reader handle (archive_read_new). No formats or filters are enabled yet.
    Procedure CreateReader
        Pointer pArchive

        Send FreeHandle
        Move (archive_read_new ()) to pArchive
        Set ppArchive to pArchive
        Set pbRar5Registered to False
        Set pbAllRegistered to False
        Set pbOpenCalled to False
        Send ClearLastResult
        If (pArchive = 0) Begin
            Error DFERR_PROGRAM "archive_read_new failed (out of memory)"
        End
    End_Procedure

    // CreateReader followed by SupportFormatAll and SupportFilterAll: reads every archive type libarchive knows
    // except the raw format.
    Procedure CreateReaderAll
        Integer iResult

        Send CreateReader
        If (HasHandle (Self)) Begin
            Get SupportFormatAll to iResult
            Get SupportFilterAll to iResult
        End
    End_Procedure

    // Closes the archive (archive_read_close) but keeps the handle, for example to read the error text. FreeReader
    // (and Destroy) close it implicitly.
    Procedure CloseReader
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_close" to pArchive
        If (pArchive <> 0) Begin
            Move (archive_read_close (pArchive)) to iResult
            Get CheckResult iResult "archive_read_close" to iResult
        End
    End_Procedure

    // Like HandleFor, but also reports a failure when the handle was already used to open an archive.
    { Visibility = Private }
    Function HandleForOpen String sOperation Returns Pointer
        Pointer pArchive
        Integer iResult

        Get HandleFor sOperation to pArchive
        If (pArchive <> 0 and pbOpenCalled (Self)) Begin
            Get ReportFailure ARCHIVE_FATAL sOperation "the handle was already used to open an archive, call CreateReader first" to iResult
            Function_Return 0
        End
        Function_Return pArchive
    End_Function

    // Frees the memory copy made by OpenMemory.
    { Visibility = Private }
    Procedure ReleaseMemory
        Pointer pMemory
        Integer iVoid

        Get ppMemory to pMemory
        If (pMemory <> 0) Begin
            Move (Free (pMemory)) to iVoid
        End
        Set ppMemory to 0
        Set piMemorySize to 0
    End_Procedure

    // Closes and frees the handle (archive_read_free), then the memory copy of OpenMemory.
    Procedure FreeHandle
        Forward Send FreeHandle
        Send ReleaseMemory
    End_Procedure

    // Same as FreeHandle: closes and frees the handle (archive_read_free).
    Procedure FreeReader
        Send FreeHandle
    End_Procedure

    // ---- format support (call before opening) -------------------------------------------------------------------

    // Enables reading of 7-Zip archives (archive_read_support_format_7zip). Needs a seekable source (file or memory).
    Function SupportFormat7zip Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_7zip" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_7zip (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_7zip"))
    End_Function

    // Enables reading of ar archives (archive_read_support_format_ar).
    Function SupportFormatAr Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_ar" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_ar (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_ar"))
    End_Function

    // Enables reading of Microsoft CAB archives (archive_read_support_format_cab).
    Function SupportFormatCab Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_cab" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_cab (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_cab"))
    End_Function

    // Enables reading of cpio archives, all variants (archive_read_support_format_cpio).
    Function SupportFormatCpio Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_cpio" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_cpio (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_cpio"))
    End_Function

    // Enables reading of empty (zero byte) archives; they report no entries instead of an error (archive_read_support_format_empty).
    Function SupportFormatEmpty Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_empty" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_empty (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_empty"))
    End_Function

    // Enables reading of GNU tar archives and the tar variants it can detect (archive_read_support_format_gnutar).
    Function SupportFormatGnutar Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_gnutar" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_gnutar (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_gnutar"))
    End_Function

    // Enables reading of ISO 9660 images including Rock Ridge and Joliet (archive_read_support_format_iso9660).
    Function SupportFormatIso9660 Returns Integer
        Pointer pArchive
        Integer iResult

        Get HandleFor "archive_read_support_format_iso9660" to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_read_support_format_iso9660 (pArchive)) to iResult
        Function_Return (CheckResult (Self, iResult, "archive_read_support_format_iso9660"))
    End_Function

