    Pointer pArchive ;
    Pointer pModule ;
    Pointer pOption ;
    Pointer pValue ;
    Returns Integer

/* Sets an option for both the format and the filter. pModule can be 0 to match any module. */
/* Note: An unknown option returns ARCHIVE_FAILED (not ARCHIVE_WARN). */
External_Function archive_read_set_option "archive_read_set_option" archive.dll ;
    Pointer pArchive ;
    Pointer pModule ;
    Pointer pOption ;
    Pointer pValue ;
    Returns Integer

/* Sets options from a string like "module:option=value,option2" for both the format and the filter. */
/* Note: An unknown option returns ARCHIVE_FAILED (not ARCHIVE_WARN). */
External_Function archive_read_set_options "archive_read_set_options" archive.dll ;
    Pointer pArchive ;
    Pointer pOptions ;
    Returns Integer

