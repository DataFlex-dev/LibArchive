    Pointer pArchive ;
    Pointer pModule ;
    Pointer pOption ;
    Pointer pValue ;
    Returns Integer

/* Sets an option for the filter only. pModule can be 0 to match any module. */
/* Note: An unknown option returns ARCHIVE_FAILED (not ARCHIVE_WARN). */
