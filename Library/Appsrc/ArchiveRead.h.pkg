    Pointer pArchive ;
    Pointer pClientData ;
    Pointer pCallback ;
    Returns Integer

// ====================================================================================================
// Extract
// ====================================================================================================

/* Extracts the current entry (header and data) to disk. iFlags is a combination of ARCHIVE_EXTRACT_* values. */
External_Function archive_read_extract "archive_read_extract" archive.dll ;
    Pointer pArchive ;
    Pointer pEntry ;
    Integer iFlags ;
    Returns Integer

/* Extracts the current entry through the given archive_write_disk handle. */
External_Function archive_read_extract2 "archive_read_extract2" archive.dll ;
    Pointer pArchive ;
    Pointer pEntry ;
    Pointer pDestArchive ;
    Returns Integer

/* Sets a progress callback (void (*)(void*)) for extraction. Needs a native function pointer. */
External_Function archive_read_extract_set_progress_callback "archive_read_extract_set_progress_callback" archive.dll ;
    Pointer pArchive ;
    Pointer pProgressFunc ;
    Pointer pUserData ;
    Returns Void_Type

/* Records the device and inode of a file that must not be overwritten (normally the archive being read). */
/*
Note: Has no effect on Windows: an entry with the registered device and inode is extracted anyway
(archive_read_extract returns ARCHIVE_WARN only for the archive being read).
*/
External_Function archive_read_extract_set_skip_file "archive_read_extract_set_skip_file" archive.dll ;
    Pointer pArchive ;
    BigInt iDevice ;
    BigInt iInode ;
    Returns Void_Type

