// ====================================================================================================
// stat and platform data
// ====================================================================================================

/* Pointer to a C runtime struct stat filled from the entry. Owned by the entry. */
/* Note: The structure is a C runtime struct _stat64i32 (size is a 32 bit value at offset 20). */
External_Function archive_entry_stat "archive_entry_stat" archive.dll ;
    Pointer pEntry ;
    Returns Pointer

/* Copies the fields from a C runtime struct stat into the entry. */
External_Function archive_entry_copy_stat "archive_entry_copy_stat" archive.dll ;
    Pointer pEntry ;
    Pointer pStat ;
    Returns Void_Type

/* Windows only: copies the fields from a BY_HANDLE_FILE_INFORMATION structure into the entry. */
/* Note: Copies times, size, inode and link count; it does not set the file type or the permissions. */
External_Function archive_entry_copy_bhfi "archive_entry_copy_bhfi" archive.dll ;
    Pointer pEntry ;
    Pointer pFileInfo ;
    Returns Void_Type

/* Pointer to the Mac OS AppleDouble metadata blob; the size_t variable pointed to by pSize receives its size. */
External_Function archive_entry_mac_metadata "archive_entry_mac_metadata" archive.dll ;
    Pointer pEntry ;
    Pointer pSize ;
    Returns Pointer

/* Stores a Mac OS AppleDouble metadata blob in the entry. */
External_Function archive_entry_copy_mac_metadata "archive_entry_copy_mac_metadata" archive.dll ;
    Pointer pEntry ;
    Pointer pData ;
    Longptr iSize ;
    Returns Void_Type

/*
Pointer to the raw digest bytes (ARCHIVE_ENTRY_DIGEST_*) when the format provides one, otherwise 0. The length
depends on the type (MD5 16, SHA1 20, SHA256 32, ...).
*/
/*
Note: For a known type the function never returns 0: when the entry has no digest it returns a pointer to
zero-filled bytes. Only an unknown type returns 0.
*/
External_Function archive_entry_digest "archive_entry_digest" archive.dll ;
    Pointer pEntry ;
    Integer iDigestType ;
    Returns Pointer

// ====================================================================================================
// ACL
// ====================================================================================================

/* Pointer to the opaque ACL object of the entry. There is nothing a client can do with it. */
External_Function archive_entry_acl "archive_entry_acl" archive.dll ;
    Pointer pEntry ;
    Returns Pointer

/* Removes all ACL entries. */
External_Function archive_entry_acl_clear "archive_entry_acl_clear" archive.dll ;
    Pointer pEntry ;
    Returns Void_Type

/* Adds an ACL entry. Type is ARCHIVE_ENTRY_ACL_TYPE_*, tag ARCHIVE_ENTRY_ACL_USER etc. */
External_Function archive_entry_acl_add_entry "archive_entry_acl_add_entry" archive.dll ;
    Pointer pEntry ;
    Integer iType ;
    Integer iPermset ;
    Integer iTag ;
    Integer iQualifier ;
    Pointer pName ;
    Returns Integer

/* Wide string variant of archive_entry_acl_add_entry. */
/*
Note: pName must not be NULL (an empty WString passes NULL with AddressOf): libarchive crashes in wcslen. Pass
any non-empty text for entries without a name.
*/
External_Function archive_entry_acl_add_entry_w "archive_entry_acl_add_entry_w" archive.dll ;
    Pointer pEntry ;
    Integer iType ;
    Integer iPermset ;
    Integer iTag ;
    Integer iQualifier ;
    Pointer pName ;
    Returns Integer

/* Starts an enumeration of the ACL entries of the wanted types (returns the number of entries). */
External_Function archive_entry_acl_reset "archive_entry_acl_reset" archive.dll ;
    Pointer pEntry ;
    Integer iWantType ;
    Returns Integer

/*
Returns the next ACL entry in the Integer variables pointed to (name as char pointer). Returns ARCHIVE_EOF at
the end.
*/
/* Note: The returned user/group name is in the ANSI code page. */
External_Function archive_entry_acl_next "archive_entry_acl_next" archive.dll ;
    Pointer pEntry ;
    Integer iWantType ;
    Pointer pType ;
    Pointer pPermset ;
    Pointer pTag ;
    Pointer pQualifier ;
    Pointer ppName ;
    Returns Integer

/* Number of ACL entries of the wanted types. */
External_Function archive_entry_acl_count "archive_entry_acl_count" archive.dll ;
    Pointer pEntry ;
    Integer iWantType ;
    Returns Integer

/* Bit mask of the ARCHIVE_ENTRY_ACL_TYPE_* values present in the entry. */
External_Function archive_entry_acl_types "archive_entry_acl_types" archive.dll ;
    Pointer pEntry ;
    Returns Integer

/*
Pointer to a newly allocated text form of the ACL (ARCHIVE_ENTRY_ACL_STYLE_* flags). The length (la_ssize_t)
is stored when pLength is not 0. The memory is owned by the entry.
*/
/*
Note: The returned text is allocated with malloc and must be freed by the caller (free from ucrtbase.dll); it
is not owned by the entry.
*/
External_Function archive_entry_acl_to_text "archive_entry_acl_to_text" archive.dll ;
    Pointer pEntry ;
    Pointer pLength ;
    Integer iFlags ;
    Returns Pointer

/* Wide string variant of archive_entry_acl_to_text. */
/*
Note: The returned text is allocated with malloc and must be freed by the caller (free from ucrtbase.dll); it
is not owned by the entry.
*/
External_Function archive_entry_acl_to_text_w "archive_entry_acl_to_text_w" archive.dll ;
    Pointer pEntry ;
    Pointer pLength ;
    Integer iFlags ;
    Returns Pointer

/* Sets the ACL from text, replacing entries of that type. */
/*
Note: The parsed entries are added to the existing ACL; they do not replace it (call archive_entry_acl_clear
first to replace).
*/
External_Function archive_entry_acl_from_text "archive_entry_acl_from_text" archive.dll ;
    Pointer pEntry ;
    Pointer pText ;
    Integer iType ;
    Returns Integer

/* Wide string variant of archive_entry_acl_from_text. */
/*
Note: The parsed entries are added to the existing ACL; they do not replace it (call archive_entry_acl_clear
first to replace).
*/
External_Function archive_entry_acl_from_text_w "archive_entry_acl_from_text_w" archive.dll ;
    Pointer pEntry ;
    Pointer pText ;
    Integer iType ;
    Returns Integer

/* Deprecated; use archive_entry_acl_to_text. */
External_Function archive_entry_acl_text "archive_entry_acl_text" archive.dll ;
    Pointer pEntry ;
    Integer iFlags ;
    Returns Pointer

/* Deprecated; use archive_entry_acl_to_text_w. */
External_Function archive_entry_acl_text_w "archive_entry_acl_text_w" archive.dll ;
    Pointer pEntry ;
    Integer iFlags ;
    Returns Pointer

