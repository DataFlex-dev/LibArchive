Note: A result of 0 means the text could not be converted to the locale without loss; libarchive keeps the
text anyway. Prefer this function over archive_entry_set_pathname_utf8: the 7zip writer garbles non-ASCII
names set with the set_ variant.
*/
External_Function archive_entry_update_pathname_utf8 "archive_entry_update_pathname_utf8" archive.dll ;
    Pointer pEntry ;
    Pointer pPathName ;
    Returns Integer

