External_Function archive_entry_sparse_next "archive_entry_sparse_next" archive.dll ;
    Pointer pEntry ;
    Pointer pOffset ;
    Pointer pLength ;
    Returns Integer

// ====================================================================================================
// Hard link resolver
// ====================================================================================================

/* Allocates a hard link resolver. Free it with archive_entry_linkresolver_free. */
External_Function archive_entry_linkresolver_new "archive_entry_linkresolver_new" archive.dll ;
    Returns Pointer

/* Selects the hard link strategy that matches the archive format (ARCHIVE_FORMAT_*). */
External_Function archive_entry_linkresolver_set_strategy "archive_entry_linkresolver_set_strategy" archive.dll ;
    Pointer pResolver ;
    Integer iFormatCode ;
    Returns Void_Type

/* Frees the hard link resolver. */
/*
Note: libarchive 3.7.7 frees entries that are still deferred (SVR4 cpio strategy) twice: call
archive_entry_linkify with a zero entry until no more entries are returned before freeing the resolver.
*/
External_Function archive_entry_linkresolver_free "archive_entry_linkresolver_free" archive.dll ;
    Pointer pResolver ;
    Returns Void_Type

/*
Filters an entry through the resolver; ppEntry and ppSparseEntry point to entry pointer variables that receive
the entries to write (0, 1 or 2). Call with a zero entry to flush.
*/
External_Function archive_entry_linkify "archive_entry_linkify" archive.dll ;
    Pointer pResolver ;
    Pointer ppEntry ;
    Pointer ppSparseEntry ;
    Returns Void_Type

/*
Returns the entries of files whose links were not all seen; the link count (unsigned 32 bit) is stored in the
variable pointed to. Returns 0 when done.
*/
External_Function archive_entry_partial_links "archive_entry_partial_links" archive.dll ;
    Pointer pResolver ;
    Pointer pLinks ;
    Returns Pointer

