    // Adds an external program as filter. The program reads the archive data from its standard input and writes the filtered data to its standard output (archive_write_add_filter_program).
    Function AddFilterProgram String sCommand Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_add_filter_program (pArchive, AddressOf (sCommand))) to iResult
        Get CheckResult iResult "archive_write_add_filter_program" to iResult
        Function_Return iResult
    End_Function

    // ---- options and encryption --------------------------------------------------------------------------------
    // sModule is the name of the format or filter the option is for ("zip", "7zip", "gzip", ...). An empty sModule
    // matches any module. An empty sValue passes NULL, which switches a boolean option off. The functions return
    // ARCHIVE_OK, or ARCHIVE_FAILED when the option is unknown or its value is invalid (libarchive documents
    // ARCHIVE_WARN for options no module handles; archive.dll 3.7.7 answered ARCHIVE_FAILED in every case tested).

    // Sets an option of the format and of the filters (archive_write_set_option). Examples: SetOption "zip" "encryption" "aes256",
    // SetOption "gzip" "compression-level" "9", SetOption "zip" "compression" "store".
    Function SetOption String sModule String sOption String sValue Returns Integer
        Pointer pArchive pModule pValue
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (sModule <> "") Begin
            Move (AddressOf (sModule)) to pModule
        End
        If (sValue <> "") Begin
            Move (AddressOf (sValue)) to pValue
        End
        Move (archive_write_set_option (pArchive, pModule, AddressOf (sOption), pValue)) to iResult
        Get CheckResult iResult "archive_write_set_option" to iResult
        Function_Return iResult
    End_Function

    // Sets an option of the format only (archive_write_set_format_option).
    Function SetFormatOption String sModule String sOption String sValue Returns Integer
        Pointer pArchive pModule pValue
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (sModule <> "") Begin
            Move (AddressOf (sModule)) to pModule
        End
        If (sValue <> "") Begin
            Move (AddressOf (sValue)) to pValue
        End
        Move (archive_write_set_format_option (pArchive, pModule, AddressOf (sOption), pValue)) to iResult
        Get CheckResult iResult "archive_write_set_format_option" to iResult
        Function_Return iResult
    End_Function

    // Sets an option of the filters only (archive_write_set_filter_option).
    Function SetFilterOption String sModule String sOption String sValue Returns Integer
        Pointer pArchive pModule pValue
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (sModule <> "") Begin
            Move (AddressOf (sModule)) to pModule
        End
        If (sValue <> "") Begin
            Move (AddressOf (sValue)) to pValue
        End
        Move (archive_write_set_filter_option (pArchive, pModule, AddressOf (sOption), pValue)) to iResult
        Get CheckResult iResult "archive_write_set_filter_option" to iResult
        Function_Return iResult
    End_Function

    // Sets several options from a string "module:option=value,option2,!option3" (archive_write_set_options).
    Function SetOptions String sOptions Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_set_options (pArchive, AddressOf (sOptions))) to iResult
        Get CheckResult iResult "archive_write_set_options" to iResult
        Function_Return iResult
    End_Function

    // Sets the passphrase for encryption (archive_write_set_passphrase). Select the encryption with
    // SetOption "zip" "encryption" "zipcrypt" / "aes128" / "aes256" (zip) or the 7zip equivalent; without such an option
    // the passphrase is not used. There is no passphrase callback (see the class description).
    Function SetPassphrase String sPassphrase Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_set_passphrase (pArchive, AddressOf (sPassphrase))) to iResult
        Get CheckResult iResult "archive_write_set_passphrase" to iResult
        Function_Return iResult
    End_Function

    // ---- open -------------------------------------------------------------------------------------------------
    // Format and filters must be set before the archive is opened. Open the archive exactly once per writer.

    // Creates the archive file (archive_write_open_filename_w). The name may contain any Unicode character.
    Function OpenFile String sFileName Returns Integer
        Pointer pArchive
        Integer iResult
        WString wsFileName

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move sFileName to wsFileName
        Move (archive_write_open_filename_w (pArchive, AddressOf (wsFileName))) to iResult
        Get CheckResult iResult "archive_write_open_filename_w" to iResult
        Function_Return iResult
    End_Function

    // Writes the archive into a memory buffer of iBufferSize bytes (archive_write_open_memory); writing fails with
    // ARCHIVE_FATAL when the archive gets larger. The buffer is native memory (Alloc) owned by this object, so the size
    // of libarchive's size_t counter is not limited by DataFlex array handling. After CloseWriter the archive is
    // available through OutputBytes / GetOutput, also after FreeWriter. Choose the buffer larger than the data plus
    // the overhead of the format (tar pads to blocks of 10240 bytes by default).
    Function OpenMemory Integer iBufferSize Returns Integer
        Pointer pArchive pBuffer pUsed
        Integer iResult iVoid
        BigInt iUsed
        UChar[] ucEmpty

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Get ppMemoryBuffer to pBuffer
        If (pBuffer <> 0) Begin
            Get Fail "OpenMemory" "OpenMemory was already called for this writer. Send CreateWriter for a new archive." to iResult
            Function_Return iResult
        End
        If (iBufferSize <= 0) Begin
            Get Fail "OpenMemory" "The buffer size must be greater than 0." to iResult
            Function_Return iResult
        End
        Move (Alloc (iBufferSize)) to pBuffer
        Move (Alloc (8)) to pUsed
        Set ppMemoryBuffer to pBuffer
        Set ppMemoryUsed to pUsed
        If (pBuffer = 0 or pUsed = 0) Begin
            Send ReleaseMemory
            Get Fail "OpenMemory" "Not enough memory for the output buffer." to iResult
            Function_Return iResult
        End
        Move 0 to iUsed
        Move (MemCopy (pUsed, AddressOf (iUsed), 8)) to iVoid
        Move (archive_write_open_memory (pArchive, pBuffer, iBufferSize, pUsed)) to iResult
        If (iResult <= ARCHIVE_FAILED) Begin
            Send ReleaseMemory
            Get CheckResult iResult "archive_write_open_memory" to iResult
            Function_Return iResult
        End
        Set pucOutput to ucEmpty
        Function_Return iResult
    End_Function

    // Writes the archive to an open C runtime file descriptor (archive_write_open_fd). The caller keeps the descriptor
    // open and closes it after FreeWriter.
    Function OpenFd Integer iFileDescriptor Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_open_fd (pArchive, iFileDescriptor)) to iResult
        Get CheckResult iResult "archive_write_open_fd" to iResult
        Function_Return iResult
    End_Function

    // Writes the archive to an open C runtime FILE pointer of the same C runtime as archive.dll (archive_write_open_FILE).
    // The caller keeps the file open and closes it after FreeWriter.
    Function OpenFilePtr Pointer pFile Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_open_FILE_Ptr (pArchive, pFile)) to iResult
        Get CheckResult iResult "archive_write_open_FILE" to iResult
        Function_Return iResult
    End_Function

    // ---- output of OpenMemory ------------------------------------------------------------------------------------

    // Copies the bytes libarchive wrote into the OpenMemory buffer to pucOutput.
    { Visibility = Private }
    Procedure CaptureOutput
        Pointer pBuffer pUsed
        BigInt iUsed
        Integer iVoid
        UChar[] ucOutput

        Get ppMemoryBuffer to pBuffer
        If (pBuffer = 0) Begin
            Procedure_Return
        End
        Get ppMemoryUsed to pUsed
        Move (MemCopy (AddressOf (iUsed), pUsed, 8)) to iVoid
        Move (ResizeArray (ucOutput, iUsed)) to ucOutput
        If (iUsed > 0) Begin
            Move (MemCopy (AddressOf (ucOutput), pBuffer, iUsed)) to iVoid
        End
        Set pucOutput to ucOutput
    End_Procedure

    { Visibility = Private }
    Procedure ReleaseMemory
        Pointer pBuffer pUsed
        Integer iVoid

        Get ppMemoryBuffer to pBuffer
        Get ppMemoryUsed to pUsed
        If (pBuffer <> 0) Begin
            Move (Free (pBuffer)) to iVoid
        End
        If (pUsed <> 0) Begin
            Move (Free (pUsed)) to iVoid
        End
        Set ppMemoryBuffer to 0
        Set ppMemoryUsed to 0
    End_Procedure

    // The bytes written so far to the memory buffer of OpenMemory; after FreeWriter the final archive. Send CloseWriter
    // before to get the complete archive. Empty when OpenMemory was not used.
    Function OutputBytes Returns UChar[]
        UChar[] ucOutput

        Send CaptureOutput
        Get pucOutput to ucOutput
        Function_Return ucOutput
    End_Function

    // Like OutputBytes: ucOutput receives the bytes, the result is their number.
    Function GetOutput UChar[] ByRef ucOutput Returns BigInt
        Get OutputBytes to ucOutput
        Function_Return (SizeOfArray (ucOutput))
    End_Function

    // Number of bytes in the OpenMemory output (the size_t counter of archive_write_open_memory).
    Function OutputSize Returns BigInt
        UChar[] ucOutput

        Send CaptureOutput
        Get pucOutput to ucOutput
        Function_Return (SizeOfArray (ucOutput))
    End_Function

    // ---- entries and data ---------------------------------------------------------------------------------------

    // Writes the header of an entry (archive_write_header). hoEntry is a cArchiveEntry object with the entry
    // data (path name, type, size, time stamps, ...). Write the data of the entry afterwards with WriteData,
    // WriteString or WriteDataPointer. The entry is not freed or changed.
    Function WriteHeader Handle hoEntry Returns Integer
        Pointer pEntry
        Integer iResult

        Get ppEntry of hoEntry to pEntry
        If (pEntry = 0) Begin
            Get Fail "WriteHeader" "The entry object has no entry (use CreateEntry first)." to iResult
            Function_Return iResult
        End
        Get WriteHeaderPointer pEntry to iResult
        Function_Return iResult
    End_Function

    // Writes the header of a raw libarchive entry (archive_write_header).
    Function WriteHeaderPointer Pointer pEntry Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (pEntry = 0) Begin
            Get Fail "WriteHeader" "The entry is 0." to iResult
            Function_Return iResult
        End
        Move (archive_write_header (pArchive, pEntry)) to iResult
        Get CheckResult iResult "archive_write_header" to iResult
        Function_Return iResult
    End_Function

    // Raises the error of a failed write: a negative count is the error code, a smaller count than requested is
    // reported as ARCHIVE_FATAL. Returns the count.
    { Visibility = Private }
    Function CheckWritten BigInt iWritten BigInt iRequested String sOperation Returns BigInt
        Integer iResult

        If (iWritten < 0) Begin
            Move (iWritten min ARCHIVE_FAILED) to iResult
            Get CheckResult iResult sOperation to iResult
        End
        Else If (iWritten <> iRequested) Begin
            Get Fail sOperation "Not all bytes could be written." to iResult
        End
        Function_Return iWritten
    End_Function

    // Writes the data of the current entry (archive_write_data). Returns the number of bytes written (a negative number
    // is an error code). libarchive does not write more than the size in the header.
    Function WriteData UChar[] ucData Returns BigInt
        Pointer pArchive
        BigInt iWritten iSize

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (SizeOfArray (ucData)) to iSize
        If (iSize = 0) Begin
            Function_Return 0
        End
        Move (archive_write_data (pArchive, AddressOf (ucData), iSize)) to iWritten
        Get CheckWritten iWritten iSize "archive_write_data" to iWritten
        Function_Return iWritten
    End_Function

    // Writes the bytes of a string as data of the current entry (archive_write_data). A DataFlex string is UTF-8 encoded,
    // the number of bytes is SizeOfString (sData). Returns the number of bytes written.
    Function WriteString String sData Returns BigInt
        Pointer pArchive
        BigInt iWritten iSize

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (SizeOfString (sData)) to iSize
        If (iSize = 0) Begin
            Function_Return 0
        End
        Move (archive_write_data (pArchive, AddressOf (sData), iSize)) to iWritten
        Get CheckWritten iWritten iSize "archive_write_data" to iWritten
        Function_Return iWritten
    End_Function

    // Writes iSize bytes at pData as data of the current entry (archive_write_data). Returns the number of bytes written.
    Function WriteDataPointer Pointer pData BigInt iSize Returns BigInt
        Pointer pArchive
        BigInt iWritten

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        If (iSize <= 0) Begin
            Function_Return 0
        End
        Move (archive_write_data (pArchive, pData, iSize)) to iWritten
        Get CheckWritten iWritten iSize "archive_write_data" to iWritten
        Function_Return iWritten
    End_Function

    // Finishes the current entry: pads the data when it is shorter than the size in the header (archive_write_finish_entry).
    // It is done automatically by the next WriteHeader and by CloseWriter.
    Function FinishEntry Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_finish_entry (pArchive)) to iResult
        Get CheckResult iResult "archive_write_finish_entry" to iResult
        Function_Return iResult
    End_Function

    // ---- convenience methods ------------------------------------------------------------------------------------

    // Remembers a failure of the wrapper itself (not of libarchive) like CheckResult does and returns ARCHIVE_FAILED.
    { Visibility = Private }
    Function Fail String sOperation String sErrorText Returns Integer
        Set piLastResult to ARCHIVE_FAILED
        Set psLastError to sErrorText
        Send OnError ARCHIVE_FAILED sOperation sErrorText
        Function_Return ARCHIVE_FAILED
    End_Function

    // Current time as seconds since 1970-01-01 UTC (see cArchivePath.CurrentUnixTime).
    { Visibility = Private }
    Function CurrentUnixTime Returns BigInt
        Handle hoPathTools
        BigInt biCurrentUnixTime

        Get PathTools to hoPathTools
        Get CurrentUnixTime of hoPathTools to biCurrentUnixTime
        Function_Return biCurrentUnixTime
    End_Function

    // Size and last write time of a file (a symbolic link is followed). Returns False when there is no such regular file.
    { Visibility = Private }
    Function ReadFileInfo String sFileName BigInt ByRef iSize BigInt ByRef iMTime Integer ByRef iMTimeNano Returns Boolean
        Handle hoPathTools
        UShort eFileType
        Boolean bOk

        Get PathTools to hoPathTools
        Get ReadDiskFileInfo of hoPathTools sFileName True (&eFileType) (&iSize) (&iMTime) (&iMTimeNano) to bOk
        Function_Return (bOk and eFileType = AE_IFREG)
    End_Function

    // Archive path names use "/" as separator.
    { Visibility = Private }
    Function ArchivePath String sPath Returns String
        Function_Return (Replace ("\", sPath, "/"))
    End_Function

    // Creates an entry, writes its header and frees it. eFileType is AE_IFREG, AE_IFDIR or AE_IFLNK, sSymlinkTarget
    // is only used for AE_IFLNK.
    { Visibility = Private }
    Function WriteEntryHeader String sArchivePath Integer eFileType BigInt iSize BigInt iMTime Integer iMTimeNano Integer iPermission String sSymlinkTarget Returns Integer
        Pointer pEntry
        Integer iResult iOk
        Void_Type iVoid

        Get ArchivePath sArchivePath to sArchivePath
        If (sArchivePath = "") Begin
            Get Fail "WriteHeader" "The archive path name is empty." to iResult
            Function_Return iResult
        End
        Move (archive_entry_new ()) to pEntry
        // archive_entry_set_pathname_utf8 is not used: the 7zip writer then writes a wrong name. The result of the update
        // function is 0 for names that cannot be converted to the ANSI code page of the system (Japanese on a Western
        // system); the entry keeps the name (UTF-8 and UTF-16) nevertheless, so it is not an error.
        Move (archive_entry_update_pathname_utf8 (pEntry, AddressOf (sArchivePath))) to iOk
        Move (archive_entry_set_filetype (pEntry, eFileType)) to iVoid
        Move (archive_entry_set_perm (pEntry, iPermission)) to iVoid
        Move (archive_entry_set_size (pEntry, iSize)) to iVoid
        Move (archive_entry_set_mtime (pEntry, iMTime, iMTimeNano)) to iVoid
        If (eFileType = AE_IFLNK) Begin
            Move (archive_entry_set_symlink_utf8 (pEntry, AddressOf (sSymlinkTarget))) to iVoid
        End
        Get WriteHeaderPointer pEntry to iResult
        Move (archive_entry_free (pEntry)) to iVoid
        Function_Return iResult
    End_Function

    // Writes a complete regular file entry with the data at pData (time stamp: now).
    { Visibility = Private }
    Function AddBytes String sArchivePath Pointer pData BigInt iSize Returns Integer
        Integer iResult iPermission
        BigInt iWritten iMTime

        Get piFilePermission to iPermission
        Get CurrentUnixTime to iMTime
        Get WriteEntryHeader sArchivePath AE_IFREG iSize iMTime 0 iPermission "" to iResult
        If (iResult < ARCHIVE_WARN) Begin
            Function_Return iResult
        End
        If (iSize > 0) Begin
            Get WriteDataPointer pData iSize to iWritten
            If (iWritten <> iSize) Begin
                Get piLastResult to iResult
                If (iResult > ARCHIVE_FAILED) Begin
                    Move ARCHIVE_FATAL to iResult
                End
                Function_Return iResult
            End
        End
        Get FinishEntry to iResult
        Function_Return iResult
    End_Function

    // Adds a file with the bytes of ucData (regular file, permission piFilePermission, time stamp now).
    Function AddData String sArchivePath UChar[] ucData Returns Integer
        Integer iResult
        Pointer pData
        BigInt iSize

        Move (SizeOfArray (ucData)) to iSize
        If (iSize > 0) Begin
            Move (AddressOf (ucData)) to pData
        End
        Get AddBytes sArchivePath pData iSize to iResult
        Function_Return iResult
    End_Function

    // Adds a file with the text sText as UTF-8 (regular file, permission piFilePermission, time stamp now).
    Function AddText String sArchivePath String sText Returns Integer
        Integer iResult
        Pointer pData
        BigInt iSize

        Move (SizeOfString (sText)) to iSize
        If (iSize > 0) Begin
            Move (AddressOf (sText)) to pData
        End
        Get AddBytes sArchivePath pData iSize to iResult
        Function_Return iResult
    End_Function

    // Adds a directory entry (permission piDirectoryPermission, time stamp now). A trailing "/" is added when missing.
    Function AddDirectory String sArchivePath Returns Integer
        Integer iResult iPermission
        BigInt iMTime

        Get ArchivePath sArchivePath to sArchivePath
        If (sArchivePath <> "" and Right (sArchivePath, 1) <> "/") Begin
            Move (sArchivePath + "/") to sArchivePath
        End
        Get piDirectoryPermission to iPermission
        Get CurrentUnixTime to iMTime
        Get WriteEntryHeader sArchivePath AE_IFDIR 0 iMTime 0 iPermission "" to iResult
        Function_Return iResult
    End_Function

    // Adds a symbolic link entry that points to sTarget (permission 0777, time stamp now). The target is stored as given.
    Function AddSymlink String sArchivePath String sTarget Returns Integer
        Integer iResult
        BigInt iMTime

        Get CurrentUnixTime to iMTime
        Get WriteEntryHeader sArchivePath AE_IFLNK 0 iMTime 0 ARCHIVE_READ_WRITE_EXECUTE_FOR_ALL sTarget to iResult
        Function_Return iResult
    End_Function

    // Adds a file from disk: the header gets the size and the last write time of the file, the permission
    // piFilePermission and type regular file; the content is read in chunks of 1 MB. An empty sArchivePathName uses
    // the file name without path.
    Function AddFile String sDiskFileName String sArchivePathName Returns Integer
        Handle hoPathTools
        String sNativePath
        Pointer pArchive
        Integer iResult iPermission iNano iChannel iRead
        Boolean bOk
        BigInt iSize iMTime iTotal iWritten
        UChar[] ucBuffer

        Get PathTools to hoPathTools
        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Get ReadFileInfo sDiskFileName (&iSize) (&iMTime) (&iNano) to bOk
        If (not (bOk)) Begin
            Get Fail "AddFile" ("The file does not exist:" * sDiskFileName) to iResult
            Function_Return iResult
        End
        If (sArchivePathName = "") Begin
            Get NativePath of hoPathTools sDiskFileName to sNativePath
            Get FileNamePart of hoPathTools sNativePath to sArchivePathName
        End
        Move (Seq_New_Channel ()) to iChannel
        If (iChannel = DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
            Get Fail "AddFile" "No free sequential channel." to iResult
            Function_Return iResult
        End
        Move 0 to iTotal
        Get piFilePermission to iPermission
        Get WriteEntryHeader sArchivePathName AE_IFREG iSize iMTime iNano iPermission "" to iResult
        If (iResult >= ARCHIVE_WARN and iSize > 0) Begin
            Direct_Input channel iChannel ("BINARY:" + sDiskFileName)
            While (not (SeqEof) and iResult > ARCHIVE_FAILED)
                Read_Block channel iChannel ucBuffer 1048576
                Move (SizeOfArray (ucBuffer)) to iRead
                If (iRead > 0) Begin
                    Get WriteDataPointer (AddressOf (ucBuffer)) iRead to iWritten
                    If (iWritten <> iRead) Begin
                        Get piLastResult to iResult
                        If (iResult > ARCHIVE_FAILED) Begin
                            Move ARCHIVE_FATAL to iResult
                        End
                    End
                    Move (iTotal + iWritten) to iTotal
                End
            Loop
            Close_Input channel iChannel
            If (iResult > ARCHIVE_FAILED and iTotal <> iSize) Begin
                Get Fail "AddFile" ("The size of the file changed while it was read:" * sDiskFileName) to iResult
            End
        End
        Send Seq_Release_Channel iChannel
        If (iResult >= ARCHIVE_WARN) Begin
            Get FinishEntry to iResult
        End
        Function_Return iResult
    End_Function

    // Adds the content of a folder recursively: a directory entry for every sub folder and a file entry (AddFile) for
    // every file. The path names are sPrefix + "/" + the path relative to sFolder; with an empty sPrefix the content
    // of sFolder is added at the top level of the archive. When sPrefix is not empty a directory entry for it is added
    // first. Directory symbolic links and junctions are not followed. Stops at the first failure and returns its result.
    Function AddFolderTree String sFolder String sPrefix Returns Integer
        Handle hoPathTools
        Pointer pArchive
        Integer iResult
        String sSeparator

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move ARCHIVE_OK to iResult
        Move (SysConf (SYSCONF_DIR_SEPARATOR)) to sSeparator
        Get PathTools to hoPathTools
        Get NativePath of hoPathTools sFolder to sFolder
        If (Right (sFolder, 1) <> sSeparator) Begin
            Move (sFolder + sSeparator) to sFolder
        End
        Get ArchivePath sPrefix to sPrefix
        If (Right (sPrefix, 1) = "/") Begin
            Move (Left (sPrefix, Length (sPrefix) - 1)) to sPrefix
        End
        If (sPrefix <> "") Begin
            Get AddDirectory sPrefix to iResult
        End
        If (iResult >= ARCHIVE_WARN) Begin
            Get AddFolderContent sFolder sPrefix to iResult
        End
        Function_Return iResult
    End_Function

    // sFolder ends with the native path separator, sPrefix has no trailing "/".
    { Visibility = Private }
    Function AddFolderContent String sFolder String sPrefix Returns Integer
        Handle hoPathTools
        Integer iResult iIndex iCount
        Boolean bListed
        String sName sArchiveName sSeparator
        String[] asNames
        Boolean[] abFolders

        Move ARCHIVE_OK to iResult
        Move (SysConf (SYSCONF_DIR_SEPARATOR)) to sSeparator
        // The complete listing is read before the recursion starts (cArchivePath.ListFolderContent), so only one channel is in use at a time.
        // Directory symbolic links and junctions are not in the list.
        Get PathTools to hoPathTools
        Get ListFolderContent of hoPathTools sFolder (&asNames) (&abFolders) to bListed

        Move (SizeOfArray (asNames)) to iCount
        For iIndex from 0 to (iCount - 1)
            If (iResult < ARCHIVE_WARN) Begin
                Function_Return iResult
            End
            Move asNames[iIndex] to sName
            If (sPrefix <> "") Begin
                Move (sPrefix + "/" + sName) to sArchiveName
            End
            Else Begin
                Move sName to sArchiveName
            End
            If (abFolders[iIndex]) Begin
                Get AddDirectory sArchiveName to iResult
                If (iResult >= ARCHIVE_WARN) Begin
                    Get AddFolderContent (sFolder + sName + sSeparator) sArchiveName to iResult
                End
            End
            Else Begin
                Get AddFile (sFolder + sName) sArchiveName to iResult
            End
        Loop
        Function_Return iResult
    End_Function

    // One call helper: creates the archive sArchiveFile with the files and folders in sFiles and frees the writer.
    // eFormat is an ARCHIVE_FORMAT_* code (for example ARCHIVE_FORMAT_ZIP), eFilter an ARCHIVE_FILTER_* code
    // (ARCHIVE_FILTER_NONE for no compression filter; zip and 7zip compress on their own). A file in sFiles is stored
    // under its file name, a folder with its content (AddFolderTree) under the folder name. Returns ARCHIVE_OK or the
    // first failing result; the writer of this object is replaced by the one of the call and is freed at the end.
    Function CreateArchive String sArchiveFile String[] sFiles Integer eFormat Integer eFilter Returns Integer
        Handle hoPathTools
        Boolean bIsFolder
        Integer iResult iIndex iCount
        String sFile sFolderName sSeparator

        Get PathTools to hoPathTools
        Send CreateWriter
        Get SetFormat eFormat to iResult
        If (iResult > ARCHIVE_FAILED and eFilter <> ARCHIVE_FILTER_NONE) Begin
            Get AddFilter eFilter to iResult
        End
        If (iResult > ARCHIVE_FAILED) Begin
            Get OpenFile sArchiveFile to iResult
        End
        If (iResult > ARCHIVE_FAILED) Begin
            Move (SizeOfArray (sFiles)) to iCount
            For iIndex from 0 to (iCount - 1)
                Move (Trim (sFiles[iIndex])) to sFile
                Get IsFolder of hoPathTools sFile to bIsFolder
                If bIsFolder Begin
                    Move (SysConf (SYSCONF_DIR_SEPARATOR)) to sSeparator
                    Get NativePath of hoPathTools sFile to sFolderName
                    If (Right (sFolderName, 1) = sSeparator) Begin
                        Move (Left (sFolderName, Length (sFolderName) - 1)) to sFolderName
                    End
                    Get FileNamePart of hoPathTools sFolderName to sFolderName
                    Get AddFolderTree sFile sFolderName to iResult
                End
                Else Begin
                    Get AddFile sFile "" to iResult
                End
                If (iResult <= ARCHIVE_FAILED) Begin
                    Move iCount to iIndex // stop
                End
            Loop
        End
        If (iResult > ARCHIVE_FAILED) Begin
            Get CloseWriter to iResult
        End
        // After a failure the writer is freed without FailWriter: libarchive closes the output file in that case, a failed
        // archive would keep the file open until the process ends. The partial archive stays on disk.
        Send FreeWriter
        Function_Return iResult
    End_Function
End_Class
