Use cArchiveBase.pkg
Use cArchiveEntry.pkg
Use seq_chnl.pkg
Use ArchivePath.pkg

// Constants of the zip writer compression (peZipCompression).
Define ARCHIVE_ZIP_COMPRESSION_DEFLATE for 0
Define ARCHIVE_ZIP_COMPRESSION_STORE   for 1

// Wrapper around the archive writer of libarchive (archive_write_*): creates archives in a file, in memory, on a
// file descriptor or on a C runtime FILE pointer. All archive_write_* functions are available except
//  - the callback based ones: archive_write_open, archive_write_open2 and archive_write_set_passphrase_callback. DataFlex
//    cannot create native callback function pointers, so they are not exposed. Use OpenFile, OpenMemory, OpenFd
//    or OpenFilePtr instead and SetPassphrase for encryption;
//  - the deprecated synonyms archive_write_finish, archive_write_open_file and archive_write_set_compression_*
//    (use FreeWriter, OpenFile and the AddFilter... methods);
//  - the archive_write_disk_* functions, which belong to cArchiveDiskWriter.
//
// Typical use:
//   Send CreateWriter
//   Get SetFormatZip to iResult
//   Get OpenFile "C:\Temp\test.zip" to iResult
//   Get AddText "readme.txt" "Hello" to iResult
//   Get AddFile "C:\Temp\data.bin" "data/data.bin" to iResult
//   Get CloseWriter to iResult
//   Send FreeWriter
//
// Every method returns the libarchive result (ARCHIVE_OK, ...) unless it is documented otherwise; failures are
// reported as described in cArchiveBase (pbRaiseErrors, OnError). Archive path names are UTF-8 and use "/" as
// separator; "\" in the path names given to the Add... methods is converted to "/".
//
// Names with characters outside of the ANSI code page of the system (for example Japanese on a Western system) and
// even the euro sign: libarchive corrupts its heap for such names in a zip archive unless the option hdrcharset=UTF-8
// is set. With pbUtf8HeaderCharset True (default) the class sets it whenever a format is chosen. pax and 7zip store
// Unicode names anyway; readers of ustar, gnutar and cpio archives have to use hdrcharset=UTF-8 as well.
Class cArchiveWriter is a cArchiveBase
    Procedure Construct_Object
        Forward Send Construct_Object

        // Permission bits (octal 0644 = 420) of the files and (octal 0755 = 493) directories the Add... methods create.
        Property Integer piFilePermission 420
        Property Integer piDirectoryPermission 493

        // True: names are written as UTF-8 (option hdrcharset=UTF-8 is set whenever a format is chosen). Set it to False
        // before choosing the format to keep the character set handling of libarchive (the ANSI code page).
        Property Boolean pbUtf8HeaderCharset True

        // The bytes of the archive that was written with OpenMemory (see OutputBytes).
        { DesignTime = False }
        Property UChar[] pucOutput

        { DesignTime = False }
        Property Integer piZipCompressionValue ARCHIVE_ZIP_COMPRESSION_DEFLATE

        // Native memory of OpenMemory: the output buffer and the size_t counter libarchive updates.
        { DesignTime = False }
        Property Pointer ppMemoryBuffer 0
        { DesignTime = False }
        Property Pointer ppMemoryUsed 0
    End_Procedure

    // ---- handle -----------------------------------------------------------------------------------------------

    // Releases the archive (archive_write_free, which closes the archive when needed). The bytes written with
    // OpenMemory are copied to pucOutput first, so OutputBytes still works afterwards.
    Procedure FreeHandle
        Forward Send FreeHandle
        Send CaptureOutput
        Send ReleaseMemory
    End_Procedure

    // Returns the archive handle. Raises an error and returns 0 when there is none (CreateWriter was not sent).
    Function RequireHandle Returns Pointer
        Pointer pArchive

        Get ppArchive to pArchive
        If (pArchive = 0) Begin
            Error DFERR_PROGRAM "There is no archive writer. Send CreateWriter first."
        End
        Function_Return pArchive
    End_Function

    // Creates a new archive writer (archive_write_new). An existing writer is freed first.
    Procedure CreateWriter
        Pointer pArchive
        UChar[] ucEmpty

        Send FreeHandle
        Set pucOutput to ucEmpty
        Set piZipCompressionValue to ARCHIVE_ZIP_COMPRESSION_DEFLATE
        Move (archive_write_new ()) to pArchive
        If (pArchive = 0) Begin
            Error DFERR_PROGRAM "archive_write_new failed (out of memory)"
        End
        Set ppArchive to pArchive
        Send ClearLastResult
    End_Procedure

    // Closes the archive when needed and frees the writer (archive_write_free). Safe to call without a writer.
    Procedure FreeWriter
        Send FreeHandle
    End_Procedure

    // Finishes the archive: writes the trailer and flushes and closes the output (archive_write_close).
    // The writer must still be freed (FreeWriter).
    Function CloseWriter Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_close (pArchive)) to iResult
        Get CheckResult iResult "archive_write_close" to iResult
        Function_Return iResult
    End_Function

    // Marks the archive as failed so that FreeWriter does not try to finish it cleanly (archive_write_fail).
    // Use it to abandon a partial archive. Returns ARCHIVE_FATAL (archive_write_fail itself returns the internal
    // state value of the dead archive, which is not a result code).
    Function FailWriter Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_fail (pArchive)) to iResult
        Function_Return ARCHIVE_FATAL
    End_Function

    // ---- properties of the writer ------------------------------------------------------------------------------

    // Block size of the output (archive_write_get_bytes_per_block / archive_write_set_bytes_per_block). Set it
    // before the archive is opened. 0 without a writer.
    { MethodType = Property }
    Function piBytesPerBlock Returns Integer
        Pointer pArchive

        Get ppArchive to pArchive
        If (pArchive = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_write_get_bytes_per_block (pArchive))
    End_Function

    { MethodType = Property }
    Procedure Set piBytesPerBlock Integer iBytesPerBlock
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive <> 0) Begin
            Move (archive_write_set_bytes_per_block (pArchive, iBytesPerBlock)) to iResult
            Get CheckResult iResult "archive_write_set_bytes_per_block" to iResult
        End
    End_Procedure

    // Size the last block is padded to (archive_write_get_bytes_in_last_block / archive_write_set_bytes_in_last_block).
    // 1 disables the padding. Set it before the archive is opened. 0 without a writer.
    { MethodType = Property }
    Function piBytesInLastBlock Returns Integer
        Pointer pArchive

        Get ppArchive to pArchive
        If (pArchive = 0) Begin
            Function_Return 0
        End
        Function_Return (archive_write_get_bytes_in_last_block (pArchive))
    End_Function

    { MethodType = Property }
    Procedure Set piBytesInLastBlock Integer iBytesInLastBlock
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive <> 0) Begin
            Move (archive_write_set_bytes_in_last_block (pArchive, iBytesInLastBlock)) to iResult
            Get CheckResult iResult "archive_write_set_bytes_in_last_block" to iResult
        End
    End_Procedure

    // Compression method of the zip writer: ARCHIVE_ZIP_COMPRESSION_DEFLATE (default) or
    // ARCHIVE_ZIP_COMPRESSION_STORE (archive_write_zip_set_compression_deflate / _store). The zip format must be
    // selected (SetFormatZip) before it is set. Without a writer the value is only remembered.
    { MethodType = Property }
    Function peZipCompression Returns Integer
        Integer iZipCompressionValue

        Get piZipCompressionValue to iZipCompressionValue
        Function_Return iZipCompressionValue
    End_Function

    { MethodType = Property }
    Procedure Set peZipCompression Integer eCompression
        Integer iResult

        If (eCompression = ARCHIVE_ZIP_COMPRESSION_STORE) Begin
            Get SetZipCompressionStore to iResult
        End
        Else Begin
            Get SetZipCompressionDeflate to iResult
        End
    End_Procedure

    // Entries of the zip writer are compressed with deflate (archive_write_zip_set_compression_deflate).
    Function SetZipCompressionDeflate Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_zip_set_compression_deflate (pArchive)) to iResult
        Get CheckResult iResult "archive_write_zip_set_compression_deflate" to iResult
        If (iResult >= ARCHIVE_OK) Begin
            Set piZipCompressionValue to ARCHIVE_ZIP_COMPRESSION_DEFLATE
        End
        Function_Return iResult
    End_Function

    // Entries of the zip writer are stored without compression (archive_write_zip_set_compression_store).
    Function SetZipCompressionStore Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_zip_set_compression_store (pArchive)) to iResult
        Get CheckResult iResult "archive_write_zip_set_compression_store" to iResult
        If (iResult >= ARCHIVE_OK) Begin
            Set piZipCompressionValue to ARCHIVE_ZIP_COMPRESSION_STORE
        End
        Function_Return iResult
    End_Function

    // Device and inode of a file that must not be archived, normally the archive itself (archive_write_set_skip_file).
    Function SetSkipFile BigInt iDevice BigInt iInode Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_set_skip_file (pArchive, iDevice, iInode)) to iResult
        Get CheckResult iResult "archive_write_set_skip_file" to iResult
        Function_Return iResult
    End_Function

    // ---- format -----------------------------------------------------------------------------------------------
    // Select the format before the archive is opened. One format per archive.

    // Header character set: without the option hdrcharset=UTF-8 the zip writer converts names to the ANSI code page
    // of the system and corrupts the heap of archive.dll for names with characters outside of it (Japanese or the
    // euro sign on a Western system), cpio refuses such names and tar formats lose them. When pbUtf8HeaderCharset is
    // True (default) the option is set for every format right after the format is chosen. Formats that do not know
    // the option (7zip, ar, iso9660, ...) answer with a failure that is ignored. SetOption "" "hdrcharset" ... overrides it.
    { Visibility = Private }
    Procedure ApplyFormatDefaults
        Boolean bUtf8HeaderCharset
        Pointer pArchive
        Integer iResult
        String sOption sValue

        Get ppArchive to pArchive
        Get pbUtf8HeaderCharset to bUtf8HeaderCharset
        If (pArchive = 0 or not (bUtf8HeaderCharset)) Begin
            Procedure_Return
        End
        Move "hdrcharset" to sOption
        Move "UTF-8" to sValue
        Move (archive_write_set_format_option (pArchive, 0, AddressOf (sOption), AddressOf (sValue))) to iResult
    End_Procedure

    // Sets the format by code, one of the ARCHIVE_FORMAT_* constants (for example ARCHIVE_FORMAT_ZIP, ARCHIVE_FORMAT_TAR_USTAR, ARCHIVE_FORMAT_7ZIP) (archive_write_set_format).
    Function SetFormat Integer eFormatCode Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_set_format (pArchive, eFormatCode)) to iResult
        Get CheckResult iResult "archive_write_set_format" to iResult
        Send ApplyFormatDefaults
        Function_Return iResult
    End_Function

    // Sets the format by name ("zip", "7zip", "pax", "ustar", "gnutar", "cpio", "iso9660", "raw", ...) (archive_write_set_format_by_name).
    Function SetFormatByName String sName Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_set_format_by_name (pArchive, AddressOf (sName))) to iResult
        Get CheckResult iResult "archive_write_set_format_by_name" to iResult
        Send ApplyFormatDefaults
        Function_Return iResult
    End_Function

    // Selects format and compression filter from the extension of a file name (.zip, .7z, .tar, .tar.gz, .tar.bz2, .tar.xz, .tar.zst, ...). Returns ARCHIVE_FATAL when the extension is not known (archive_write_set_format_filter_by_ext).
    Function SetFormatFilterByExtension String sFileName Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_set_format_filter_by_ext (pArchive, AddressOf (sFileName))) to iResult
        Get CheckResult iResult "archive_write_set_format_filter_by_ext" to iResult
        Send ApplyFormatDefaults
        Function_Return iResult
    End_Function

    // Like SetFormatFilterByExtension, but uses the extension sDefaultExt (for example ".tar.gz") when sFileName has no known extension (archive_write_set_format_filter_by_ext_def).
    Function SetFormatFilterByExtensionDefault String sFileName String sDefaultExt Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_set_format_filter_by_ext_def (pArchive, AddressOf (sFileName), AddressOf (sDefaultExt))) to iResult
        Get CheckResult iResult "archive_write_set_format_filter_by_ext_def" to iResult
        Send ApplyFormatDefaults
        Function_Return iResult
    End_Function

    // Sets the output format to 7-Zip (.7z) (archive_write_set_format_7zip).
    Function SetFormat7zip Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_set_format_7zip (pArchive)) to iResult
        Get CheckResult iResult "archive_write_set_format_7zip" to iResult
        Send ApplyFormatDefaults
        Function_Return iResult
    End_Function

