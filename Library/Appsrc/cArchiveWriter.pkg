    // ---- filters ----------------------------------------------------------------------------------------------
    // Filters are applied in the order they are added (add the compression last). Add them before the archive is opened.

    // Adds a filter by code, one of the ARCHIVE_FILTER_* constants (for example ARCHIVE_FILTER_GZIP) (archive_write_add_filter).
    Function AddFilter Integer eFilterCode Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_add_filter (pArchive, eFilterCode)) to iResult
        Get CheckResult iResult "archive_write_add_filter" to iResult
        Function_Return iResult
    End_Function

    // Adds a filter by name ("gzip", "bzip2", "xz", "zstd", "lz4", "lzma", "lzip", "compress", "uuencode", "b64encode", ...; "none" is not accepted, use AddFilterNone) (archive_write_add_filter_by_name).
    Function AddFilterByName String sName Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_add_filter_by_name (pArchive, AddressOf (sName))) to iResult
        Get CheckResult iResult "archive_write_add_filter_by_name" to iResult
        Function_Return iResult
    End_Function

    // Adds a base64 encoding filter (archive_write_add_filter_b64encode).
    Function AddFilterB64Encode Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_add_filter_b64encode (pArchive)) to iResult
        Get CheckResult iResult "archive_write_add_filter_b64encode" to iResult
        Function_Return iResult
    End_Function

    // Adds a bzip2 compression filter (archive_write_add_filter_bzip2).
    Function AddFilterBzip2 Returns Integer
        Pointer pArchive
        Integer iResult

        Get RequireHandle to pArchive
        If (pArchive = 0) Begin
            Function_Return ARCHIVE_FATAL
        End
        Move (archive_write_add_filter_bzip2 (pArchive)) to iResult
        Get CheckResult iResult "archive_write_add_filter_bzip2" to iResult
        Function_Return iResult
    End_Function

