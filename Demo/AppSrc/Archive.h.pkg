// The "flags" argument selects optional behavior, 'OR' the flags you want.
Define ARCHIVE_EXTRACT_OWNER                    for |CI$0001 // Default: Do not try to set owner/group.
Define ARCHIVE_EXTRACT_PERM                     for |CI$0002 // Default: Do obey umask, do not restore SUID/SGID/SVTX bits.
Define ARCHIVE_EXTRACT_TIME                     for |CI$0004 // Default: Do not restore mtime/atime.
Define ARCHIVE_EXTRACT_NO_OVERWRITE             for |CI$0008 // Default: Replace existing files.
Define ARCHIVE_EXTRACT_UNLINK                   for |CI$0010 // Default: Try create first, unlink only if create fails with EEXIST.
Define ARCHIVE_EXTRACT_ACL                      for |CI$0020 // Default: Do not restore ACLs.
Define ARCHIVE_EXTRACT_FFLAGS                   for |CI$0040 // Default: Do not restore fflags.
Define ARCHIVE_EXTRACT_XATTR                    for |CI$0080 // Default: Do not restore xattrs.
Define ARCHIVE_EXTRACT_SECURE_SYMLINKS          for |CI$0100 // Default: Do not try to guard against extracts redirected by symlinks. Note: With ARCHIVE_EXTRACT_UNLINK, will remove any intermediate symlink.
Define ARCHIVE_EXTRACT_SECURE_NODOTDOT          for |CI$0200 // Default: Do not reject entries with '..' as path elements.
Define ARCHIVE_EXTRACT_NO_AUTODIR               for |CI$0400 // Default: Create parent directories as needed.
Define ARCHIVE_EXTRACT_NO_OVERWRITE_NEWER       for |CI$0800 // Default: Overwrite files, even if one on disk is newer.
Define ARCHIVE_EXTRACT_SPARSE                   for |CI$1000 // Detect blocks of 0 and write holes instead.
Define ARCHIVE_EXTRACT_MAC_METADATA             for |CI$2000 // Default: Do not restore Mac extended metadata. This has no effect except on Mac OS.
Define ARCHIVE_EXTRACT_NO_HFS_COMPRESSION       for |CI$4000 // Default: Use HFS+ compression if it was compressed. This has no effect except on Mac OS v10.6 or later.
Define ARCHIVE_EXTRACT_HFS_COMPRESSION_FORCED   for |CI$8000 // Default: Do not use HFS+ compression if it was not compressed. This has no effect except on Mac OS v10.6 or later.
Define ARCHIVE_EXTRACT_SECURE_NOABSOLUTEPATHS   for |CI$10000 // Default: Do not reject entries with absolute paths
Define ARCHIVE_EXTRACT_CLEAR_NOCHANGE_FFLAGS    for |CI$20000 // Default: Do not clear no-change flags when unlinking object
Define ARCHIVE_EXTRACT_SAFE_WRITES              for |CI$40000 // Default: Do not extract atomically (using rename)

// Codes to identify various stream filters.
Define ARCHIVE_FILTER_NONE      for 0
Define ARCHIVE_FILTER_GZIP      for 1
Define ARCHIVE_FILTER_BZIP2     for 2
Define ARCHIVE_FILTER_COMPRESS  for 3
Define ARCHIVE_FILTER_PROGRAM   for 4
Define ARCHIVE_FILTER_LZMA      for 5
Define ARCHIVE_FILTER_XZ        for 6
Define ARCHIVE_FILTER_UU        for 7
Define ARCHIVE_FILTER_RPM       for 8
Define ARCHIVE_FILTER_LZIP      for 9
Define ARCHIVE_FILTER_LRZIP     for 10
Define ARCHIVE_FILTER_LZOP      for 11
Define ARCHIVE_FILTER_GRZIP     for 12
Define ARCHIVE_FILTER_LZ4       for 13
Define ARCHIVE_FILTER_ZSTD      for 14

/*
 * Codes returned by archive_format.
 *
 * Top 16 bits identifies the format family (e.g., "tar"); lower
 * 16 bits indicate the variant.  This is updated by read_next_header.
 * Note that the lower 16 bits will often vary from entry to entry.
 * In some cases, this variation occurs as libarchive learns more about
 * the archive (for example, later entries might utilize extensions that
 * weren't necessary earlier in the archive; in this case, libarchive
 * will change the format code to indicate the extended format that
 * was used).  In other cases, it's because different tools have
 * modified the archive and so different parts of the archive
 * actually have slightly different formats.  (Both tar and cpio store
 * format codes in each entry, so it is quite possible for each
 * entry to be in a different format.)
 */
Define ARCHIVE_FORMAT_BASE_MASK             for |CI$ff0000
Define ARCHIVE_FORMAT_CPIO                  for |CI$10000
Define ARCHIVE_FORMAT_CPIO_POSIX            for (ARCHIVE_FORMAT_CPIO ior 1)
Define ARCHIVE_FORMAT_CPIO_BIN_LE           for (ARCHIVE_FORMAT_CPIO ior 2)
Define ARCHIVE_FORMAT_CPIO_BIN_BE           for (ARCHIVE_FORMAT_CPIO ior 3)
Define ARCHIVE_FORMAT_CPIO_SVR4_NOCRC       for (ARCHIVE_FORMAT_CPIO ior 4)
Define ARCHIVE_FORMAT_CPIO_SVR4_CRC         for (ARCHIVE_FORMAT_CPIO ior 5)
Define ARCHIVE_FORMAT_CPIO_AFIO_LARGE       for (ARCHIVE_FORMAT_CPIO ior 6)
Define ARCHIVE_FORMAT_CPIO_PWB              for (ARCHIVE_FORMAT_CPIO ior 7)
Define ARCHIVE_FORMAT_SHAR                  for |CI$20000
Define ARCHIVE_FORMAT_SHAR_BASE             for (ARCHIVE_FORMAT_SHAR ior 1)
Define ARCHIVE_FORMAT_SHAR_DUMP             for (ARCHIVE_FORMAT_SHAR ior 2)
Define ARCHIVE_FORMAT_TAR                   for |CI$30000
Define ARCHIVE_FORMAT_TAR_USTAR             for (ARCHIVE_FORMAT_TAR ior 1)
Define ARCHIVE_FORMAT_TAR_PAX_INTERCHANGE   for (ARCHIVE_FORMAT_TAR ior 2)
Define ARCHIVE_FORMAT_TAR_PAX_RESTRICTED    for (ARCHIVE_FORMAT_TAR ior 3)
Define ARCHIVE_FORMAT_TAR_GNUTAR            for (ARCHIVE_FORMAT_TAR ior 4)
Define ARCHIVE_FORMAT_ISO9660               for |CI$40000
Define ARCHIVE_FORMAT_ISO9660_ROCKRIDGE     for (ARCHIVE_FORMAT_ISO9660 ior 1)
Define ARCHIVE_FORMAT_ZIP                   for |CI$50000
Define ARCHIVE_FORMAT_EMPTY                 for |CI$60000
Define ARCHIVE_FORMAT_AR                    for |CI$70000
Define ARCHIVE_FORMAT_AR_GNU                for (ARCHIVE_FORMAT_AR ior 1)
Define ARCHIVE_FORMAT_AR_BSD                for (ARCHIVE_FORMAT_AR ior 2)
Define ARCHIVE_FORMAT_MTREE                 for |CI$80000
Define ARCHIVE_FORMAT_RAW                   for |CI$90000
Define ARCHIVE_FORMAT_XAR                   for |CI$A0000
Define ARCHIVE_FORMAT_LHA                   for |CI$B0000
Define ARCHIVE_FORMAT_CAB                   for |CI$C0000
Define ARCHIVE_FORMAT_RAR                   for |CI$D0000
Define ARCHIVE_FORMAT_7ZIP                  for |CI$E0000
Define ARCHIVE_FORMAT_WARC                  for |CI$F0000
Define ARCHIVE_FORMAT_RAR_V5                for |CI$100000

// File types
Define AE_IFMT      for |CI$F000 // used to isolate the file type bits from a file mode value.
Define AE_IFREG     for |CI$8000 // Regular file
Define AE_IFLNK     for |CI$A000 // Symbolic link
Define AE_IFSOCK    for |CI$C000 // Socket
Define AE_IFCHR     for |CI$2000 // Character device
Define AE_IFBLK     for |CI$6000 // Block device
Define AE_IFDIR     for |CI$4000 // Directory
Define AE_IFIFO     for |CI$1000 // FIFO (named pipe)

// Permission bits.
Define ARCHIVE_ENTRY_ACL_EXECUTE            for |CI$00000001
Define ARCHIVE_ENTRY_ACL_WRITE              for |CI$00000002
Define ARCHIVE_ENTRY_ACL_READ               for |CI$00000004
Define ARCHIVE_ENTRY_ACL_READ_DATA          for |CI$00000008
Define ARCHIVE_ENTRY_ACL_LIST_DIRECTORY     for |CI$00000008
Define ARCHIVE_ENTRY_ACL_WRITE_DATA         for |CI$00000010
Define ARCHIVE_ENTRY_ACL_ADD_FILE           for |CI$00000010
Define ARCHIVE_ENTRY_ACL_APPEND_DATA        for |CI$00000020
Define ARCHIVE_ENTRY_ACL_ADD_SUBDIRECTORY   for |CI$00000020
Define ARCHIVE_ENTRY_ACL_READ_NAMED_ATTRS   for |CI$00000040
Define ARCHIVE_ENTRY_ACL_WRITE_NAMED_ATTRS  for |CI$00000080
Define ARCHIVE_ENTRY_ACL_DELETE_CHILD       for |CI$00000100
Define ARCHIVE_ENTRY_ACL_READ_ATTRIBUTES    for |CI$00000200
Define ARCHIVE_ENTRY_ACL_WRITE_ATTRIBUTES   for |CI$00000400
Define ARCHIVE_ENTRY_ACL_DELETE             for |CI$00000800
Define ARCHIVE_ENTRY_ACL_READ_ACL           for |CI$00001000
Define ARCHIVE_ENTRY_ACL_WRITE_ACL          for |CI$00002000
Define ARCHIVE_ENTRY_ACL_WRITE_OWNER        for |CI$00004000
Define ARCHIVE_ENTRY_ACL_SYNCHRONIZE        for |CI$00008000

Define ARCHIVE_ENTRY_ACL_PERMS_POSIX1E      for (ARCHIVE_ENTRY_ACL_EXECUTE ior ARCHIVE_ENTRY_ACL_WRITE ior ARCHIVE_ENTRY_ACL_READ)

Define ARCHIVE_ENTRY_ACL_PERMS_NFS4         for (ARCHIVE_ENTRY_ACL_EXECUTE ior ARCHIVE_ENTRY_ACL_READ_DATA ior ARCHIVE_ENTRY_ACL_LIST_DIRECTORY ior ARCHIVE_ENTRY_ACL_WRITE_DATA ior ARCHIVE_ENTRY_ACL_ADD_FILE ior ARCHIVE_ENTRY_ACL_APPEND_DATA ior ARCHIVE_ENTRY_ACL_ADD_SUBDIRECTORY ior ARCHIVE_ENTRY_ACL_READ_NAMED_ATTRS ior ARCHIVE_ENTRY_ACL_WRITE_NAMED_ATTRS ior ARCHIVE_ENTRY_ACL_DELETE_CHILD ior ARCHIVE_ENTRY_ACL_READ_ATTRIBUTES ior ARCHIVE_ENTRY_ACL_WRITE_ATTRIBUTES ior ARCHIVE_ENTRY_ACL_DELETE ior ARCHIVE_ENTRY_ACL_READ_ACL ior ARCHIVE_ENTRY_ACL_WRITE_ACL ior ARCHIVE_ENTRY_ACL_WRITE_OWNER ior ARCHIVE_ENTRY_ACL_SYNCHRONIZE)

// Inheritance values (NFS4 ACLs only); included in permset.
Define ARCHIVE_ENTRY_ACL_ENTRY_INHERITED                   for |CI$01000000
Define ARCHIVE_ENTRY_ACL_ENTRY_FILE_INHERIT                for |CI$02000000
Define ARCHIVE_ENTRY_ACL_ENTRY_DIRECTORY_INHERIT           for |CI$04000000
Define ARCHIVE_ENTRY_ACL_ENTRY_NO_PROPAGATE_INHERIT        for |CI$08000000
Define ARCHIVE_ENTRY_ACL_ENTRY_INHERIT_ONLY                for |CI$10000000
Define ARCHIVE_ENTRY_ACL_ENTRY_SUCCESSFUL_ACCESS           for |CI$20000000
Define ARCHIVE_ENTRY_ACL_ENTRY_FAILED_ACCESS               for |CI$40000000

Define ARCHIVE_ENTRY_ACL_INHERITANCE_NFS4 for (ARCHIVE_ENTRY_ACL_ENTRY_FILE_INHERIT ior ARCHIVE_ENTRY_ACL_ENTRY_DIRECTORY_INHERIT ior ARCHIVE_ENTRY_ACL_ENTRY_NO_PROPAGATE_INHERIT ior ARCHIVE_ENTRY_ACL_ENTRY_INHERIT_ONLY ior ARCHIVE_ENTRY_ACL_ENTRY_SUCCESSFUL_ACCESS ior ARCHIVE_ENTRY_ACL_ENTRY_FAILED_ACCESS ior ARCHIVE_ENTRY_ACL_ENTRY_INHERITED)

/* We need to be able to specify combinations of these. */
Define ARCHIVE_ENTRY_ACL_TYPE_ACCESS    for |CI$00000100  /* POSIX.1e only */
Define ARCHIVE_ENTRY_ACL_TYPE_DEFAULT   for |CI$00000200  /* POSIX.1e only */
Define ARCHIVE_ENTRY_ACL_TYPE_ALLOW     for |CI$00000400 /* NFS4 only */
Define ARCHIVE_ENTRY_ACL_TYPE_DENY      for |CI$00000800 /* NFS4 only */
Define ARCHIVE_ENTRY_ACL_TYPE_AUDIT     for |CI$00001000 /* NFS4 only */
Define ARCHIVE_ENTRY_ACL_TYPE_ALARM     for |CI$00002000 /* NFS4 only */
Define ARCHIVE_ENTRY_ACL_TYPE_POSIX1E   for (ARCHIVE_ENTRY_ACL_TYPE_ACCESS ior ARCHIVE_ENTRY_ACL_TYPE_DEFAULT)
Define ARCHIVE_ENTRY_ACL_TYPE_NFS4      for (ARCHIVE_ENTRY_ACL_TYPE_ALLOW ior ARCHIVE_ENTRY_ACL_TYPE_DENY ior ARCHIVE_ENTRY_ACL_TYPE_AUDIT ior ARCHIVE_ENTRY_ACL_TYPE_ALARM)

/* Tag values mimic POSIX.1e */
Define ARCHIVE_ENTRY_ACL_USER       for 10001   /* Specified user. */
Define ARCHIVE_ENTRY_ACL_USER_OBJ   for 10002   /* User who owns the file. */
Define ARCHIVE_ENTRY_ACL_GROUP      for 10003   /* Specified group. */
Define ARCHIVE_ENTRY_ACL_GROUP_OBJ  for 10004   /* Group who owns the file. */
Define ARCHIVE_ENTRY_ACL_MASK       for 10005   /* Modify group access (POSIX.1e only) */
Define ARCHIVE_ENTRY_ACL_OTHER      for 10006   /* Public (POSIX.1e only) */
Define ARCHIVE_ENTRY_ACL_EVERYONE   for 10107   /* Everyone (NFS4 only) */

/*
 * Error codes: Use archive_errno() and archive_error_string()
 * to retrieve details.  Unless specified otherwise, all functions
 * that return 'int' use these codes.
*/
Define ARCHIVE_EOF      for 1   /* Found end of archive. */
Define ARCHIVE_OK       for 0   /* Operation was successful. */
Define ARCHIVE_RETRY    for -10 /* Retry might succeed. */
Define ARCHIVE_WARN     for -20 /* Partial success. */
/* For example, if write_header "fails", then you can't push data. */
Define ARCHIVE_FAILED   for -25 /* Current operation cannot complete. */
/* But if write_header is "fatal," then this archive is dead and useless. */
Define ARCHIVE_FATAL    for -30 /* No more operations are possible. */

Define ARCHIVE_READ_WRITE_EXECUTE_FOR_ALL           for 511 // 0777    rwxrwxrwx    Read/Write/execute for All
Define ARCHIVE_COMMON_FOR_EXECUTABLE_FILES_AND_DIRS for 493 // 0755    rwxr-xr-x    Common for executable files/dirs
Define ARCHIVE_FOR_REGULAR_FILES                    for 420 // 0644    rw-r--r--    Common for regular files
Define ARCHIVE_PRIVATE_USER_READABLE_WRITEABLE      for 384 // 0600    rw-------    Private user-readable/writeable
Define ARCHIVE_USER_ONLY_FULL_ACCESS                for 448 // 0700    rwx------    User-only full access

/*
 * Set behavior. The "flags" argument selects optional behavior.
*/
/* Request that the access time of the entry visited by traversal be restored.
 * This is the same as archive_read_disk_set_atime_restored. */
Define ARCHIVE_READDISK_RESTORE_ATIME       for |CI$0001
/* Default: Do not skip an entry which has nodump flags. */
Define ARCHIVE_READDISK_HONOR_NODUMP        for |CI$0002
/* Default: Skip a mac resource fork file whose prefix is "._" because of using copyfile. */
Define ARCHIVE_READDISK_MAC_COPYFILE        for |CI$0004
/* Default: Traverse mount points. */
Define ARCHIVE_READDISK_NO_TRAVERSE_MOUNTS  for |CI$0008
/* Default: Xattrs are read from disk. */
Define ARCHIVE_READDISK_NO_XATTR            for |CI$0010
/* Default: ACLs are read from disk. */
Define ARCHIVE_READDISK_NO_ACL              for |CI$0020
/* Default: File flags are read from disk. */
Define ARCHIVE_READDISK_NO_FFLAGS           for |CI$0040
/* Default: Sparse file information is read from disk. */
Define ARCHIVE_READDISK_NO_SPARSE           for |CI$0080

/*
The function archive_entry_free() in libarchive is a void function — it does not return any value.
Always free entries you allocate with archive_entry_new() to avoid memory leaks, especially when writing many files in a loop.
What is does:
- Frees the memory associated with an archive_entry Object.
- Safe to call on a NULL Pointer (no-op).
- No return value; there's no success/failure result to check.
*/
External_Function archive_entry_free "archive_entry_free" archive.dll ;
    Pointer pEntry ;
    Returns Void_Type

/*
A function that allocates and returns a new, empty archive entry object.

An archive_entry object represents a single file or directory within an archive. It holds metadata about the entry, such as its pathname, permissions, ownership, timestamps, and size.

Allocation: It allocates memory for a new struct archive_entry.
Initialization: It initializes the fields of this new entry object to default or empty values.
After obtaining a new archive entry using archive_entry_new(), you would typically use other archive_entry_ functions to populate its metadata. For example:

archive_entry_set_pathname(): Sets the name of the entry.
archive_entry_set_mode(): Sets the file type and permissions.
archive_entry_set_size(): Sets the size of the file data.
archive_entry_set_mtime(): Sets the last modification time.
and many others.
When you are finished with an archive_entry object, you should free its associated memory using archive_entry_free().
*/
External_Function archive_entry_new "archive_entry_new" archive.dll ;
    Returns Pointer

/*
A function in the libarchive library that sets the file type of an archive entry using a mode_t value.

The mode_t type is typically defined in <sys/types.h> and is used to represent file modes, including the file type and permissions. This function specifically looks at the file type bits within the provided mode_t value.

Here are the common file types that can be set using the bits in the mode_t argument:

AR_IFREG: Regular file
AR_IFDIR: Directory
AR_IFLNK: Symbolic link
AR_IFCHR: Character device
AR_IFBLK: Block device
AR_IFFIFO: FIFO (named pipe)
AR_IFSOCK: Socket

When you call archive_entry_set_filetype(), you pass the archive_entry you want to modify and a mode_t value where the file type bits are set accordingly.

This function sets the file type of the archive entry based on the bits in the provided mode_t value. It's generally assumed to succeed in setting the file type. Internal issues might lead to other problems, but the function itself doesn't return an error code.
*/
External_Function archive_entry_set_filetype "archive_entry_set_filetype" archive.dll ;
    Pointer pEntry ;
    UInteger eFileType ;
    Returns Integer

/*
It sets the mode for an entry within an archive. The mode is a combination of the file type (e.g., regular file, directory, symbolic link) and its permissions (read, write, execute for owner, group, and others).
*/
External_Function archive_entry_set_mode "archive_entry_set_mode" archive.dll ;
    Pointer pArchiveEntry ;
    Integer eMode ;
    Returns Void_Type

/*
It sets the modification time (mtime) for an entry within an archive.
The modification time indicates the last time the content of a file was modified.
This is a common piece of metadata stored in archive formats and is analogous to the st_mtime field in a Unix-like stat structure.
*/
External_Function archive_entry_set_mtime "archive_entry_set_mtime" archive.dll ;
    Pointer pArchiveentry ;
    Integer iSeconds ;
    Integer iNanoSeconds ;
    Returns Void_Type

/*
This Function sets the file permissions (the permission bits within the mode_t argument) for the archive entry. It's generally assumed to succeed in setting these permissions. If there were internal issues (like memory allocation problems), they would likely manifest in other ways, but the function itself doesn't return an Error indicator.
Sets the permission bits: archive_entry_set_perm() specifically looks at the permission bits within the provided mode_t value and sets the corresponding permissions for the archive entry. It does not affect the file type bits; for that, you would use functions like archive_entry_set_filetype().

The permission bits in a mode_t value are typically structured as follows (in octal representation):

The last three digits represent permissions for the owner, group, and others, respectively.
Each digit is a sum of bits for read (4), write (2), and execute (1).

For example:

0644 means read/write for owner, read for group, and read for others.
0755 means read/write/execute for owner, read/execute for group, and read/execute for others.
*/
External_Function archive_entry_set_perm "archive_entry_set_perm" archive.dll ;
    Pointer pEntry ;
    Integer iPermission ;
    Returns Integer

/*
A function used to set the pathname of an archive entry, explicitly interpreting the provided string as being encoded in UTF-8.

Setting the Pathname: Like archive_entry_set_pathname(), this function sets the name (path) of the file or directory that the archive_entry object represents within the archive.
Explicit UTF-8 Interpretation: The key difference is that archive_entry_set_pathname_utf8() explicitly tells libarchive that the input const char * string is encoded using UTF-8. This is important for handling filenames that contain characters outside of the basic ASCII range in a consistent and portable way.
When you use archive_entry_set_pathname_utf8(), libarchive will store the pathname internally, ensuring that it's treated as UTF-8. This can affect how the pathname is encoded when the archive is written and how it's interpreted when the archive is read by applications that understand UTF-8 pathnames.

Return Value: archive_entry_set_pathname() does not return a value that you would typically use for error checking.
Success/Failure: It's assumed to succeed in setting the pathname. Failures would likely manifest as more severe issues like crashes due to memory problems.
*/
External_Function archive_entry_set_pathname "archive_entry_set_pathname_utf8" archive.dll ;
    Pointer pEntry ;
    Pointer pFileName ;
    Returns Integer

/*
A function in the libarchive library that sets the size (in bytes) of the data associated with an archive entry.
This function takes two arguments:
- A pointer to the struct archive_entry object you want to modify.
- A int64 value representing the size of the data. Using int64 allows you to specify large file sizes.
The size set by this function is typically used when writing an archive to indicate how much data will follow for that entry. When reading an archive, this function is usually called internally by libarchive based on the information in the archive header, making the size available through archive_entry_size().
According to the libarchive documentation, this function sets the size of the data associated with the archive entry. It's generally assumed to succeed. Internal memory allocation issues might lead to problems elsewhere, but the function itself doesn't return an error code.
*/
External_Function archive_entry_set_size "archive_entry_set_size" archive.dll ;
    Pointer pEntry ;
    BigInt iLength ;
    Returns Integer

/* Simplified cleanup interface;This calls archive_read_free() or archive_write_free() as needed. */
External_Function archive_free "archive_free" archive.dll ;
    Pointer pArchive ;
    Returns Integer

/*
Finalizes the archive: It performs any necessary finalization steps for the archive format. This might include writing trailer blocks or closing out any open structures within the archive.
Closes the underlying I/O: It closes the file or stream that was associated with the archive for writing (e.g., if you used archive_write_open_filename() or a similar function).
Return Value:

archive_write_close() returns an integer value to indicate the result of the operation:

ARCHIVE_OK (0): The archive was successfully closed.
ARCHIVE_WARN (1): The archive was closed, but some non-critical issues occurred. You should check the warning messages using archive_error_string().
ARCHIVE_FATAL (> 1): A serious error occurred during the closing process.
ARCHIVE_FAILED (< 0, typically -1 or -5): An error occurred while trying to close the archive. You should check the error message using archive_error_string().

After calling archive_write_close(), you should typically call archive_write_free() to release the memory associated with the struct archive object.
*/
External_Function archive_write_close "archive_write_close" archive.dll ;
    Pointer pArchive ;
    Returns Integer

/*
The function archive_write_data() in libarchive is used to write the file contents (data) for the current entry, and it returns a result code (negative number) or byte count.
*/
External_Function archive_write_data "archive_write_data" archive.dll ;
    Pointer pArchive ;
    Pointer pData ;
    Longptr iSize ;
    Returns Integer

/*
The function archive_write_new() creates a new archive-writing object.
Unlike most other libarchive functions, archive_write_new() does not return an int status code — it returns a pointer.
*/
External_Function archive_write_new "archive_write_new" archive.dll ;
    Returns Pointer

/*
Writes the header: archive_write_header() writes the header information for the entry to the archive according to the selected archive format. This header tells the archiver (and later, the extractor) things like the filename, size, permissions, and type of the entry.
Return Value:

archive_write_header() returns an integer value to indicate success or failure:

ARCHIVE_OK (0): The header was written successfully.
ARCHIVE_WARN (1): The header was written, but one or more non-critical issues were encountered. You should check the warning messages using archive_error_string().
ARCHIVE_FATAL (> 1): A serious error occurred, and no more data can be written to this archive.
ARCHIVE_FAILED (< 0, typically -1 or -5): An error occurred while trying to write the header. You should check the error message using archive_error_string().

After successfully writing the header for a file (i.e., when the entry is not a directory or symbolic link with no content), you would typically call archive_write_data() one or more times to write the actual file content. For directories and some other entry types, you might not need to call archive_write_data().
*/
External_Function archive_write_header "archive_write_header" archive.dll ;
    Pointer pArchive ;
    Pointer pEntry ;
    Returns Integer

/*
Opens the file: It attempts to open the specified file in write mode. If the file doesn't exist, it will typically be created. If it exists, it will usually be overwritten.
Associates the file with the archive handle: It sets up the necessary internal structures so that subsequent calls to archive_write_header() and archive_write_data() will write to this opened file.
Return Value:

archive_write_open_filename() returns an integer value to indicate the result of the operation:

ARCHIVE_OK (0): The file was successfully opened.
ARCHIVE_FATAL (> 1): A serious error occurred, and the file could not be opened.
ARCHIVE_FAILED (< 0, typically -1 or -5): An error occurred while trying to open the file. You should check the error message using archive_error_string().
After successfully opening the file, you would typically proceed to create archive_entry objects, write their headers using archive_write_header(), and then write their data using archive_write_data(). Once you're finished writing all the entries, you should call archive_write_close() and finally archive_write_free().

Pass a pointer - addressof() - to a normal DataFlex string (UTF-8)
*/
External_Function archive_write_open_filename "archive_write_open_filename" archive.dll ;
    Pointer pArchive ;
    Pointer pFileName ;
    Returns Integer

/*
function in the libarchive library that allows you to set the number of bytes per block for the archive being written.

This setting is particularly relevant for certain archive formats, most notably the tar format.
Historically, tar archives were often written to tape drives with specific block sizes.
While less critical for modern file-based archives, some systems or specifications might still expect a particular block size.

The block size can influence how the archive is structured on the storage medium.
For tar, records are typically 512 bytes, and multiple records form a block.
The block size set here might affect how many records are written together.

For many common use cases of creating tar archives on modern file systems, you might not need to explicitly set the bytes per block,
and libarchive will use a reasonable default.
*/
External_Function archive_write_set_bytes_per_block "archive_write_set_bytes_per_block" archive.dll ;
    Pointer pArchive ;
    Integer bytes_per_block ;
    Returns Integer

/*
The function sets the output format to ar(1) BSD variant, commonly used for creating static libraries on Unix-like systems (.a files).
Its return values indicate success or failure.
*/
External_Function archive_write_set_format_ar_bsd "archive_write_set_format_ar_bsd" archive.dll ;
    Pointer pArchive ;
    Returns Integer

/*
The function that sets the output archive format to the GNU variant of the ar archive format.
*/
External_Function archive_write_set_format_ar_gnu "archive_write_set_format_ar_gnu" archive.dll ;
    Pointer pArchive ;
    Returns Integer

/*
The function sets the archive format to System V Release 4 (SVR4) variant of ar — another format used for creating .a static libraries.
Its return values indicate success or failure.
*/
External_Function archive_write_set_format_ar_svr4 "archive_write_set_format_ar_svr4" archive.dll ;
    Pointer pArchive ;
    Returns Integer

/*
The function sets the archive format to CPIO (a legacy POSIX archive format).
Its return values indicate success or failure.
*/
External_Function archive_write_set_format_cpio "archive_write_set_format_cpio" archive.dll ;
    Pointer pArchive ;
    Returns Integer

/*
The function sets the archive format to the legacy binary CPIO format (also known as "old binary" CPIO format).
Its return values indicate success or failure.
*/
External_Function archive_write_set_format_cpio_bin "archive_write_set_format_cpio_bin" archive.dll ;
    Pointer pArchive ;
    Returns Integer

/*
