Use DFUnit.pkg
Use Archive.h.pkg
Use Tests\TestSupport.pkg

// Wrapper classes (classes cannot be declared inside objects, so they are used first)
Use cArchiveBase.pkg
Use cArchiveEntry.pkg
Use cArchiveMatch.pkg
Use cArchiveLinkResolver.pkg
Use cArchiveReader.pkg
Use cArchiveDiskReader.pkg
Use cArchiveWriter.pkg
Use cArchiveDiskWriter.pkg
Use cFilesArchiver.pkg

// Unit tests (DFUnit) for the libarchive external functions and the wrapper classes.
// Run:  LibArchiveTests64.exe -c                  console output (needs a console)
//       LibArchiveTests64.exe -c -o result.xml    XML result file
//       LibArchiveTests64.exe -c --junit-file result.xml
//       LibArchiveTests64.exe -g                  GUI test runner
// Exit code 0 when all tests passed, -1 otherwise.
// Started from the DataFlex Studio debugger the DFUnit test runner window is shown (green/red results); a failed
// assertion or an unexpected error then also raises the DataFlex error dialog with call stack (DFUnit behavior
// while a debugger is attached).
Object oApplication is a cApplication
End_Object

Object oLibArchiveTests is a cDFUnitTestApplication
    Set pbUseUI to False

    Use Tests\TestSmoke.pkg
    Use Tests\TestCommon.pkg
    Use Tests\TestRead.pkg
    Use Tests\TestReadDisk.pkg
    Use Tests\TestWrite.pkg
    Use Tests\TestWriteDisk.pkg
    Use Tests\TestEntry.pkg
    Use Tests\TestEntryLinks.pkg
    Use Tests\TestMatch.pkg
    Use Tests\TestWrapperBase.pkg
    Use Tests\TestWrapperEntry.pkg
    Use Tests\TestWrapperMatch.pkg
    Use Tests\TestWrapperReader.pkg
    Use Tests\TestWrapperDiskReader.pkg
    Use Tests\TestWrapperWriter.pkg
    Use Tests\TestWrapperDiskWriter.pkg
    Use Tests\TestFilesArchiver.pkg
End_Object
