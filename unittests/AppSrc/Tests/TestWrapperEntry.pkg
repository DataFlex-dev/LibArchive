// Tests of the wrapper classes cArchiveEntry and cArchiveLinkResolver. The classes (cArchiveEntry.pkg,
// cArchiveLinkResolver.pkg) must be Used by the test application before this package is included.
// Entries are created through the wrapper and verified with the raw archive_entry_* externals, with libarchive
// round trips (write an archive to memory, read it back) and between wrapper objects.
Object oWrapperEntryTests is a cArchiveTestFixture
    Set psTestFixtureName to "WrapperEntry"

    // Wrapper objects the tests work with (declared here because objects with procedures can not be declared in a method).
    Object oEntry is a cArchiveEntry
    End_Object

    Object oEntry2 is a cArchiveEntry
    End_Object

    Object oBorrowed is a cArchiveEntry
    End_Object

    // Writes a 32 bit little endian value into a byte buffer.
    Procedure PutUInt32 UChar[] ByRef ucBuf Integer iOffset BigInt iValue
        Integer iIndex iByte
        BigInt iRest

        Move iValue to iRest
        For iIndex from 0 to 3
            Move (Mod (iRest, 256)) to iByte
            Move iByte to ucBuf[iOffset + iIndex]
            Move ((iRest - iByte) / 256) to iRest
        Loop
    End_Procedure

    // A string whose second byte is 0xFF, which is never valid in UTF-8 (a DataFlex string literal or Character (255) is
    // always valid UTF-8, so the byte is patched in).
    Function InvalidUtf8 Returns String
        String sBad
        UChar[] ucBytes
        Boolean bOk

        Move "abcd" to sBad
        Move (ResizeArray (ucBytes, 3)) to ucBytes
        Move 97 to ucBytes[0]
        Move 255 to ucBytes[1]
        Move 98 to ucBytes[2]
        Move (MemCopy (AddressOf (sBad), AddressOf (ucBytes), 3)) to bOk
        Function_Return sBad
    End_Function

    // ---- life cycle ---------------------------------------------------------------------------------------------

    Object oLifeCycleTest is a cTest
        Procedure Test
            String sPathname
            Boolean bOwnsEntry bSizeIsSet bUidIsSet
            Pointer pEntry pEntry2
            BigInt biSize
            Integer iMode
            Boolean bHasEntry
            Integer iXattrCount
            Pointer pRaw pOwn pArchive
            String sRaw
            Handle hoClone
            Boolean bOk
            Void_Type iVoid
            Integer iResult

            Send FreeEntry of oEntry // the test objects live as long as the application: start clean when the tests run again
            Get HasEntry of oEntry to bHasEntry
            Send AssertFalse bHasEntry "no entry before CreateEntry"
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "" sPathname "empty path without entry"

            Send CreateEntry of oEntry
            Get HasEntry of oEntry to bHasEntry
            Send Assert bHasEntry "entry after CreateEntry"
            Get pbOwnsEntry of oEntry to bOwnsEntry
            Send Assert bOwnsEntry "CreateEntry owns the entry"
            Get ppEntry of oEntry to pOwn
            Send Assert (pOwn <> 0) "entry pointer"

            // A borrowed entry is not freed by the wrapper.
            Move (archive_entry_new ()) to pRaw
            Move "raw.txt" to sRaw
            Move (archive_entry_set_pathname_utf8 (pRaw, AddressOf (sRaw))) to iVoid
            Send AttachEntry of oBorrowed pRaw False
            Get pbOwnsEntry of oBorrowed to bOwnsEntry
            Send AssertFalse bOwnsEntry "borrowed entry is not owned"
            Get psPathname of oBorrowed to sPathname
            Send AssertSAreEqual "raw.txt" sPathname "wrapper reads a raw entry"
            Send FreeEntry of oBorrowed
            Get HasEntry of oBorrowed to bHasEntry
            Send AssertFalse bHasEntry "FreeEntry forgets the entry"
            Send AssertSAreEqual "raw.txt" (PointerToString (archive_entry_pathname_utf8 (pRaw))) "borrowed entry still valid after FreeEntry"
            Move (archive_entry_free (pRaw)) to iVoid

            // AttachEntry with bOwns True: the wrapper frees it (no crash, no leak check possible); then re-attach replaces.
            Move (archive_entry_new ()) to pRaw
            Send AttachEntry of oBorrowed pRaw True
            Get pbOwnsEntry of oBorrowed to bOwnsEntry
            Send Assert bOwnsEntry "attached entry owned"
            Get ppEntry of oBorrowed to pEntry
            Send AssertPAreEqual pRaw pEntry "attached pointer"
            Send FreeEntry of oBorrowed

            // CreateEntryForArchive with a real archive handle and with 0.
            Move (archive_read_new ()) to pArchive
            Send CreateEntryForArchive of oBorrowed pArchive
            Get HasEntry of oBorrowed to bHasEntry
            Send Assert bHasEntry "entry for archive"
            Set psPathname of oBorrowed to "for-archive.txt"
            Get psPathname of oBorrowed to sPathname
            Send AssertSAreEqual "for-archive.txt" sPathname "entry for archive works"
            Send FreeEntry of oBorrowed
            Move (archive_read_free (pArchive)) to iResult
            Send CreateEntryForArchive of oBorrowed 0
            Get HasEntry of oBorrowed to bHasEntry
            Send Assert bHasEntry "entry for no archive"
            Send FreeEntry of oBorrowed

            // Clear resets all fields.
            Set psPathname of oEntry to "clear-me.txt"
            Set piSize of oEntry to 99
            Set piUid of oEntry to 5
            Send Clear of oEntry
            Get HasEntry of oEntry to bHasEntry
            Send Assert bHasEntry "Clear keeps the entry"
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "" sPathname "Clear empties path"
            Get pbSizeIsSet of oEntry to bSizeIsSet
            Send AssertFalse bSizeIsSet "Clear unsets size"
            Get pbUidIsSet of oEntry to bUidIsSet
            Send AssertFalse bUidIsSet "Clear unsets uid"

            // CloneEntry makes an independent deep copy.
            Set psPathname of oEntry to "original.txt"
            Set piSize of oEntry to 1234
            Set piMode of oEntry to (AE_IFREG ior 420)
            Send XattrAddText of oEntry "user.k" "v"
            Get CloneEntry of oEntry to hoClone
            Send Assert (hoClone <> 0) "clone handle"
            Send AssertFalse (hoClone = oEntry) "clone is another object"
            Get pbOwnsEntry of hoClone to bOwnsEntry
            Send Assert bOwnsEntry "clone owns its entry"
            Get ppEntry of hoClone to pEntry
            Get ppEntry of oEntry to pEntry2
            Send AssertFalse (pEntry = pEntry2) "clone has its own entry"
            Get psPathname of hoClone to sPathname
            Send AssertSAreEqual "original.txt" sPathname "clone path"
            Get piSize of hoClone to biSize
            Send AssertBIAreEqual 1234 biSize "clone size"
            Get piMode of hoClone to iMode
            Send AssertIAreEqual (AE_IFREG ior 420) iMode "clone mode"
            Get XattrCount of hoClone to iXattrCount
            Send AssertIAreEqual 1 iXattrCount "clone xattr"
            Set psPathname of oEntry to "changed.txt"
            Get psPathname of hoClone to sPathname
            Send AssertSAreEqual "original.txt" sPathname "clone independent of original"
            Send Request_Destroy_Object of hoClone
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "changed.txt" sPathname "original survives destroying the clone"

            // An object without entry gives no clone and neutral values.
            Send FreeEntry of oEntry
            Get CloneEntry of oEntry to hoClone
            Send AssertIAreEqual 0 hoClone "no clone without entry"
            Get piSize of oEntry to biSize
            Send AssertBIAreEqual 0 biSize "neutral size without entry"
            Get pbSizeIsSet of oEntry to bSizeIsSet
            Send AssertFalse bSizeIsSet "neutral flag without entry"
        End_Procedure
    End_Object

    // ---- names --------------------------------------------------------------------------------------------------

    Object oPathnameTest is a cTest
        Procedure Test
            String sPathname sPathnameWide sHardlink sSymlink sLink sUname sGname
            Boolean bLastTextLossless
            String sInvalidUtf8
            Pointer pEntry
            Pointer pWriter pReader pRead
            Integer iResult
            BigInt iUsed
            UChar[] ucArchive
            Void_Type iVoid

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry

            Set psPathname of oEntry to "héllo-ünï.txt"
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "héllo-ünï.txt" sPathname "UTF-8 round trip"
            Send AssertSAreEqual "héllo-ünï.txt" (PointerToString (archive_entry_pathname_utf8 (pEntry))) "raw UTF-8 value"
            Get psPathnameWide of oEntry to sPathnameWide
            Send AssertSAreEqual "héllo-ünï.txt" sPathnameWide "wide value"

            Set psPathnameWide of oEntry to "wide-ünï.txt"
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "wide-ünï.txt" sPathname "wide setter visible as UTF-8"
            Get psPathnameWide of oEntry to sPathnameWide
            Send AssertSAreEqual "wide-ünï.txt" sPathnameWide "wide round trip"


            Send SetPathnameUtf8 of oEntry "set-utf8.txt"
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "set-utf8.txt" sPathname "SetPathnameUtf8"

            // Invalid UTF-8 is reported by the property setter.
            Send ExpectError DFERR_PROGRAM
            Get InvalidUtf8 to sInvalidUtf8
            Set psPathname of oEntry to sInvalidUtf8
            Send UnExpectError DFERR_PROGRAM
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "set-utf8.txt" sPathname "invalid UTF-8 is not passed to libarchive"

            // Valid text that the ANSI code page can not represent is accepted and read back identically.
            Set psPathname of oEntry to "日本語/ファイル.txt"
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "日本語/ファイル.txt" sPathname "CJK path round trip"
            Send AssertSAreEqual "日本語/ファイル.txt" (PointerToString (archive_entry_pathname_utf8 (pEntry))) "raw CJK path"
            Get psPathnameWide of oEntry to sPathnameWide
            Send AssertSAreEqual "日本語/ファイル.txt" sPathnameWide "CJK path as wide text"
            Set psHardlink of oEntry to "日本語-ハード.txt"
            Get psHardlink of oEntry to sHardlink
            Send AssertSAreEqual "日本語-ハード.txt" sHardlink "CJK hard link"
            Set psSymlink of oEntry to "日本語-シンボル.txt"
            Get psSymlink of oEntry to sSymlink
            Send AssertSAreEqual "日本語-シンボル.txt" sSymlink "CJK symlink"
            Set psLink of oEntry to "日本語-リンク.txt"
            Get psLink of oEntry to sLink
            Send AssertSAreEqual "日本語-リンク.txt" sLink "CJK link"
            Set psUname of oEntry to "山田"
            Get psUname of oEntry to sUname
            Send AssertSAreEqual "山田" sUname "CJK user name"
            Set psGname of oEntry to "開発"
            Get psGname of oEntry to sGname
            Send AssertSAreEqual "開発" sGname "CJK group name"
            Get pbLastTextLossless of oEntry to bLastTextLossless
            Send Assert (bLastTextLossless or not (bLastTextLossless)) "pbLastTextLossless readable"
            Set psPathname of oEntry to "plain-ascii.txt"
            Get pbLastTextLossless of oEntry to bLastTextLossless
            Send Assert bLastTextLossless "ASCII text converts without loss"
            Set psPathname of oEntry to "日本語.txt"
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "日本語.txt" sPathname "CJK path set again"

            // An entry with a CJK name can be written to an archive and read back.
            Set psHardlink of oEntry to ""
            Set psSymlink of oEntry to ""
            Set piMode of oEntry to (AE_IFREG ior 420)
            Set piSize of oEntry to 0
            Move (ResizeArray (ucArchive, 65536)) to ucArchive
            Move (archive_write_new ()) to pWriter
            Move (archive_write_set_format (pWriter, ARCHIVE_FORMAT_TAR_PAX_INTERCHANGE)) to iResult
            Move (archive_write_open_memory (pWriter, AddressOf (ucArchive), 65536, AddressOf (iUsed))) to iResult
            Move (archive_write_header (pWriter, pEntry)) to iResult
            Send AssertArchiveOk iResult pWriter "write header of an entry with a CJK name"
            Move (archive_write_close (pWriter)) to iResult
            Move (archive_write_free (pWriter)) to iResult
            Move (archive_read_new ()) to pReader
            Move (archive_read_support_format_all (pReader)) to iResult
            Move (archive_read_open_memory (pReader, AddressOf (ucArchive), iUsed)) to iResult
            Move (archive_read_next_header (pReader, AddressOf (pRead))) to iResult
            Send AssertArchiveOk iResult pReader "read header of the CJK entry"
            Send AttachEntry of oBorrowed pRead False
            Get psPathname of oBorrowed to sPathname
            Send AssertSAreEqual "日本語.txt" sPathname "CJK name read back from the archive"
            Send FreeEntry of oBorrowed
            Move (archive_read_free (pReader)) to iResult

            Set psPathname of oEntry to ""
            Get psPathname of oEntry to sPathname
            Send AssertSAreEqual "" sPathname "empty string removes the path"
            Send AssertPAreEqual 0 (archive_entry_pathname_utf8 (pEntry)) "raw path is NULL after removal"
        End_Procedure
    End_Object

    Object oOwnerNamesTest is a cTest
        Procedure Test
            String sUname sUnameWide sGname sGnameWide
            Pointer pEntry

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry

            Set psUname of oEntry to "Jürgen"
            Get psUname of oEntry to sUname
            Send AssertSAreEqual "Jürgen" sUname "uname UTF-8"
            Send AssertSAreEqual "Jürgen" (PointerToString (archive_entry_uname_utf8 (pEntry))) "raw uname UTF-8"
            Get psUnameWide of oEntry to sUnameWide
            Send AssertSAreEqual "Jürgen" sUnameWide "uname wide"
            Set psUnameWide of oEntry to "Zoë"
            Get psUname of oEntry to sUname
            Send AssertSAreEqual "Zoë" sUname "uname wide setter"
            Send SetUnameUtf8 of oEntry "bob"
            Get psUname of oEntry to sUname
            Send AssertSAreEqual "bob" sUname "SetUnameUtf8"
            Set psUname of oEntry to ""
            Get psUname of oEntry to sUname
            Send AssertSAreEqual "" sUname "uname removed"

            Set psGname of oEntry to "Straße"
            Get psGname of oEntry to sGname
            Send AssertSAreEqual "Straße" sGname "gname UTF-8"
            Send AssertSAreEqual "Straße" (PointerToString (archive_entry_gname_utf8 (pEntry))) "raw gname UTF-8"
            Get psGnameWide of oEntry to sGnameWide
            Send AssertSAreEqual "Straße" sGnameWide "gname wide"
            Set psGnameWide of oEntry to "Équipe"
            Get psGname of oEntry to sGname
            Send AssertSAreEqual "Équipe" sGname "gname wide setter"
            Send SetGnameUtf8 of oEntry "wheel"
            Get psGname of oEntry to sGname
            Send AssertSAreEqual "wheel" sGname "SetGnameUtf8"
            Set psGname of oEntry to ""
            Get psGname of oEntry to sGname
            Send AssertSAreEqual "" sGname "gname removed"
        End_Procedure
    End_Object

    Object oSourcePathTest is a cTest
        Procedure Test
            String sSourcePath
            Pointer pEntry

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry
            Get psSourcePath of oEntry to sSourcePath
            Send AssertSAreEqual "" sSourcePath "no source path yet"
            Set psSourcePath of oEntry to "C:\Temp\ünï\file.txt"
            Get psSourcePath of oEntry to sSourcePath
            Send AssertSAreEqual "C:\Temp\ünï\file.txt" sSourcePath "source path round trip"
            Set psSourcePath of oEntry to ""
            Get psSourcePath of oEntry to sSourcePath
            Send AssertSAreEqual "" sSourcePath "source path removed"
        End_Procedure
    End_Object

    Object oLinksTest is a cTest
        Procedure Test
            Boolean bHardlinkIsSet
            Integer eSymlinkType
            String sSymlink sSymlinkWide sLink sHardlink sHardlinkWide
            String sInvalidUtf8
            Pointer pEntry

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry
            Get pbHardlinkIsSet of oEntry to bHardlinkIsSet
            Send AssertFalse bHardlinkIsSet "no hard link yet"
            Get peSymlinkType of oEntry to eSymlinkType
            Send AssertIAreEqual AE_SYMLINK_TYPE_UNDEFINED eSymlinkType "symlink type undefined"

            // symbolic link
            Set psSymlink of oEntry to "../ziel/däte.txt"
            Get psSymlink of oEntry to sSymlink
            Send AssertSAreEqual "../ziel/däte.txt" sSymlink "symlink UTF-8"
            Send AssertSAreEqual "../ziel/däte.txt" (PointerToString (archive_entry_symlink_utf8 (pEntry))) "raw symlink"
            Get psSymlinkWide of oEntry to sSymlinkWide
            Send AssertSAreEqual "../ziel/däte.txt" sSymlinkWide "symlink wide"
            Get pbHardlinkIsSet of oEntry to bHardlinkIsSet
            Send AssertFalse bHardlinkIsSet "a symlink is no hard link"
            Get psLink of oEntry to sLink
            Send AssertSAreEqual "../ziel/däte.txt" sLink "psLink gives the symlink"
            Set peSymlinkType of oEntry to AE_SYMLINK_TYPE_DIRECTORY
            Get peSymlinkType of oEntry to eSymlinkType
            Send AssertIAreEqual AE_SYMLINK_TYPE_DIRECTORY eSymlinkType "symlink type"
            Set peSymlinkType of oEntry to AE_SYMLINK_TYPE_FILE
            Get peSymlinkType of oEntry to eSymlinkType
            Send AssertIAreEqual AE_SYMLINK_TYPE_FILE eSymlinkType "symlink type file"
            Set psSymlinkWide of oEntry to "wide-ü"
            Get psSymlink of oEntry to sSymlink
            Send AssertSAreEqual "wide-ü" sSymlink "symlink wide setter"
            Send SetSymlinkUtf8 of oEntry "utf8-target"
            Get psSymlink of oEntry to sSymlink
            Send AssertSAreEqual "utf8-target" sSymlink "SetSymlinkUtf8"
            Send ClearSymlink of oEntry
            Get psSymlink of oEntry to sSymlink
            Send AssertSAreEqual "" sSymlink "ClearSymlink"
            Get psLink of oEntry to sLink
            Send AssertSAreEqual "" sLink "no link left"

            // hard link (shares one storage with the symlink in libarchive)
            Set psHardlink of oEntry to "first.txt"
            Get pbHardlinkIsSet of oEntry to bHardlinkIsSet
            Send Assert bHardlinkIsSet "hard link set"
            Get psHardlink of oEntry to sHardlink
            Send AssertSAreEqual "first.txt" sHardlink "hard link UTF-8"
            Send AssertSAreEqual "first.txt" (PointerToString (archive_entry_hardlink_utf8 (pEntry))) "raw hard link"
            Get psHardlinkWide of oEntry to sHardlinkWide
            Send AssertSAreEqual "first.txt" sHardlinkWide "hard link wide"
            Get psSymlink of oEntry to sSymlink
            Send AssertSAreEqual "" sSymlink "hard link is no symlink"
            Get psLink of oEntry to sLink
            Send AssertSAreEqual "first.txt" sLink "psLink gives the hard link"
            Set psHardlinkWide of oEntry to "wide-hü.txt"
            Get psHardlink of oEntry to sHardlink
            Send AssertSAreEqual "wide-hü.txt" sHardlink "hard link wide setter"
            Send SetHardlinkUtf8 of oEntry "utf8-h.txt"
            Get psHardlink of oEntry to sHardlink
            Send AssertSAreEqual "utf8-h.txt" sHardlink "SetHardlinkUtf8"

            // the link of the kind that is currently set
            Set psLink of oEntry to "second.txt"
            Get psHardlink of oEntry to sHardlink
            Send AssertSAreEqual "second.txt" sHardlink "psLink keeps the hard link kind"
            Send SetLinkToSymlink of oEntry
            Get pbHardlinkIsSet of oEntry to bHardlinkIsSet
            Send AssertFalse bHardlinkIsSet "SetLinkToSymlink"
            Get psSymlink of oEntry to sSymlink
            Send AssertSAreEqual "second.txt" sSymlink "link target now a symlink"
            Send SetLinkToHardlink of oEntry
            Get pbHardlinkIsSet of oEntry to bHardlinkIsSet
            Send Assert bHardlinkIsSet "SetLinkToHardlink"
            Get psHardlink of oEntry to sHardlink
            Send AssertSAreEqual "second.txt" sHardlink "link target now a hard link"
            Send SetLinkUtf8 of oEntry "l-utf8"
            Get psLink of oEntry to sLink
            Send AssertSAreEqual "l-utf8" sLink "SetLinkUtf8"
            Send CopyLinkWide of oEntry "l-wide-ü"
            Get psLink of oEntry to sLink
            Send AssertSAreEqual "l-wide-ü" sLink "CopyLinkWide"
            Send ClearHardlink of oEntry
            Get pbHardlinkIsSet of oEntry to bHardlinkIsSet
            Send AssertFalse bHardlinkIsSet "ClearHardlink"
            Get psHardlink of oEntry to sHardlink
            Send AssertSAreEqual "" sHardlink "hard link removed"
            Set psHardlink of oEntry to "again.txt"
            Set psHardlink of oEntry to ""
            Get pbHardlinkIsSet of oEntry to bHardlinkIsSet
            Send AssertFalse bHardlinkIsSet "empty string removes the hard link"

            // invalid UTF-8 in the link setter
            Send ExpectError DFERR_PROGRAM
            Get InvalidUtf8 to sInvalidUtf8
            Set psLink of oEntry to sInvalidUtf8
            Send UnExpectError DFERR_PROGRAM
        End_Procedure
    End_Object

    // ---- times --------------------------------------------------------------------------------------------------

    Object oTimesTest is a cTest
        Procedure Test
            Boolean bAtimeIsSet bBirthtimeIsSet bCtimeIsSet bMtimeIsSet
            BigInt biAtime biBirthtime biCtime biMtime
            Integer iAtimeNsec iBirthtimeNsec iCtimeNsec iMtimeNsec
            Pointer pEntry

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry

            // atime
            Get pbAtimeIsSet of oEntry to bAtimeIsSet
            Send AssertFalse bAtimeIsSet "atime not set"
            Set piAtime of oEntry to 1700000100
            Get pbAtimeIsSet of oEntry to bAtimeIsSet
            Send Assert bAtimeIsSet "atime set"
            Get piAtime of oEntry to biAtime
            Send AssertBIAreEqual 1700000100 biAtime "atime seconds"
            Send AssertBIAreEqual 1700000100 (archive_entry_atime (pEntry)) "raw atime"
            Get piAtimeNsec of oEntry to iAtimeNsec
            Send AssertIAreEqual 0 iAtimeNsec "atime nsec 0"
            Set piAtimeNsec of oEntry to 123456789
            Get piAtimeNsec of oEntry to iAtimeNsec
            Send AssertIAreEqual 123456789 iAtimeNsec "atime nsec"
            Get piAtime of oEntry to biAtime
            Send AssertBIAreEqual 1700000100 biAtime "seconds kept when nsec set"
            Send SetAtime of oEntry 1800000000 5
            Get piAtime of oEntry to biAtime
            Send AssertBIAreEqual 1800000000 biAtime "SetAtime seconds"
            Get piAtimeNsec of oEntry to iAtimeNsec
            Send AssertIAreEqual 5 iAtimeNsec "SetAtime nsec"
            Send UnsetAtime of oEntry
            Get pbAtimeIsSet of oEntry to bAtimeIsSet
            Send AssertFalse bAtimeIsSet "UnsetAtime"

            // birthtime
            Get pbBirthtimeIsSet of oEntry to bBirthtimeIsSet
            Send AssertFalse bBirthtimeIsSet "birthtime not set"
            Set piBirthtime of oEntry to 1600000000
            Get pbBirthtimeIsSet of oEntry to bBirthtimeIsSet
            Send Assert bBirthtimeIsSet "birthtime set"
            Get piBirthtime of oEntry to biBirthtime
            Send AssertBIAreEqual 1600000000 biBirthtime "birthtime seconds"
            Send AssertBIAreEqual 1600000000 (archive_entry_birthtime (pEntry)) "raw birthtime"
            Set piBirthtimeNsec of oEntry to 987654321
            Get piBirthtimeNsec of oEntry to iBirthtimeNsec
            Send AssertIAreEqual 987654321 iBirthtimeNsec "birthtime nsec"
            Get piBirthtime of oEntry to biBirthtime
            Send AssertBIAreEqual 1600000000 biBirthtime "birthtime seconds kept"
            Send SetBirthtime of oEntry 1610000000 6
            Get piBirthtime of oEntry to biBirthtime
            Send AssertBIAreEqual 1610000000 biBirthtime "SetBirthtime seconds"
            Get piBirthtimeNsec of oEntry to iBirthtimeNsec
            Send AssertIAreEqual 6 iBirthtimeNsec "SetBirthtime nsec"
            Send UnsetBirthtime of oEntry
            Get pbBirthtimeIsSet of oEntry to bBirthtimeIsSet
            Send AssertFalse bBirthtimeIsSet "UnsetBirthtime"

            // ctime
            Get pbCtimeIsSet of oEntry to bCtimeIsSet
            Send AssertFalse bCtimeIsSet "ctime not set"
            Set piCtime of oEntry to 1500000000
            Get pbCtimeIsSet of oEntry to bCtimeIsSet
            Send Assert bCtimeIsSet "ctime set"
            Get piCtime of oEntry to biCtime
            Send AssertBIAreEqual 1500000000 biCtime "ctime seconds"
            Send AssertBIAreEqual 1500000000 (archive_entry_ctime (pEntry)) "raw ctime"
            Set piCtimeNsec of oEntry to 111222333
            Get piCtimeNsec of oEntry to iCtimeNsec
            Send AssertIAreEqual 111222333 iCtimeNsec "ctime nsec"
            Get piCtime of oEntry to biCtime
            Send AssertBIAreEqual 1500000000 biCtime "ctime seconds kept"
            Send SetCtime of oEntry 1510000000 7
            Get piCtime of oEntry to biCtime
            Send AssertBIAreEqual 1510000000 biCtime "SetCtime seconds"
            Get piCtimeNsec of oEntry to iCtimeNsec
            Send AssertIAreEqual 7 iCtimeNsec "SetCtime nsec"
            Send UnsetCtime of oEntry
            Get pbCtimeIsSet of oEntry to bCtimeIsSet
            Send AssertFalse bCtimeIsSet "UnsetCtime"

            // mtime
            Get pbMtimeIsSet of oEntry to bMtimeIsSet
            Send AssertFalse bMtimeIsSet "mtime not set"
            Set piMtime of oEntry to 1700000000
            Get pbMtimeIsSet of oEntry to bMtimeIsSet
            Send Assert bMtimeIsSet "mtime set"
            Get piMtime of oEntry to biMtime
            Send AssertBIAreEqual 1700000000 biMtime "mtime seconds"
            Send AssertBIAreEqual 1700000000 (archive_entry_mtime (pEntry)) "raw mtime"
            Set piMtimeNsec of oEntry to 444555666
            Get piMtimeNsec of oEntry to iMtimeNsec
            Send AssertIAreEqual 444555666 iMtimeNsec "mtime nsec"
            Get piMtime of oEntry to biMtime
            Send AssertBIAreEqual 1700000000 biMtime "mtime seconds kept"
            Send SetMtime of oEntry 1710000000 8
            Get piMtime of oEntry to biMtime
            Send AssertBIAreEqual 1710000000 biMtime "SetMtime seconds"
            Get piMtimeNsec of oEntry to iMtimeNsec
            Send AssertIAreEqual 8 iMtimeNsec "SetMtime nsec"
            Send UnsetMtime of oEntry
            Get pbMtimeIsSet of oEntry to bMtimeIsSet
            Send AssertFalse bMtimeIsSet "UnsetMtime"

            // the four times are independent
            Send SetAtime of oEntry 1 1
            Send SetBirthtime of oEntry 2 2
            Send SetCtime of oEntry 3 3
            Send SetMtime of oEntry 4 4
            Get piAtime of oEntry to biAtime
            Send AssertBIAreEqual 1 biAtime "independent atime"
            Get piBirthtime of oEntry to biBirthtime
            Send AssertBIAreEqual 2 biBirthtime "independent birthtime"
            Get piCtime of oEntry to biCtime
            Send AssertBIAreEqual 3 biCtime "independent ctime"
            Get piMtime of oEntry to biMtime
            Send AssertBIAreEqual 4 biMtime "independent mtime"
        End_Procedure
    End_Object

    // ---- device, inode, link count -------------------------------------------------------------------------------

    Object oDeviceInodeTest is a cTest
        Procedure Test
            Boolean bDevIsSet bInoIsSet bRdevIsSet
            UInteger iDev iDevMajor iDevMinor iNlink iRdev iRdevMajor iRdevMinor
            BigInt biIno biInoLegacy
            Pointer pEntry

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry
            Get pbDevIsSet of oEntry to bDevIsSet
            Send AssertFalse bDevIsSet "dev not set"
            Get pbInoIsSet of oEntry to bInoIsSet
            Send AssertFalse bInoIsSet "ino not set"
            Get pbRdevIsSet of oEntry to bRdevIsSet
            Send AssertFalse bRdevIsSet "rdev not set"

            Set piDev of oEntry to 12345
            Get pbDevIsSet of oEntry to bDevIsSet
            Send Assert bDevIsSet "dev set"
            Get piDev of oEntry to iDev
            Send AssertUIAreEqual 12345 iDev "dev"
            Send AssertUIAreEqual 12345 (archive_entry_dev (pEntry)) "raw dev"

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry
            Set piDevMajor of oEntry to 8
            Set piDevMinor of oEntry to 17
            Get piDevMajor of oEntry to iDevMajor
            Send AssertUIAreEqual 8 iDevMajor "dev major"
            Get piDevMinor of oEntry to iDevMinor
            Send AssertUIAreEqual 17 iDevMinor "dev minor"
            Send AssertUIAreEqual 8 (archive_entry_devmajor (pEntry)) "raw dev major"
            Send AssertUIAreEqual 17 (archive_entry_devminor (pEntry)) "raw dev minor"

            Set piIno of oEntry to 5000000000
            Get pbInoIsSet of oEntry to bInoIsSet
            Send Assert bInoIsSet "ino set"
            Get piIno of oEntry to biIno
            Send AssertBIAreEqual 5000000000 biIno "64 bit ino"
            Send AssertBIAreEqual 5000000000 (archive_entry_ino64 (pEntry)) "raw ino64"
            Set piInoLegacy of oEntry to 777
            Get piInoLegacy of oEntry to biInoLegacy
            Send AssertBIAreEqual 777 biInoLegacy "legacy ino"
            Get piIno of oEntry to biIno
            Send AssertBIAreEqual 777 biIno "legacy ino visible as 64 bit"
            Send AssertBIAreEqual 777 (archive_entry_ino (pEntry)) "raw ino"

            Set piNlink of oEntry to 3
            Get piNlink of oEntry to iNlink
            Send AssertUIAreEqual 3 iNlink "nlink"
            Send AssertUIAreEqual 3 (archive_entry_nlink (pEntry)) "raw nlink"

            Set piRdev of oEntry to 513
            Get pbRdevIsSet of oEntry to bRdevIsSet
            Send Assert bRdevIsSet "rdev set"
            Get piRdev of oEntry to iRdev
            Send AssertUIAreEqual 513 iRdev "rdev"
            Send AssertUIAreEqual 513 (archive_entry_rdev (pEntry)) "raw rdev"

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry
            Set piRdevMajor of oEntry to 4
            Set piRdevMinor of oEntry to 2
            Get piRdevMajor of oEntry to iRdevMajor
            Send AssertUIAreEqual 4 iRdevMajor "rdev major"
            Get piRdevMinor of oEntry to iRdevMinor
            Send AssertUIAreEqual 2 iRdevMinor "rdev minor"
            Send AssertUIAreEqual 4 (archive_entry_rdevmajor (pEntry)) "raw rdev major"
            Send AssertUIAreEqual 2 (archive_entry_rdevminor (pEntry)) "raw rdev minor"
        End_Procedure
    End_Object

    // ---- type, mode, size, owner ----------------------------------------------------------------------------------

    Object oModeTest is a cTest
        Procedure Test
            Boolean bFileTypeIsSet bPermIsSet
            Integer eFileType iPerm iMode
            String sStrMode
            Pointer pEntry

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry
            Get pbFileTypeIsSet of oEntry to bFileTypeIsSet
            Send AssertFalse bFileTypeIsSet "file type not set"
            Get pbPermIsSet of oEntry to bPermIsSet
            Send AssertFalse bPermIsSet "perm not set"

            Set peFileType of oEntry to AE_IFREG
            Get pbFileTypeIsSet of oEntry to bFileTypeIsSet
            Send Assert bFileTypeIsSet "file type set"
            Get peFileType of oEntry to eFileType
            Send AssertIAreEqual AE_IFREG eFileType "file type"
            Send AssertIAreEqual AE_IFREG (archive_entry_filetype (pEntry)) "raw file type"
            Set piPerm of oEntry to 420
            Get pbPermIsSet of oEntry to bPermIsSet
            Send Assert bPermIsSet "perm set"
            Get piPerm of oEntry to iPerm
            Send AssertIAreEqual 420 iPerm "perm"
            Send AssertIAreEqual 420 (archive_entry_perm (pEntry)) "raw perm"
            Get piMode of oEntry to iMode
            Send AssertIAreEqual (AE_IFREG ior 420) iMode "mode combines type and perm"
            Send AssertIAreEqual (AE_IFREG ior 420) (archive_entry_mode (pEntry)) "raw mode"
            Get psStrMode of oEntry to sStrMode
            Send AssertSAreEqual "-rw-r--r-- " sStrMode "strmode of a regular file"

            Set piMode of oEntry to (AE_IFDIR ior 493)
            Get peFileType of oEntry to eFileType
            Send AssertIAreEqual AE_IFDIR eFileType "mode sets the type"
            Get piPerm of oEntry to iPerm
            Send AssertIAreEqual 493 iPerm "mode sets the perm"
            Get psStrMode of oEntry to sStrMode
            Send AssertSAreEqual "drwxr-xr-x " sStrMode "strmode of a directory"

            Set peFileType of oEntry to AE_IFLNK
            Get peFileType of oEntry to eFileType
            Send AssertIAreEqual AE_IFLNK eFileType "symlink type"
            Get piPerm of oEntry to iPerm
            Send AssertIAreEqual 493 iPerm "perm kept when type changes"
        End_Procedure
    End_Object

    Object oSizeOwnerTest is a cTest
        Procedure Test
            Boolean bSizeIsSet bUidIsSet bGidIsSet bDataEncrypted bMetadataEncrypted bEncrypted
            BigInt biSize biUid biGid
            Pointer pEntry

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry

            Get pbSizeIsSet of oEntry to bSizeIsSet
            Send AssertFalse bSizeIsSet "size not set"
            Set piSize of oEntry to 5000000000
            Get pbSizeIsSet of oEntry to bSizeIsSet
            Send Assert bSizeIsSet "size set"
            Get piSize of oEntry to biSize
            Send AssertBIAreEqual 5000000000 biSize "size beyond 32 bit"
            Send AssertBIAreEqual 5000000000 (archive_entry_size (pEntry)) "raw size"
            Send UnsetSize of oEntry
            Get pbSizeIsSet of oEntry to bSizeIsSet
            Send AssertFalse bSizeIsSet "UnsetSize"

            Get pbUidIsSet of oEntry to bUidIsSet
            Send AssertFalse bUidIsSet "uid not set"
            Get pbGidIsSet of oEntry to bGidIsSet
            Send AssertFalse bGidIsSet "gid not set"
            Set piUid of oEntry to 1000
            Set piGid of oEntry to 2000
            Get pbUidIsSet of oEntry to bUidIsSet
            Send Assert bUidIsSet "uid set"
            Get pbGidIsSet of oEntry to bGidIsSet
            Send Assert bGidIsSet "gid set"
            Get piUid of oEntry to biUid
            Send AssertBIAreEqual 1000 biUid "uid"
            Get piGid of oEntry to biGid
            Send AssertBIAreEqual 2000 biGid "gid"
            Send AssertBIAreEqual 1000 (archive_entry_uid (pEntry)) "raw uid"
            Send AssertBIAreEqual 2000 (archive_entry_gid (pEntry)) "raw gid"

            // encryption flags
            Get pbDataEncrypted of oEntry to bDataEncrypted
            Send AssertFalse bDataEncrypted "data not encrypted"
            Get pbMetadataEncrypted of oEntry to bMetadataEncrypted
            Send AssertFalse bMetadataEncrypted "metadata not encrypted"
            Get pbEncrypted of oEntry to bEncrypted
            Send AssertFalse bEncrypted "not encrypted"
            Set pbDataEncrypted of oEntry to True
            Get pbDataEncrypted of oEntry to bDataEncrypted
            Send Assert bDataEncrypted "data encrypted"
            Get pbMetadataEncrypted of oEntry to bMetadataEncrypted
            Send AssertFalse bMetadataEncrypted "metadata still plain"
            Get pbEncrypted of oEntry to bEncrypted
            Send Assert bEncrypted "encrypted when data is"
            Send Assert (archive_entry_is_data_encrypted (pEntry) = 1) "raw data encrypted flag"
            Set pbDataEncrypted of oEntry to False
            Get pbEncrypted of oEntry to bEncrypted
            Send AssertFalse bEncrypted "plain again"
            Set pbMetadataEncrypted of oEntry to True
            Get pbMetadataEncrypted of oEntry to bMetadataEncrypted
            Send Assert bMetadataEncrypted "metadata encrypted"
            Get pbDataEncrypted of oEntry to bDataEncrypted
            Send AssertFalse bDataEncrypted "data still plain"
            Get pbEncrypted of oEntry to bEncrypted
            Send Assert bEncrypted "encrypted when metadata is"
            Send Assert (archive_entry_is_metadata_encrypted (pEntry) = 1) "raw metadata encrypted flag"
        End_Procedure
    End_Object

    // ---- file flags ---------------------------------------------------------------------------------------------
    // The file flag names are platform dependent in libarchive; on Windows they map to file attributes
    // ("hidden" = FILE_ATTRIBUTE_HIDDEN 2, "rdonly" = FILE_ATTRIBUTE_READONLY 1, "system" = 4).

    Object oFFlagsTest is a cTest
        Procedure Test
            UInteger iFFlagsSet iFFlagsClear
            String sFFlagsText
            Pointer pEntry
            UInteger iSet iClear
            String sBad
            Void_Type iVoid

            Send CreateEntry of oEntry
            Get ppEntry of oEntry to pEntry
            Get piFFlagsSet of oEntry to iFFlagsSet
            Send AssertUIAreEqual 0 iFFlagsSet "no flags set"
            Get piFFlagsClear of oEntry to iFFlagsClear
            Send AssertUIAreEqual 0 iFFlagsClear "no flags cleared"
            Get psFFlagsText of oEntry to sFFlagsText
            Send AssertSAreEqual "" sFFlagsText "no flags text"

            Send SetFFlags of oEntry 6 9
            Get piFFlagsSet of oEntry to iFFlagsSet
            Send AssertUIAreEqual 6 iFFlagsSet "set bits"
            Get piFFlagsClear of oEntry to iFFlagsClear
            Send AssertUIAreEqual 9 iFFlagsClear "clear bits"
            Move (archive_entry_fflags (pEntry, AddressOf (iSet), AddressOf (iClear))) to iVoid
            Send AssertUIAreEqual 6 iSet "raw set bits"
            Send AssertUIAreEqual 9 iClear "raw clear bits"
            Set piFFlagsSet of oEntry to 3
            Get piFFlagsSet of oEntry to iFFlagsSet
            Send AssertUIAreEqual 3 iFFlagsSet "set bits changed"
            Get piFFlagsClear of oEntry to iFFlagsClear
            Send AssertUIAreEqual 9 iFFlagsClear "clear bits kept"
            Set piFFlagsClear of oEntry to 12
            Get piFFlagsSet of oEntry to iFFlagsSet
            Send AssertUIAreEqual 3 iFFlagsSet "set bits kept"
            Get piFFlagsClear of oEntry to iFFlagsClear
            Send AssertUIAreEqual 12 iFFlagsClear "clear bits changed"

            // text
            Send SetFFlags of oEntry 0 0
            Get CopyFFlagsText of oEntry "nohidden" to sBad
            Send AssertSAreEqual "" sBad "valid flag text"
            Get piFFlagsSet of oEntry to iFFlagsSet
            Send AssertUIAreEqual 0 iFFlagsSet "nohidden sets nothing"
            Get piFFlagsClear of oEntry to iFFlagsClear
            Send AssertUIAreEqual 2 iFFlagsClear "nohidden clears bit 2"
            Get psFFlagsText of oEntry to sFFlagsText
            Send AssertSAreEqual "nohidden" sFFlagsText "flags text"
            Get CopyFFlagsText of oEntry "hidden" to sBad
            Send AssertSAreEqual "" sBad "valid positive flag text"
            Get piFFlagsSet of oEntry to iFFlagsSet
            Send AssertUIAreEqual 2 iFFlagsSet "hidden sets bit 2"
            Get piFFlagsClear of oEntry to iFFlagsClear
            Send AssertUIAreEqual 0 iFFlagsClear "hidden clears nothing"
            Get CopyFFlagsText of oEntry "bogusflag" to sBad
            Send AssertSAreEqual "bogusflag" sBad "invalid token returned"
            Get CopyFFlagsTextLen of oEntry "nordonly,nosystem" 8 to sBad
            Send AssertSAreEqual "" sBad "valid text with length"
            Get piFFlagsClear of oEntry to iFFlagsClear
            Send AssertUIAreEqual 1 iFFlagsClear "only the first 8 bytes used"
            Get CopyFFlagsText of oEntry "nosystem" to sBad
            Send AssertSAreEqual "" sBad "valid wide text"
            Get piFFlagsClear of oEntry to iFFlagsClear
            Send AssertUIAreEqual 4 iFFlagsClear "wide text clears bit 4"
            Get CopyFFlagsText of oEntry "wrongflag" to sBad
            Send AssertSAreEqual "wrongflag" sBad "invalid wide token returned"
            Set psFFlagsText of oEntry to "hidden"
            Get piFFlagsSet of oEntry to iFFlagsSet
            Send AssertUIAreEqual 2 iFFlagsSet "text setter"
            Send ExpectError DFERR_PROGRAM
            Set psFFlagsText of oEntry to "unknownflag"
            Send UnExpectError DFERR_PROGRAM
            Get CopyFFlagsText of oEntry "" to sBad
            Get piFFlagsSet of oEntry to iFFlagsSet
            Send AssertUIAreEqual 0 iFFlagsSet "empty text clears the flags"
        End_Procedure
    End_Object

    // ---- stat and platform data -------------------------------------------------------------------------------------

    Object oStatTest is a cTest
        Procedure Test
            BigInt biSize biUid biGid biMtime biAtime biIno
            Integer iMode
            UInteger iNlink
            Pointer pStat
            UChar[] ucInfo

            Send CreateEntry of oEntry
            Set piSize of oEntry to 4321
            Set piMode of oEntry to (AE_IFREG ior 420)
            Set piUid of oEntry to 7
            Set piGid of oEntry to 8
            Send SetMtime of oEntry 1700000000 0
            Send SetAtime of oEntry 1700000100 0
            Get StatPointer of oEntry to pStat
            Send Assert (pStat <> 0) "stat pointer"

            Send CreateEntry of oEntry2
            Send CopyStat of oEntry2 pStat
            Get piSize of oEntry2 to biSize
            Send AssertBIAreEqual 4321 biSize "stat size"
            Get piMode of oEntry2 to iMode
            Send AssertIAreEqual (AE_IFREG ior 420) iMode "stat mode"
            Get piUid of oEntry2 to biUid
            Send AssertBIAreEqual 7 biUid "stat uid"
            Get piGid of oEntry2 to biGid
            Send AssertBIAreEqual 8 biGid "stat gid"
            Get piMtime of oEntry2 to biMtime
            Send AssertBIAreEqual 1700000000 biMtime "stat mtime"
            Get piAtime of oEntry2 to biAtime
            Send AssertBIAreEqual 1700000100 biAtime "stat atime"

            // BY_HANDLE_FILE_INFORMATION: attributes, 3 FILETIMEs (creation, access, write), volume serial,
            // size high/low, link count, index high/low.
            Move (ResizeArray (ucInfo, 52)) to ucInfo
            Send PutUInt32 (&ucInfo) 4 3329032192
            Send PutUInt32 (&ucInfo) 8 31070023
            Send PutUInt32 (&ucInfo) 12 34064896
            Send PutUInt32 (&ucInfo) 16 31070024
            Send PutUInt32 (&ucInfo) 20 3329032192
            Send PutUInt32 (&ucInfo) 24 31070023
            Send PutUInt32 (&ucInfo) 28 99
            Send PutUInt32 (&ucInfo) 32 0
            Send PutUInt32 (&ucInfo) 36 1234
            Send PutUInt32 (&ucInfo) 40 2
            Send PutUInt32 (&ucInfo) 44 0
            Send PutUInt32 (&ucInfo) 48 4242
            Send CreateEntry of oEntry2
            Send CopyBhfi of oEntry2 (AddressOf (ucInfo))
            Get piAtime of oEntry2 to biAtime
            Send AssertBIAreEqual 1700000100 biAtime "bhfi atime"
            Get piMtime of oEntry2 to biMtime
            Send AssertBIAreEqual 1700000000 biMtime "bhfi mtime"
            Get piSize of oEntry2 to biSize
            Send AssertBIAreEqual 1234 biSize "bhfi size"
            Get piIno of oEntry2 to biIno
            Send AssertBIAreEqual 4242 biIno "bhfi ino"
            Get piNlink of oEntry2 to iNlink
            Send AssertUIAreEqual 2 iNlink "bhfi link count"
        End_Procedure
    End_Object

    Object oMacMetadataTest is a cTest
        Procedure Test
            UChar[] ucData ucResult
            Integer iIndex

            Send CreateEntry of oEntry
            Get MacMetadata of oEntry to ucResult
            Send AssertIAreEqual 0 (SizeOfArray (ucResult)) "no mac metadata"
            Move (ResizeArray (ucData, 10)) to ucData
            For iIndex from 0 to 9
                Move (iIndex * 3 + 1) to ucData[iIndex]
            Loop
            Send SetMacMetadata of oEntry ucData
            Get MacMetadata of oEntry to ucResult
            Send AssertIAreEqual 10 (SizeOfArray (ucResult)) "mac metadata size"
            For iIndex from 0 to 9
                Send AssertIAreEqual (iIndex * 3 + 1) ucResult[iIndex] "mac metadata byte"
            Loop
            Move (ResizeArray (ucData, 0)) to ucData
            Send SetMacMetadata of oEntry ucData
            Get MacMetadata of oEntry to ucResult
            Send AssertIAreEqual 0 (SizeOfArray (ucResult)) "mac metadata removed"
        End_Procedure
    End_Object

    // ---- digest (provided by the mtree reader) ----------------------------------------------------------------------

    Object oDigestTest is a cTest
        Procedure Test
            String sPathname
            String sDigest
            Integer iDigestLength
            Pointer pArchive pEntry
            Integer iResult
            String sMtree

            Send CreateEntry of oEntry
            Get Digest of oEntry ARCHIVE_ENTRY_DIGEST_MD5 to sDigest
            Send AssertSAreEqual "" sDigest "no digest in a new entry"
            Get DigestLength of oEntry ARCHIVE_ENTRY_DIGEST_MD5 to iDigestLength
            Send AssertIAreEqual 16 iDigestLength "MD5 length"
            Get DigestLength of oEntry ARCHIVE_ENTRY_DIGEST_SHA1 to iDigestLength
            Send AssertIAreEqual 20 iDigestLength "SHA1 length"
            Get DigestLength of oEntry ARCHIVE_ENTRY_DIGEST_RMD160 to iDigestLength
            Send AssertIAreEqual 20 iDigestLength "RMD160 length"
            Get DigestLength of oEntry ARCHIVE_ENTRY_DIGEST_SHA256 to iDigestLength
            Send AssertIAreEqual 32 iDigestLength "SHA256 length"
            Get DigestLength of oEntry ARCHIVE_ENTRY_DIGEST_SHA384 to iDigestLength
            Send AssertIAreEqual 48 iDigestLength "SHA384 length"
            Get DigestLength of oEntry ARCHIVE_ENTRY_DIGEST_SHA512 to iDigestLength
            Send AssertIAreEqual 64 iDigestLength "SHA512 length"
            Get DigestLength of oEntry 99 to iDigestLength
            Send AssertIAreEqual 0 iDigestLength "unknown type length"

            Move ("#mtree" + (Character (10)) + "./data.bin type=file size=3 md5digest=d41d8cd98f00b204e9800998ecf8427e sha1digest=da39a3ee5e6b4b0d3255bfef95601890afd80709" + (Character (10))) to sMtree
            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_mtree (pArchive)) to iResult
            Move (archive_read_open_memory (pArchive, AddressOf (sMtree), SizeOfString (sMtree))) to iResult
            Send AssertArchiveOk iResult pArchive "open mtree"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertArchiveOk iResult pArchive "read mtree header"
            Send AttachEntry of oBorrowed pEntry False
            Get psPathname of oBorrowed to sPathname
            Send AssertSAreEqual "./data.bin" sPathname "mtree entry name"
            Get Digest of oBorrowed ARCHIVE_ENTRY_DIGEST_MD5 to sDigest
            Send AssertSAreEqual "d41d8cd98f00b204e9800998ecf8427e" sDigest "MD5 digest"
            Get Digest of oBorrowed ARCHIVE_ENTRY_DIGEST_SHA1 to sDigest
            Send AssertSAreEqual "da39a3ee5e6b4b0d3255bfef95601890afd80709" sDigest "SHA1 digest"
            Get Digest of oBorrowed ARCHIVE_ENTRY_DIGEST_SHA256 to sDigest
            Send AssertSAreEqual "" sDigest "no SHA256 digest"
            Get Digest of oBorrowed 99 to sDigest
            Send AssertSAreEqual "" sDigest "unknown digest type"
            Send FreeEntry of oBorrowed
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    // ---- ACL ----------------------------------------------------------------------------------------------------

    Object oAclPosixTest is a cTest
        Procedure Test
            Integer iPerm
            Integer iAclTypes iAclCount
            Pointer pAclPointer
            Integer iResult iCount iIndex
            tArchiveEntryAcl stAcl
            tArchiveEntryAcl[] astAcl
            String sText

            Send CreateEntry of oEntry
            Set piMode of oEntry to (AE_IFREG ior 420)
            Get AclTypes of oEntry to iAclTypes
            Send AssertIAreEqual 0 iAclTypes "no ACL yet"
            Get AclCount of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to iAclCount
            Send AssertIAreEqual 0 iAclCount "no ACL entries"
            Get AclPointer of oEntry to pAclPointer
            Send Assert (pAclPointer <> 0) "ACL object pointer"

            Get AclAddEntry of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS 6 ARCHIVE_ENTRY_ACL_USER 1010 "bob" to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "add user entry"
            Get AclAddEntry of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS 4 ARCHIVE_ENTRY_ACL_GROUP 2020 "staff" to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "add group entry"
            Get AclAddEntry of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS 6 ARCHIVE_ENTRY_ACL_MASK 0 "" to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "add mask entry"
            Get AclTypes of oEntry to iAclTypes
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_TYPE_ACCESS iAclTypes "ACL types"
            // user, group, mask + the owner/group/other entries of the mode
            Get AclCount of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to iAclCount
            Send AssertIAreEqual 6 iAclCount "ACL count"
            Get AclCount of oEntry ARCHIVE_ENTRY_ACL_TYPE_DEFAULT to iAclCount
            Send AssertIAreEqual 0 iAclCount "no default ACL"

            Get AclReset of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to iCount
            Send AssertIAreEqual 6 iCount "AclReset count"
            Get AclNext of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to stAcl
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_TYPE_ACCESS stAcl.eType "first entry type"
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_USER_OBJ stAcl.eTag "first entry is the owner"
            Send AssertIAreEqual 6 stAcl.iPermset "owner rw- from the mode"

            Get AclEntries of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to astAcl
            Send AssertIAreEqual 6 (SizeOfArray (astAcl)) "AclEntries count"
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_GROUP_OBJ astAcl[1].eTag "second entry is the owning group"
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_OTHER astAcl[2].eTag "third entry is other"
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_USER astAcl[3].eTag "first extended entry tag"
            Send AssertIAreEqual 1010 astAcl[3].iQualifier "user qualifier"
            Send AssertSAreEqual "bob" astAcl[3].sName "user name"
            Send AssertIAreEqual 6 astAcl[3].iPermset "user permset"
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_GROUP astAcl[4].eTag "second extended entry tag"
            Send AssertIAreEqual 2020 astAcl[4].iQualifier "group qualifier"
            Send AssertSAreEqual "staff" astAcl[4].sName "group name"
            Send AssertIAreEqual 4 astAcl[4].iPermset "group permset"
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_MASK astAcl[5].eTag "last entry is the mask"

            // enumeration end
            Get AclReset of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to iCount
            For iIndex from 1 to 6
                Get AclNext of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to stAcl
                Send Assert (stAcl.eType <> 0) "entry of the enumeration"
            Loop
            Get AclNext of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to stAcl
            Send AssertIAreEqual 0 stAcl.eType "AclNext ends after the last entry"

            // text
            Get AclToText of oEntry (ARCHIVE_ENTRY_ACL_TYPE_ACCESS ior ARCHIVE_ENTRY_ACL_STYLE_SEPARATOR_COMMA) to sText
            Send AssertSAreEqual "user::rw-,group::r--,other::r--,user:bob:rw-,group:staff:r--,mask::rw-" sText "ACL text"
            Get AclToText of oEntry (ARCHIVE_ENTRY_ACL_TYPE_ACCESS ior ARCHIVE_ENTRY_ACL_STYLE_SEPARATOR_COMMA ior ARCHIVE_ENTRY_ACL_STYLE_EXTRA_ID) to sText
            Send AssertSAreEqual "user::rw-,group::r--,other::r--,user:bob:rw-:1010,group:staff:r--:2020,mask::rw-" sText "ACL text with ids"
            Get AclToText of oEntry (ARCHIVE_ENTRY_ACL_TYPE_ACCESS ior ARCHIVE_ENTRY_ACL_STYLE_SEPARATOR_COMMA) to sText
            Send AssertSAreEqual "user::rw-,group::r--,other::r--,user:bob:rw-,group:staff:r--,mask::rw-" sText "ACL wide text"
            Get AclToText of oEntry ARCHIVE_ENTRY_ACL_TYPE_DEFAULT to sText
            Send AssertSAreEqual "" sText "no default ACL text"
            Get AclTextLegacy of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to sText
            Send Assert (Pos ("user:bob:", sText) > 0) "legacy ACL text mentions bob"
            Get AclTextLegacy of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to sText
            Send Assert (Pos ("user:bob:", sText) > 0) "legacy wide ACL text mentions bob"

            // clear and parse from text
            Send AclClear of oEntry
            Get AclTypes of oEntry to iAclTypes
            Send AssertIAreEqual 0 iAclTypes "ACL cleared"
            Get AclCount of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to iAclCount
            Send AssertIAreEqual 0 iAclCount "no entries after clear"
            Get AclFromText of oEntry "user::rwx,user:alice:r-x,group::r-x,mask::r-x,other::r-x" ARCHIVE_ENTRY_ACL_TYPE_ACCESS to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "ACL from text"
            Get AclTypes of oEntry to iAclTypes
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_TYPE_ACCESS iAclTypes "types after from text"
            Get AclCount of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to iAclCount
            Send AssertIAreEqual 5 iAclCount "count after from text"
            Get AclEntries of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to astAcl
            Send AssertSAreEqual "alice" astAcl[3].sName "parsed user name"
            Send AssertIAreEqual 5 astAcl[3].iPermset "parsed user permset r-x"
            Get piPerm of oEntry to iPerm
            Send AssertIAreEqual 493 iPerm "owner/group/other went into the mode (rwxr-xr-x)"
            Send AclClear of oEntry
            Get AclFromText of oEntry "user::rw-,user:dora:r--,group::r--,mask::rw-,other::---" ARCHIVE_ENTRY_ACL_TYPE_ACCESS to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "ACL from wide text"
            Get AclEntries of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to astAcl
            Send AssertSAreEqual "dora" astAcl[3].sName "parsed wide user name"

            // the wide add variant
            Send AclClear of oEntry
            Get AclAddEntry of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS 6 ARCHIVE_ENTRY_ACL_USER 1011 "Jürgen" to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "wide add"
            Get AclEntries of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to astAcl
            Move astAcl[SizeOfArray (astAcl) - 1] to stAcl
            Send AssertSAreEqual "Jürgen" stAcl.sName "wide name round trip"

            // errors
            Send AclClear of oEntry
            Send ExpectError DFERR_PROGRAM
            Get AclAddEntry of oEntry 12345 6 ARCHIVE_ENTRY_ACL_USER 1 "x" to iResult
            Send UnExpectError DFERR_PROGRAM
            Send AssertIAreEqual ARCHIVE_FAILED iResult "invalid ACL type"
            Set pbRaiseErrors of oEntry to False
            Get AclAddEntry of oEntry 12345 6 ARCHIVE_ENTRY_ACL_USER 1 "x" to iResult
            Send AssertIAreEqual ARCHIVE_FAILED iResult "invalid ACL type without errors"
            Set pbRaiseErrors of oEntry to True
        End_Procedure
    End_Object

    Object oAclNfs4Test is a cTest
        Procedure Test
            Integer iAclTypes iAclCount
            Integer iResult
            tArchiveEntryAcl[] astAcl
            String sText

            Send CreateEntry of oEntry
            Get AclAddEntry of oEntry ARCHIVE_ENTRY_ACL_TYPE_ALLOW (ARCHIVE_ENTRY_ACL_READ_DATA ior ARCHIVE_ENTRY_ACL_EXECUTE) ARCHIVE_ENTRY_ACL_EVERYONE 0 "" to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "add NFSv4 entry"
            Get AclAddEntry of oEntry ARCHIVE_ENTRY_ACL_TYPE_DENY ARCHIVE_ENTRY_ACL_WRITE_DATA ARCHIVE_ENTRY_ACL_USER 500 "mallory" to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "add NFSv4 deny entry"
            Get AclTypes of oEntry to iAclTypes
            Send AssertIAreEqual (ARCHIVE_ENTRY_ACL_TYPE_ALLOW ior ARCHIVE_ENTRY_ACL_TYPE_DENY) iAclTypes "NFSv4 types"
            Get AclCount of oEntry ARCHIVE_ENTRY_ACL_TYPE_NFS4 to iAclCount
            Send AssertIAreEqual 2 iAclCount "NFSv4 count"
            Get AclCount of oEntry ARCHIVE_ENTRY_ACL_TYPE_DENY to iAclCount
            Send AssertIAreEqual 1 iAclCount "NFSv4 deny count"
            Get AclCount of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS to iAclCount
            Send AssertIAreEqual 0 iAclCount "no POSIX entries"
            Get AclEntries of oEntry ARCHIVE_ENTRY_ACL_TYPE_NFS4 to astAcl
            Send AssertIAreEqual 2 (SizeOfArray (astAcl)) "NFSv4 entries"
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_TYPE_ALLOW astAcl[0].eType "allow type"
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_EVERYONE astAcl[0].eTag "everyone tag"
            Send AssertIAreEqual (ARCHIVE_ENTRY_ACL_READ_DATA ior ARCHIVE_ENTRY_ACL_EXECUTE) astAcl[0].iPermset "allow permset"
            Send AssertIAreEqual ARCHIVE_ENTRY_ACL_TYPE_DENY astAcl[1].eType "deny type"
            Send AssertSAreEqual "mallory" astAcl[1].sName "deny name"
            Get AclToText of oEntry (ARCHIVE_ENTRY_ACL_TYPE_NFS4 ior ARCHIVE_ENTRY_ACL_STYLE_SEPARATOR_COMMA) to sText
            Send Assert (Pos ("everyone@:", sText) = 1) "NFSv4 text starts with everyone@"
            Send Assert (Pos (":allow", sText) > 0) "NFSv4 text has allow"
            Send Assert (Pos ("user:mallory:", sText) > 0) "NFSv4 text has mallory"
            Send Assert (Pos (":deny", sText) > 0) "NFSv4 text has deny"
            Send AclClear of oEntry
            Get AclFromText of oEntry sText ARCHIVE_ENTRY_ACL_TYPE_NFS4 to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "NFSv4 text round trip parses"
            Get AclCount of oEntry ARCHIVE_ENTRY_ACL_TYPE_NFS4 to iAclCount
            Send AssertIAreEqual 2 iAclCount "NFSv4 count after round trip"
        End_Procedure
    End_Object

    // ---- extended attributes ----------------------------------------------------------------------------------------

    Object oXattrTest is a cTest
        Procedure Test
            Integer iXattrCount
            Integer iCount
            UChar[] ucValue
            tArchiveEntryXattr stXattr
            tArchiveEntryXattr[] astXattr

            Send CreateEntry of oEntry
            Get XattrCount of oEntry to iXattrCount
            Send AssertIAreEqual 0 iXattrCount "no xattrs"
            Move (ResizeArray (ucValue, 4)) to ucValue
            Move 1 to ucValue[0]
            Move 0 to ucValue[1]
            Move 255 to ucValue[2]
            Move 7 to ucValue[3]
            Send XattrAdd of oEntry "user.binary" ucValue
            Send XattrAddText of oEntry "user.comment" "hello"
            Move (ResizeArray (ucValue, 0)) to ucValue
            Send XattrAdd of oEntry "user.empty" ucValue
            Get XattrCount of oEntry to iXattrCount
            Send AssertIAreEqual 3 iXattrCount "three xattrs"

            Get XattrReset of oEntry to iCount
            Send AssertIAreEqual 3 iCount "XattrReset count"
            Get XattrNext of oEntry to stXattr
            // libarchive lists the attributes in reverse order of adding
            Send AssertSAreEqual "user.empty" stXattr.sName "first xattr name (last added)"
            Send AssertIAreEqual 0 (SizeOfArray (stXattr.ucValue)) "empty value"
            Get XattrNext of oEntry to stXattr
            Send AssertSAreEqual "user.comment" stXattr.sName "second xattr name"
            Get XattrNext of oEntry to stXattr
            Send AssertSAreEqual "user.binary" stXattr.sName "third xattr name"
            Send AssertIAreEqual 4 (SizeOfArray (stXattr.ucValue)) "binary value size"
            Move stXattr.ucValue to ucValue
            Send AssertIAreEqual 1 ucValue[0] "binary byte 0"
            Send AssertIAreEqual 0 ucValue[1] "binary byte 1 (zero byte kept)"
            Send AssertIAreEqual 255 ucValue[2] "binary byte 2"
            Send AssertIAreEqual 7 ucValue[3] "binary byte 3"

            Get XattrEntries of oEntry to astXattr
            Send AssertIAreEqual 3 (SizeOfArray (astXattr)) "XattrEntries count"
            Send AssertSAreEqual "user.empty" astXattr[0].sName "first name"
            Move astXattr[0].ucValue to ucValue
            Send AssertIAreEqual 0 (SizeOfArray (ucValue)) "empty value"
            Send AssertSAreEqual "user.comment" astXattr[1].sName "second name"
            Move astXattr[1].ucValue to ucValue
            Send AssertIAreEqual 5 (SizeOfArray (ucValue)) "text value size"
            Send AssertIAreEqual (Ascii ("h")) ucValue[0] "text value first byte"
            Send AssertSAreEqual "user.binary" astXattr[2].sName "third name"

            // enumeration end
            Get XattrReset of oEntry to iCount
            Get XattrNext of oEntry to stXattr
            Get XattrNext of oEntry to stXattr
            Get XattrNext of oEntry to stXattr
            Get XattrNext of oEntry to stXattr
            Send AssertSAreEqual "" stXattr.sName "end of xattrs"

            Send XattrClear of oEntry
            Get XattrCount of oEntry to iXattrCount
            Send AssertIAreEqual 0 iXattrCount "xattrs cleared"
        End_Procedure
    End_Object

    // ---- sparse regions ---------------------------------------------------------------------------------------------

    Object oSparseTest is a cTest
        Procedure Test
            Integer iSparseCount
            Integer iCount
            tArchiveEntrySparse stSparse
            tArchiveEntrySparse[] astSparse

            Send CreateEntry of oEntry
            Get SparseCount of oEntry to iSparseCount
            Send AssertIAreEqual 0 iSparseCount "no sparse regions"
            // libarchive ignores regions that lie beyond the entry size
            Send SparseAdd of oEntry 0 100
            Get SparseCount of oEntry to iSparseCount
            Send AssertIAreEqual 0 iSparseCount "region beyond the size is ignored"
            Set piSize of oEntry to 6000000000
            Send SparseAdd of oEntry 0 100
            Send SparseAdd of oEntry 4096 200
            Send SparseAdd of oEntry 5000000000 300
            Get SparseCount of oEntry to iSparseCount
            Send AssertIAreEqual 3 iSparseCount "three regions"
            Get SparseReset of oEntry to iCount
            Send AssertIAreEqual 3 iCount "SparseReset count"
            Get SparseNext of oEntry to stSparse
            Send AssertBIAreEqual 0 stSparse.iOffset "first offset"
            Send AssertBIAreEqual 100 stSparse.iLength "first length"
            Get SparseEntries of oEntry to astSparse
            Send AssertIAreEqual 3 (SizeOfArray (astSparse)) "SparseEntries count"
            Send AssertBIAreEqual 4096 astSparse[1].iOffset "second offset"
            Send AssertBIAreEqual 200 astSparse[1].iLength "second length"
            Send AssertBIAreEqual 5000000000 astSparse[2].iOffset "third offset (64 bit)"
            Send AssertBIAreEqual 300 astSparse[2].iLength "third length"
            Get SparseReset of oEntry to iCount
            Get SparseNext of oEntry to stSparse
            Get SparseNext of oEntry to stSparse
            Get SparseNext of oEntry to stSparse
            Get SparseNext of oEntry to stSparse
            Send AssertBIAreEqual -1 stSparse.iLength "end of sparse regions"
            Send SparseClear of oEntry
            Get SparseCount of oEntry to iSparseCount
            Send AssertIAreEqual 0 iSparseCount "sparse regions cleared"
        End_Procedure
    End_Object

    // ---- round trip through an archive --------------------------------------------------------------------------------

    Object oArchiveRoundTripTest is a cTest
        Procedure Test
            Pointer pEntry
            String sPathname sUname sGname
            Integer iMode iMtimeNsec
            BigInt biSize biUid biGid biMtime
            Pointer pWriter pReader pRead
            Integer iResult iIndex
            String sNames
            BigInt iUsed
            UChar[] ucArchive
            tArchiveEntryAcl[] astAcl
            tArchiveEntryXattr[] astXattr

            // Describe an entry only through the wrapper ...
            Send CreateEntry of oEntry
            Set psPathname of oEntry to "dir/héllo-ünï.txt"
            Set piMode of oEntry to (AE_IFREG ior 420)
            Set piSize of oEntry to 0
            Set piUid of oEntry to 1001
            Set piGid of oEntry to 2002
            Set psUname of oEntry to "alice"
            Set psGname of oEntry to "staff"
            Send SetMtime of oEntry 1700000000 123456789
            Send XattrAddText of oEntry "user.comment" "hi there"
            Get AclAddEntry of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS 6 ARCHIVE_ENTRY_ACL_USER 1010 "bob" to iResult
            Get AclAddEntry of oEntry ARCHIVE_ENTRY_ACL_TYPE_ACCESS 6 ARCHIVE_ENTRY_ACL_MASK 0 "" to iResult

            // ... write it as pax archive into memory ...
            Move (ResizeArray (ucArchive, 65536)) to ucArchive
            Move (archive_write_new ()) to pWriter
            Move (archive_write_set_format (pWriter, ARCHIVE_FORMAT_TAR_PAX_INTERCHANGE)) to iResult
            Send AssertArchiveOk iResult pWriter "set pax format"
            Move (archive_write_open_memory (pWriter, AddressOf (ucArchive), 65536, AddressOf (iUsed))) to iResult
            Send AssertArchiveOk iResult pWriter "open memory"
            Get ppEntry of oEntry to pEntry
            Move (archive_write_header (pWriter, pEntry)) to iResult
            Send AssertArchiveOk iResult pWriter "write header of a wrapper entry"
            Move (archive_write_close (pWriter)) to iResult
            Move (archive_write_free (pWriter)) to iResult
            Send Assert (iUsed > 0) "archive has bytes"

            // ... and read it back through a borrowed wrapper object.
            Move (archive_read_new ()) to pReader
            Move (archive_read_support_format_all (pReader)) to iResult
            Move (archive_read_open_memory (pReader, AddressOf (ucArchive), iUsed)) to iResult
            Send AssertArchiveOk iResult pReader "open archive"
            Move (archive_read_next_header (pReader, AddressOf (pRead))) to iResult
            Send AssertArchiveOk iResult pReader "read header"
            Send AttachEntry of oBorrowed pRead False
            Get psPathname of oBorrowed to sPathname
            Send AssertSAreEqual "dir/héllo-ünï.txt" sPathname "path"
            Get piMode of oBorrowed to iMode
            Send AssertIAreEqual (AE_IFREG ior 420) iMode "mode"
            Get piSize of oBorrowed to biSize
            Send AssertBIAreEqual 0 biSize "size"
            Get piUid of oBorrowed to biUid
            Send AssertBIAreEqual 1001 biUid "uid"
            Get piGid of oBorrowed to biGid
            Send AssertBIAreEqual 2002 biGid "gid"
            Get psUname of oBorrowed to sUname
            Send AssertSAreEqual "alice" sUname "uname"
            Get psGname of oBorrowed to sGname
            Send AssertSAreEqual "staff" sGname "gname"
            Get piMtime of oBorrowed to biMtime
            Send AssertBIAreEqual 1700000000 biMtime "mtime"
            Get piMtimeNsec of oBorrowed to iMtimeNsec
            Send AssertIAreEqual 123456789 iMtimeNsec "mtime nsec"
            Get XattrEntries of oBorrowed to astXattr
            For iIndex from 0 to (SizeOfArray (astXattr) - 1)
                Move (sNames + astXattr[iIndex].sName + ";") to sNames
            Loop
            // libarchive writes the attribute in two pax header forms (SCHILY.xattr and LIBARCHIVE.xattr) and a reader reports both
            Send Assert (SizeOfArray (astXattr) >= 1) ("xattr present, names: " + sNames)
            Send AssertSAreEqual "user.comment" astXattr[0].sName "xattr name"
            Move astXattr[0].ucValue to ucArchive
            Send AssertIAreEqual 8 (SizeOfArray (ucArchive)) "xattr value size"
            Get AclEntries of oBorrowed ARCHIVE_ENTRY_ACL_TYPE_ACCESS to astAcl
            Send AssertIAreEqual 5 (SizeOfArray (astAcl)) "ACL entries"
            Send AssertSAreEqual "bob" astAcl[3].sName "ACL user"
            Send FreeEntry of oBorrowed
            Move (archive_read_free (pReader)) to iResult
        End_Procedure
    End_Object
End_Object

// ---- cArchiveLinkResolver --------------------------------------------------------------------------------------------

Object oWrapperLinkResolverTests is a cArchiveTestFixture
    Set psTestFixtureName to "WrapperLinkResolver"

    Object oResolver is a cArchiveLinkResolver
    End_Object

    Object oIn is a cArchiveEntry
    End_Object

    Object oOut is a cArchiveEntry
    End_Object

    Object oSecond is a cArchiveEntry
    End_Object

    // Makes oIn a regular file with the given name, device, inode, link count and size.
    Procedure PrepareFile String sName Integer iIno Integer iLinks
        Send CreateEntry of oIn
        Set psPathname of oIn to sName
        Set piMode of oIn to (AE_IFREG ior 420)
        Set piDev of oIn to 1
        Set piIno of oIn to iIno
        Set piNlink of oIn to iLinks
        Set piSize of oIn to 10
    End_Procedure

    Object oLifeCycleTest is a cTest
        Procedure Test
            Pointer pResolver
            Boolean bHasResolver
            Integer iLinkify

            Get HasResolver of oResolver to bHasResolver
            Send AssertFalse bHasResolver "no resolver yet"
            Send CreateResolver of oResolver
            Get HasResolver of oResolver to bHasResolver
            Send Assert bHasResolver "resolver created"
            Get ppResolver of oResolver to pResolver
            Send Assert (pResolver <> 0) "resolver pointer"
            Send FreeResolver of oResolver
            Get HasResolver of oResolver to bHasResolver
            Send AssertFalse bHasResolver "resolver freed"
            Send FreeResolver of oResolver
            // SetStrategy creates the resolver on demand.
            Send SetStrategy of oResolver ARCHIVE_FORMAT_TAR
            Get HasResolver of oResolver to bHasResolver
            Send Assert bHasResolver "SetStrategy creates the resolver"
            Send FreeResolver of oResolver

            // without a resolver Linkify reports an error
            Send PrepareFile of oIn "a.txt" 5 1
            Send ExpectError DFERR_PROGRAM
            Get Linkify of oResolver oIn oOut 0 to iLinkify
            Send AssertIAreEqual 0 iLinkify "no resolver"
            Send UnExpectError DFERR_PROGRAM
        End_Procedure
    End_Object

    Object oTarStrategyTest is a cTest
        Procedure Test
            String sPathname sHardlink
            Pointer pEntry
            Boolean bOwnsEntry bHardlinkIsSet bSizeIsSet
            Boolean bHasEntry
            Integer iCount iLinks
            Pointer pFirst

            Send SetStrategy of oResolver ARCHIVE_FORMAT_TAR

            // A file with one link is passed through unchanged.
            Send PrepareFile of oIn "single.txt" 1 1
            Get ppEntry of oIn to pFirst
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 1 iCount "single file: one entry to write"
            Get psPathname of oOut to sPathname
            Send AssertSAreEqual "single.txt" sPathname "single file unchanged"
            Get ppEntry of oOut to pEntry
            Send AssertPAreEqual pFirst pEntry "the entry itself is returned"
            Get pbOwnsEntry of oOut to bOwnsEntry
            Send Assert bOwnsEntry "output owns the entry"
            Get HasEntry of oIn to bHasEntry
            Send AssertFalse bHasEntry "input object is emptied"
            Get pbHardlinkIsSet of oOut to bHardlinkIsSet
            Send AssertFalse bHardlinkIsSet "no hard link"

            // First file of a hard link group: written as is. Second: becomes a hard link without data.
            Send PrepareFile of oIn "a.txt" 5 2
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 1 iCount "first link: one entry"
            Get psPathname of oOut to sPathname
            Send AssertSAreEqual "a.txt" sPathname "first link path"
            Get pbHardlinkIsSet of oOut to bHardlinkIsSet
            Send AssertFalse bHardlinkIsSet "first link is a regular file"
            Get pbSizeIsSet of oOut to bSizeIsSet
            Send Assert bSizeIsSet "first link keeps its size"
            Send PrepareFile of oIn "b.txt" 5 2
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 1 iCount "second link: one entry"
            Get psPathname of oOut to sPathname
            Send AssertSAreEqual "b.txt" sPathname "second link path"
            Get pbHardlinkIsSet of oOut to bHardlinkIsSet
            Send Assert bHardlinkIsSet "second link is a hard link"
            Get psHardlink of oOut to sHardlink
            Send AssertSAreEqual "a.txt" sHardlink "second link points to the first"
            Get pbSizeIsSet of oOut to bSizeIsSet
            Send AssertFalse bSizeIsSet "second link has no data"

            // A borrowed entry is cloned, the original stays valid.
            Send PrepareFile of oIn "c.txt" 6 1
            Get ppEntry of oIn to pFirst
            Set pbOwnsEntry of oIn to False
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 1 iCount "borrowed entry: one entry"
            Get psPathname of oOut to sPathname
            Send AssertSAreEqual "c.txt" sPathname "borrowed entry path"
            Get ppEntry of oOut to pEntry
            Send AssertFalse (pEntry = pFirst) "borrowed entry was cloned"
            Get ppEntry of oIn to pEntry
            Send AssertPAreEqual pFirst pEntry "borrowed entry still attached to the input"
            Set pbOwnsEntry of oIn to True

            // partial links: one file of a group of three that never saw its other links
            Send PrepareFile of oIn "p1.txt" 77 3
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 1 iCount "partial group: first entry written"
            Get PartialLinks of oResolver oSecond (&iLinks) to iCount
            Send Assert (iCount = 1) "partial links found one group"
            Get psPathname of oSecond to sPathname
            Send AssertSAreEqual "p1.txt" sPathname "partial link entry"
            Send AssertIAreEqual 2 iLinks "two links were never seen"
            Get pbOwnsEntry of oSecond to bOwnsEntry
            Send Assert bOwnsEntry "partial entry owned by the output"
            Get PartialLinks of oResolver oSecond (&iLinks) to iCount
            Send AssertIAreEqual 0 iCount "no more partial links"
            Get HasEntry of oSecond to bHasEntry
            Send AssertFalse bHasEntry "output emptied at the end"
            Send AssertIAreEqual 0 iLinks "no links at the end"
        End_Procedure
    End_Object

    Object oCpioStrategyTest is a cTest
        Procedure Test
            String sPathname
            Boolean bHardlinkIsSet bSizeIsSet bOwnsEntry
            Boolean bHasEntry bHasResolver
            Integer iCount
            Boolean bMore

            Send SetStrategy of oResolver ARCHIVE_FORMAT_CPIO_SVR4_NOCRC

            // The SVR4 strategy holds the first link back until the last link arrives.
            Send PrepareFile of oIn "a.txt" 9 2
            Get Linkify of oResolver oIn oOut oSecond to iCount
            Send AssertIAreEqual 0 iCount "first link is deferred"
            Get HasEntry of oOut to bHasEntry
            Send AssertFalse bHasEntry "nothing returned for the first link"
            Get HasEntry of oIn to bHasEntry
            Send AssertFalse bHasEntry "input object emptied"

            Send PrepareFile of oIn "b.txt" 9 2
            Get Linkify of oResolver oIn oOut oSecond to iCount
            Send AssertIAreEqual 2 iCount "last link: two entries"
            Get psPathname of oOut to sPathname
            Send AssertSAreEqual "a.txt" sPathname "the deferred entry comes back first"
            Get pbHardlinkIsSet of oOut to bHardlinkIsSet
            Send Assert bHardlinkIsSet "deferred entry became a hard link"
            Get pbSizeIsSet of oOut to bSizeIsSet
            Send AssertFalse bSizeIsSet "deferred entry carries no data"
            Get psPathname of oSecond to sPathname
            Send AssertSAreEqual "b.txt" sPathname "the last link carries the data"
            Get pbSizeIsSet of oSecond to bSizeIsSet
            Send Assert bSizeIsSet "the last link keeps its size"
            Get pbOwnsEntry of oSecond to bOwnsEntry
            Send Assert bOwnsEntry "second output owns its entry"

            // Flush returns deferred entries of groups that never completed.
            Send PrepareFile of oIn "lonely.txt" 50 3
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 0 iCount "incomplete group is deferred"
            Get Flush of oResolver oOut to bMore
            Send Assert bMore "flush returns the deferred entry"
            Get psPathname of oOut to sPathname
            Send AssertSAreEqual "lonely.txt" sPathname "flushed entry"
            Get Flush of oResolver oOut to bMore
            Send AssertFalse bMore "nothing more to flush"
            Get HasEntry of oOut to bHasEntry
            Send AssertFalse bHasEntry "output emptied after the last flush"

            // entries still held by the resolver are freed with it
            Send PrepareFile of oIn "held.txt" 60 2
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 0 iCount "deferred again"
            Send FreeResolver of oResolver
            Get HasResolver of oResolver to bHasResolver
            Send AssertFalse bHasResolver "freed with a deferred entry"
        End_Procedure
    End_Object

    Object oOtherStrategyTest is a cTest
        Procedure Test
            Boolean bHardlinkIsSet
            String sPathname
            Boolean bHasEntry
            Integer iCount

            // Formats like zip/ar leave entries unchanged.
            Send SetStrategy of oResolver ARCHIVE_FORMAT_ZIP
            Send PrepareFile of oIn "z1.txt" 3 2
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 1 iCount "zip strategy: entry returned"
            Send PrepareFile of oIn "z2.txt" 3 2
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 1 iCount "zip strategy: second entry returned"
            Get pbHardlinkIsSet of oOut to bHardlinkIsSet
            Send AssertFalse bHardlinkIsSet "zip strategy leaves hard links alone"
            Get psPathname of oOut to sPathname
            Send AssertSAreEqual "z2.txt" sPathname "zip strategy path"
            // Linkify of an input object without entry and no deferred entries returns nothing
            Send FreeEntry of oIn
            Get Linkify of oResolver oIn oOut 0 to iCount
            Send AssertIAreEqual 0 iCount "empty input"
            Get HasEntry of oOut to bHasEntry
            Send AssertFalse bHasEntry "output emptied for an empty input"
            Send FreeResolver of oResolver
        End_Procedure
    End_Object
End_Object
