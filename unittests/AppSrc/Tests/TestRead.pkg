    // ---- filters -------------------------------------------------------------------------------------------------

    Object oFilterGzipTest is a cTest
        Procedure Test
            Delegate Send FilterRoundTrip "gzip" ARCHIVE_FILTER_GZIP "gzip" True
        End_Procedure
    End_Object

    Object oFilterBzip2Test is a cTest
        Procedure Test
            Delegate Send FilterRoundTrip "bzip2" ARCHIVE_FILTER_BZIP2 "bzip2" True
        End_Procedure
    End_Object

    Object oFilterCompressTest is a cTest
        Procedure Test
            // archive_read_append_filter (ARCHIVE_FILTER_COMPRESS) crashes (access violation) in libarchive 3.7.7, so it is not
            // part of this round trip.
            Delegate Send FilterRoundTrip "compress" ARCHIVE_FILTER_COMPRESS "compress (.Z)" False
        End_Procedure
    End_Object

    Object oFilterLzmaTest is a cTest
        Procedure Test
            Delegate Send FilterRoundTrip "lzma" ARCHIVE_FILTER_LZMA "lzma" True
        End_Procedure
    End_Object

    Object oFilterXzTest is a cTest
        Procedure Test
            Delegate Send FilterRoundTrip "xz" ARCHIVE_FILTER_XZ "xz" True
        End_Procedure
    End_Object

    Object oFilterLzipTest is a cTest
        Procedure Test
            Delegate Send FilterRoundTrip "lzip" ARCHIVE_FILTER_LZIP "lzip" True
        End_Procedure
    End_Object

    Object oFilterLz4Test is a cTest
        Procedure Test
            Delegate Send FilterRoundTrip "lz4" ARCHIVE_FILTER_LZ4 "lz4" True
        End_Procedure
    End_Object

    Object oFilterZstdTest is a cTest
        Procedure Test
            Delegate Send FilterRoundTrip "zstd" ARCHIVE_FILTER_ZSTD "zstd" True
        End_Procedure
    End_Object

    Object oFilterUuTest is a cTest
        Procedure Test
            Delegate Send FilterRoundTrip "uu" ARCHIVE_FILTER_UU "uu" True
        End_Procedure
    End_Object

    // The filters that need external programs report ARCHIVE_WARN; the others report ARCHIVE_OK. The
    // deprecated compression functions return the same results as the filter functions. A reader has 16 slots for
    // filters, therefore several readers are used.
    Object oSupportFilterCallsTest is a cTest
        Procedure Test
            Pointer pArchive pOld
            Integer iResult
            String sCommand sSignature

            Move (archive_read_new ()) to pArchive
            Move (archive_read_new ()) to pOld

            Move (archive_read_support_filter_bzip2 (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_bzip2"
            Send AssertIAreEqual iResult (archive_read_support_compression_bzip2 (pOld)) "compression_bzip2 is the same"
            Move (archive_read_support_filter_compress (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_compress"
            Send AssertIAreEqual iResult (archive_read_support_compression_compress (pOld)) "compression_compress is the same"
            Move (archive_read_support_filter_gzip (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_gzip"
            Send AssertIAreEqual iResult (archive_read_support_compression_gzip (pOld)) "compression_gzip is the same"
            Move (archive_read_support_filter_lz4 (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_lz4"
            Move (archive_read_support_filter_lzip (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_lzip"
            Send AssertIAreEqual iResult (archive_read_support_compression_lzip (pOld)) "compression_lzip is the same"
            Move (archive_read_support_filter_lzma (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_lzma"
            Send AssertIAreEqual iResult (archive_read_support_compression_lzma (pOld)) "compression_lzma is the same"
            Move (archive_read_support_filter_none (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_none"
            Send AssertIAreEqual iResult (archive_read_support_compression_none (pOld)) "compression_none is the same"
            Move (archive_read_support_filter_rpm (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_rpm"
            Send AssertIAreEqual iResult (archive_read_support_compression_rpm (pOld)) "compression_rpm is the same"
            Move (archive_read_support_filter_uu (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_uu"
            Send AssertIAreEqual iResult (archive_read_support_compression_uu (pOld)) "compression_uu is the same"
            Move (archive_read_support_filter_xz (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_xz"
            Send AssertIAreEqual iResult (archive_read_support_compression_xz (pOld)) "compression_xz is the same"
            Move (archive_read_support_filter_zstd (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_zstd"
            Move (archive_read_free (pArchive)) to iResult
            Move (archive_read_free (pOld)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_new ()) to pOld
            Move (archive_read_support_filter_all (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_all"
            Send AssertIAreEqual iResult (archive_read_support_compression_all (pOld)) "compression_all is the same"
            Move (archive_read_free (pArchive)) to iResult
            Move (archive_read_free (pOld)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_new ()) to pOld
            Move (archive_read_support_filter_grzip (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_WARN iResult "filter_grzip needs an external program"
            Move (archive_read_support_filter_lrzip (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_WARN iResult "filter_lrzip needs an external program"
            Move (archive_read_support_filter_lzop (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_WARN iResult "filter_lzop needs an external program"

            Move "nonexistent-program-xyz -d" to sCommand
            Move (archive_read_support_filter_program (pArchive, AddressOf (sCommand))) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_program"
            Send AssertIAreEqual iResult (archive_read_support_compression_program (pOld, AddressOf (sCommand))) "compression_program is the same"
            Move (Character (31) + Character (139)) to sSignature
            Move (archive_read_support_filter_program_signature (pArchive, AddressOf (sCommand), AddressOf (sSignature), 2)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "filter_program_signature"
            Send AssertIAreEqual iResult (archive_read_support_compression_program_signature (pOld, AddressOf (sCommand), AddressOf (sSignature), 2)) "compression_program_signature is the same"

            Move (archive_read_free (pArchive)) to iResult
            Move (archive_read_free (pOld)) to iResult
        End_Procedure
    End_Object

    Object oSupportFilterByCodeTest is a cTest
        Procedure Test
            Pointer pArchive
            Integer iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_filter_by_code (pArchive, ARCHIVE_FILTER_NONE)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code none"
            Move (archive_read_support_filter_by_code (pArchive, ARCHIVE_FILTER_GZIP)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code gzip"
            Move (archive_read_support_filter_by_code (pArchive, ARCHIVE_FILTER_BZIP2)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code bzip2"
            Move (archive_read_support_filter_by_code (pArchive, ARCHIVE_FILTER_XZ)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code xz"
            Move (archive_read_support_filter_by_code (pArchive, ARCHIVE_FILTER_ZSTD)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code zstd"
            Move (archive_read_support_filter_by_code (pArchive, 99)) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "by code with an invalid code"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    // append_filter with a code, append_filter_program and append_filter_program_signature. The program is started
    // at once, so a program that does not exist makes the call fail fatally.
    Object oAppendFilterTest is a cTest
        Procedure Test
            Pointer pArchive
            Integer iResult
            String sCommand sSignature sMessage

            Move (archive_read_new ()) to pArchive
            Move (archive_read_append_filter (pArchive, ARCHIVE_FILTER_GZIP)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "append_filter gzip"
            Move (archive_read_append_filter (pArchive, 99)) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "append_filter with an invalid code"
            Move (archive_read_free (pArchive)) to iResult

            Move "nonexistent-program-xyz -d" to sCommand
            Move (archive_read_new ()) to pArchive
            Move (archive_read_append_filter_program (pArchive, AddressOf (sCommand))) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "append_filter_program with a program that does not exist"
            Delegate Get ErrorText pArchive to sMessage
            Send Assert (SizeOfString (sMessage) > 0) "append_filter_program sets an error text"
            Move (archive_read_free (pArchive)) to iResult

            Move (Character (31) + Character (139)) to sSignature
            Move (archive_read_new ()) to pArchive
            Move (archive_read_append_filter_program_signature (pArchive, AddressOf (sCommand), AddressOf (sSignature), 2)) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "append_filter_program_signature with a program that does not exist"
            Delegate Get ErrorText pArchive to sMessage
            Send Assert (SizeOfString (sMessage) > 0) "append_filter_program_signature sets an error text"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    // ---- open variants -------------------------------------------------------------------------------------------

    Object oOpenFilenameTest is a cTest
        Procedure Test
            String sFile
            Pointer pArchive
            Integer iResult

            Delegate Get TempFile "open-filename.zip" to sFile
            Delegate Get BuildSampleArchiveFile sFile ARCHIVE_FORMAT_ZIP ARCHIVE_FILTER_NONE to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"

            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_filename (pArchive, AddressOf (sFile), 10240)) to iResult
            Delegate Send OpenAndVerify pArchive iResult "open_filename"

            // The deprecated synonym.
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_file (pArchive, AddressOf (sFile), 10240)) to iResult
            Delegate Send OpenAndVerify pArchive iResult "open_file"

            Delegate Send DeleteFileUtf8 sFile
        End_Procedure
    End_Object

    Object oOpenFilenameWideUnicodeTest is a cTest
        Procedure Test
            String sFile
            Pointer pArchive
            Integer iResult
            WString wsFile

            Delegate Get TempFile "ünï-cödé-open.zip" to sFile
            Delegate Get BuildSampleArchiveFile sFile ARCHIVE_FORMAT_ZIP ARCHIVE_FILTER_NONE to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip with a unicode file name"
            Delegate Get PathExists sFile to iResult
            Send Assert iResult "the file with the unicode name exists"

            Move sFile to wsFile
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_filename_w (pArchive, AddressOf (wsFile), 10240)) to iResult
            Delegate Send OpenAndVerify pArchive iResult "open_filename_w"

            Delegate Send DeleteFileUtf8 sFile
            Delegate Get PathExists sFile to iResult
            Send AssertFalse iResult "the file with the unicode name was deleted"
        End_Procedure
    End_Object

    // A tar archive is split into two files that are read as one volume set.
    Object oOpenFilenamesTest is a cTest
        Procedure Test
            String sPart1 sPart2
            Pointer pArchive
            Integer iResult
            BigInt iSize
            UChar[] ucTar
            tReadNamePointers tNames
            WString wsPart1 wsPart2

            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_TAR_USTAR (&ucTar) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample tar"
            Move (SizeOfArray (ucTar)) to iSize
            Send Assert (iSize > 1024) "tar is larger than the split point"

            Delegate Get TempFile "volume1.tar" to sPart1
            Delegate Get TempFile "volume2.tar" to sPart2
            Delegate Get WriteBytesToFile sPart1 ucTar 0 1024 to iResult
            Send AssertIAreEqual 1024 iResult "first volume written"
            Delegate Get WriteBytesToFile sPart2 ucTar 1024 (iSize - 1024) to iResult
            Send AssertIAreEqual (iSize - 1024) iResult "second volume written"

            Move (AddressOf (sPart1)) to tNames.pName1
            Move (AddressOf (sPart2)) to tNames.pName2
            Move 0 to tNames.pEnd
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_filenames (pArchive, AddressOf (tNames), 10240)) to iResult
            Delegate Send OpenAndVerify pArchive iResult "open_filenames"

            Move sPart1 to wsPart1
            Move sPart2 to wsPart2
            Move (AddressOf (wsPart1)) to tNames.pName1
            Move (AddressOf (wsPart2)) to tNames.pName2
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_filenames_w (pArchive, AddressOf (tNames), 10240)) to iResult
            Delegate Send OpenAndVerify pArchive iResult "open_filenames_w"

            Delegate Send DeleteFileUtf8 sPart1
            Delegate Send DeleteFileUtf8 sPart2
        End_Procedure
    End_Object

    Object oOpenMemoryTest is a cTest
        Procedure Test
            Pointer pArchive
            Integer iResult
            UChar[] ucZip

            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"

            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
            Delegate Send OpenAndVerify pArchive iResult "open_memory"

            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory2 (pArchive, AddressOf (ucZip), SizeOfArray (ucZip), 7)) to iResult
            Delegate Send OpenAndVerify pArchive iResult "open_memory2 (7 byte chunks)"
        End_Procedure
    End_Object

    Object oOpenFdTest is a cTest
        Procedure Test
            String sFile
            Pointer pArchive
            Integer iResult iFd

            Delegate Get TempFile "open-fd.zip" to sFile
            Delegate Get BuildSampleArchiveFile sFile ARCHIVE_FORMAT_ZIP ARCHIVE_FILTER_NONE to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"

            Move (Read_CrtOpen (AddressOf (sFile), 32768, 0)) to iFd
            Send Assert (iFd >= 0) "CRT file descriptor"
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_fd (pArchive, iFd, 10240)) to iResult
            Delegate Send OpenAndVerify pArchive iResult "open_fd"
            Move (Read_CrtClose (iFd)) to iResult
            Send AssertIAreEqual 0 iResult "close the descriptor"

            Delegate Send DeleteFileUtf8 sFile
        End_Procedure
    End_Object

    Object oOpenFileStructTest is a cTest
        Procedure Test
            String sFile
            Pointer pArchive pFile
            Integer iResult
            WString wsFile wsMode

            Delegate Get TempFile "open-FILE.zip" to sFile
            Delegate Get BuildSampleArchiveFile sFile ARCHIVE_FORMAT_ZIP ARCHIVE_FILTER_NONE to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"

            Move sFile to wsFile
            Move "rb" to wsMode
            Move (Read_CrtWFopen (AddressOf (wsFile), AddressOf (wsMode))) to pFile
            Send Assert (pFile <> 0) "FILE pointer"
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_FILE_Ptr (pArchive, pFile)) to iResult
            // Reading from a FILE is streamed: the zip sizes are not known at the headers.
            Delegate Set pbSkipSizeCheck to True
            Delegate Send OpenAndVerify pArchive iResult "open_FILE"
            Delegate Set pbSkipSizeCheck to False
            Move (Read_CrtFclose (pFile)) to iResult
            Send AssertIAreEqual 0 iResult "fclose"

            Delegate Send DeleteFileUtf8 sFile
        End_Procedure
    End_Object

    // The callbacks cannot be created from DataFlex: the setters accept 0, opening without a read callback fails.
    Object oOpenCallbacksTest is a cTest
        Procedure Test
            Pointer pArchive
            Integer iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_all (pArchive)) to iResult
            Move (archive_read_set_open_callback (pArchive, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_open_callback 0"
            Move (archive_read_set_read_callback (pArchive, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_read_callback 0"
            Move (archive_read_set_seek_callback (pArchive, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_seek_callback 0"
            Move (archive_read_set_skip_callback (pArchive, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_skip_callback 0"
            Move (archive_read_set_close_callback (pArchive, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_close_callback 0"
            Move (archive_read_set_switch_callback (pArchive, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_switch_callback 0"
            Move (archive_read_set_callback_data (pArchive, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_callback_data 0"
            Move (archive_read_set_callback_data2 (pArchive, 0, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_callback_data2 0"
            Move (archive_read_add_callback_data (pArchive, 0, 1)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "add_callback_data 0"
            Move (archive_read_append_callback_data (pArchive, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "append_callback_data 0"
            Move (archive_read_prepend_callback_data (pArchive, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "prepend_callback_data 0"
            Move (archive_read_open1 (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "open1 without read callback"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_open (pArchive, 0, 0, 0, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "open without callbacks"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_open2 (pArchive, 0, 0, 0, 0, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "open2 without callbacks"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    // ---- entries and data ----------------------------------------------------------------------------------------

    Object oNextHeaderTest is a cTest
        Procedure Test
            String sFile sName sExpected sMsg
            Pointer pArchive pEntry pReturned
            Integer iResult iIndex
            UChar[] ucZip

            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"

            // next_header2 fills an entry that was created by the caller.
            Move (archive_entry_new ()) to pEntry
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open memory"
            For iIndex from 0 to 3
                Move (archive_read_next_header2 (pArchive, pEntry)) to iResult
                Delegate Get Msg "next_header2" iIndex to sMsg
                Delegate Send AssertArchiveOk iResult pArchive sMsg
                Move (PointerToString (archive_entry_pathname_utf8 (pEntry))) to sName
                Delegate Get SampleEntryName iIndex to sExpected
                Delegate Get Msg "next_header2 name" iIndex to sMsg
                Send AssertSAreEqual sExpected sName sMsg
                Send AssertIAreEqual (iIndex + 1) (archive_file_count (pArchive)) "file count"
            Loop
            Move (archive_read_next_header2 (pArchive, pEntry)) to iResult
            Send AssertIAreEqual ARCHIVE_EOF iResult "next_header2 at the end"
            Move (archive_read_free (pArchive)) to iResult
            Move (archive_entry_free (pEntry)) to iResult
        End_Procedure
    End_Object

    // In a ustar archive every entry starts at a multiple of 512 bytes: 512 byte header + padded data.
    Object oHeaderPositionTest is a cTest
        Procedure Test
            String sFile
            Pointer pArchive pEntry
            Integer iResult
            WString wsFile

            Delegate Get TempFile "position.tar" to sFile
            Delegate Get BuildSampleArchiveFile sFile ARCHIVE_FORMAT_TAR_USTAR ARCHIVE_FILTER_NONE to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample tar"
            Move sFile to wsFile
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_filename_w (pArchive, AddressOf (wsFile), 10240)) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open"

            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertBIAreEqual 0 (archive_read_header_position (pArchive)) "position of hello.txt"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertBIAreEqual 1024 (archive_read_header_position (pArchive)) "position of docs/"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertBIAreEqual 1536 (archive_read_header_position (pArchive)) "position of docs/nested.txt"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertBIAreEqual 2560 (archive_read_header_position (pArchive)) "position of the unicode entry"

            Move (archive_read_free (pArchive)) to iResult
            Delegate Send DeleteFileUtf8 sFile
        End_Procedure
    End_Object

    // Reads the first entry (hello.txt) in pieces.
    Object oReadDataTest is a cTest
        Procedure Test
            Pointer pArchive pEntry
            Integer iResult
            BigInt iRead
            UChar[] ucZip ucBuffer
            String sPart

            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "next header"

            Move (ResizeArray (ucBuffer, 100)) to ucBuffer
            Move (archive_read_data (pArchive, AddressOf (ucBuffer), 5)) to iRead
            Send AssertBIAreEqual 5 iRead "first chunk size"
            Delegate Get BytesToString ucBuffer 5 to sPart
            Send AssertSAreEqual "Hello" sPart "first chunk"
            Move (archive_read_data (pArchive, AddressOf (ucBuffer), 100)) to iRead
            Send AssertBIAreEqual 8 iRead "rest size"
            Delegate Get BytesToString ucBuffer 8 to sPart
            Send AssertSAreEqual " Archive" sPart "rest"
            Move (archive_read_data (pArchive, AddressOf (ucBuffer), 100)) to iRead
            Send AssertBIAreEqual 0 iRead "end of the entry data"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    // None of the readers that can be created here (tar, zip) has a seek function: archive_seek_data fails fatally
    // and the data of the entry can still be read from the beginning (only rar5 can seek in the entry data).
    Object oSeekDataTest is a cTest
        Procedure Test
            Pointer pArchive pEntry
            Integer iResult
            BigInt iRead iPosition
            UChar[] ucTar ucZip ucBuffer
            String sPart

            Move (ResizeArray (ucBuffer, 100)) to ucBuffer
            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_TAR_USTAR (&ucTar) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample tar"
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucTar), SizeOfArray (ucTar))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open tar"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Move (archive_seek_data (pArchive, 6, 0)) to iPosition
            Send AssertBIAreEqual ARCHIVE_FATAL iPosition "tar has no seek function"
            Move (archive_read_data (pArchive, AddressOf (ucBuffer), 100)) to iRead
            Send AssertBIAreEqual 13 iRead "the data is still complete"
            Delegate Get BytesToString ucBuffer 13 to sPart
            Send AssertSAreEqual "Hello Archive" sPart "data after the failed seek"
            Move (archive_read_free (pArchive)) to iResult

            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucZip) to iResult
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Move (archive_seek_data (pArchive, 6, 0)) to iPosition
            Send AssertBIAreEqual ARCHIVE_FATAL iPosition "zip has no seek function"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    Object oReadDataBlockTest is a cTest
        Procedure Test
            Pointer pArchive pEntry pBlock
            Integer iResult
            BigInt iSize iOffset
            UChar[] ucTar ucBlock
            String sData
            Void_Type iVoid

            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_TAR_USTAR (&ucTar) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample tar"
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucTar), SizeOfArray (ucTar))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult

            Move "" to sData
            Move (archive_read_data_block (pArchive, AddressOf (pBlock), AddressOf (iSize), AddressOf (iOffset))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "first block"
            Send AssertBIAreEqual 13 iSize "block size"
            Send AssertBIAreEqual 0 iOffset "block offset"
            Send Assert (pBlock <> 0) "block pointer"
            If (iResult = ARCHIVE_OK and pBlock <> 0) Begin
                Move (ResizeArray (ucBlock, iSize)) to ucBlock
                Move (Read_MoveMemory (AddressOf (ucBlock), pBlock, iSize)) to iVoid
                Delegate Get BytesToString ucBlock iSize to sData
            End
            Send AssertSAreEqual "Hello Archive" sData "block data"
            Move (archive_read_data_block (pArchive, AddressOf (pBlock), AddressOf (iSize), AddressOf (iOffset))) to iResult
            Send AssertIAreEqual ARCHIVE_EOF iResult "no second block"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    Object oReadDataSkipTest is a cTest
        Procedure Test
            Pointer pArchive pEntry
            Integer iResult
            UChar[] ucZip

            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Move (archive_read_data_skip (pArchive)) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "data_skip"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "header after skip"
            Send AssertSAreEqual "docs/" (PointerToString (archive_entry_pathname_utf8 (pEntry))) "entry after skip"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertSAreEqual "docs/nested.txt" (PointerToString (archive_entry_pathname_utf8 (pEntry))) "next entry"
            Move (archive_read_data_skip (pArchive)) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "data_skip 2"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    Object oReadDataIntoFdTest is a cTest
        Procedure Test
            Pointer pArchive pEntry
            Integer iResult iFd
            String sArchiveFile sOutFile sData

            Delegate Get TempFile "intofd.zip" to sArchiveFile
            Delegate Get TempFile "intofd.out" to sOutFile
            Delegate Get BuildSampleArchiveFile sArchiveFile ARCHIVE_FORMAT_ZIP ARCHIVE_FILTER_NONE to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_filename (pArchive, AddressOf (sArchiveFile), 10240)) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertSAreEqual "docs/nested.txt" (PointerToString (archive_entry_pathname_utf8 (pEntry))) "third entry"

            Move (Read_CrtOpen (AddressOf (sOutFile), 33537, 384)) to iFd
            Send Assert (iFd >= 0) "output descriptor"
            Move (archive_read_data_into_fd (pArchive, iFd)) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "data_into_fd"
            Move (Read_CrtClose (iFd)) to iResult
            Delegate Get ReadTextFile sOutFile to sData
            Send AssertSAreEqual "Nested content" sData "content of the written file"

            Move (archive_read_free (pArchive)) to iResult
            Delegate Send DeleteFileUtf8 sArchiveFile
            Delegate Send DeleteFileUtf8 sOutFile
        End_Procedure
    End_Object

    // ---- encryption, options and passphrases ---------------------------------------------------------------------

    Object oEncryptionInfoTest is a cTest
        Procedure Test
            Pointer pArchive pEntry
            Integer iResult
            UChar[] ucData

            // zip: can detect encrypted data and metadata, reports 0 when there is none
            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucData) to iResult
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucData), SizeOfArray (ucData))) to iResult
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertIAreEqual 0 (archive_read_has_encrypted_entries (pArchive)) "plain zip has no encrypted entries"
            Send AssertIAreEqual (ARCHIVE_READ_FORMAT_CAPS_ENCRYPT_DATA ior ARCHIVE_READ_FORMAT_CAPS_ENCRYPT_METADATA) (archive_read_format_capabilities (pArchive)) "zip capabilities"
            Move (archive_read_free (pArchive)) to iResult

            // tar has no encryption at all
            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_TAR_USTAR (&ucData) to iResult
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucData), SizeOfArray (ucData))) to iResult
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertIAreEqual ARCHIVE_READ_FORMAT_ENCRYPTION_UNSUPPORTED (archive_read_has_encrypted_entries (pArchive)) "tar cannot tell about encryption"
            Send AssertIAreEqual ARCHIVE_READ_FORMAT_CAPS_NONE (archive_read_format_capabilities (pArchive)) "tar capabilities"
            Move (archive_read_free (pArchive)) to iResult

            // 7zip can detect encrypted data and metadata
            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_7ZIP (&ucData) to iResult
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucData), SizeOfArray (ucData))) to iResult
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertIAreEqual 0 (archive_read_has_encrypted_entries (pArchive)) "plain 7zip has no encrypted entries"
            Send AssertIAreEqual (ARCHIVE_READ_FORMAT_CAPS_ENCRYPT_DATA ior ARCHIVE_READ_FORMAT_CAPS_ENCRYPT_METADATA) (archive_read_format_capabilities (pArchive)) "7zip capabilities"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    // Encrypted zip: without passphrase the data cannot be read, with add_passphrase (the wrong one first) it can.
    Object oPassphraseTest is a cTest
        Procedure Test
            String sFile sData sPassphrase sWrong sMessage
            Pointer pArchive pEntry
            Integer iResult
            BigInt iRead
            UChar[] ucBuffer
            WString wsFile

            Delegate Get TempFile "encrypted.zip" to sFile
            Delegate Get BuildEncryptedZip sFile to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build encrypted zip"
            Move sFile to wsFile
            Move (ResizeArray (ucBuffer, 100)) to ucBuffer

            // No passphrase.
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_set_passphrase_callback (pArchive, 0, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_passphrase_callback 0"
            Move (archive_read_open_filename_w (pArchive, AddressOf (wsFile), 10240)) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "header of an encrypted entry"
            Send AssertIAreEqual 1 (archive_read_has_encrypted_entries (pArchive)) "encrypted entries were found"
            Move (archive_read_data (pArchive, AddressOf (ucBuffer), 100)) to iRead
            Send AssertBIAreEqual ARCHIVE_FAILED iRead "reading without passphrase fails"
            Delegate Get ErrorText pArchive to sMessage
            Send Assert (Pos ("Passphrase required", sMessage) > 0) ("error text:" * sMessage)
            Move (archive_read_free (pArchive)) to iResult

            // The right passphrase is found in the list.
            Move "wrong" to sWrong
            Move "secret" to sPassphrase
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_add_passphrase (pArchive, AddressOf (sWrong))) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "add wrong passphrase"
            Move (archive_read_add_passphrase (pArchive, AddressOf (sPassphrase))) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "add right passphrase"
            Move (archive_read_open_filename_w (pArchive, AddressOf (wsFile), 10240)) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Delegate Get ReadEntryData pArchive to sData
            Send AssertSAreEqual "Hello Archive" sData "decrypted data"
            Move (archive_read_free (pArchive)) to iResult

            // Only a wrong passphrase.
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_add_passphrase (pArchive, AddressOf (sWrong))) to iResult
            Move (archive_read_open_filename_w (pArchive, AddressOf (wsFile), 10240)) to iResult
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Move (archive_read_data (pArchive, AddressOf (ucBuffer), 100)) to iRead
            Send AssertBIAreEqual ARCHIVE_FAILED iRead "reading with a wrong passphrase fails"
            Move (archive_read_free (pArchive)) to iResult
            Delegate Send DeleteFileUtf8 sFile
        End_Procedure
    End_Object

    Object oOptionsTest is a cTest
        Procedure Test
            Pointer pArchive pEntry
            Integer iResult iIndex
            String sModule sOption sValue sOptions sName
            UChar[] ucZip

            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_zip (pArchive)) to iResult
            Move (archive_read_support_filter_all (pArchive)) to iResult
            Move "zip" to sModule
            Move "hdrcharset" to sOption
            Move "UTF-8" to sValue
            Move (archive_read_set_format_option (pArchive, AddressOf (sModule), AddressOf (sOption), AddressOf (sValue))) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_format_option zip:hdrcharset"
            Move (archive_read_set_format_option (pArchive, 0, AddressOf (sOption), AddressOf (sValue))) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_format_option any module"
            Move (archive_read_set_option (pArchive, AddressOf (sModule), AddressOf (sOption), AddressOf (sValue))) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_option zip:hdrcharset"
            Move "zip:hdrcharset=UTF-8" to sOptions
            Move (archive_read_set_options (pArchive, AddressOf (sOptions))) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_options"

            // Options nobody knows are reported as failed (nothing handled them).
            Move "does-not-exist" to sOption
            Move (archive_read_set_format_option (pArchive, AddressOf (sModule), AddressOf (sOption), AddressOf (sValue))) to iResult
            Send AssertIAreEqual ARCHIVE_FAILED iResult "set_format_option with an unknown option"
            Move (archive_read_set_filter_option (pArchive, 0, AddressOf (sOption), AddressOf (sValue))) to iResult
            Send AssertIAreEqual ARCHIVE_FAILED iResult "set_filter_option with an unknown option"
            Move (archive_read_set_option (pArchive, 0, AddressOf (sOption), AddressOf (sValue))) to iResult
            Send AssertIAreEqual ARCHIVE_FAILED iResult "set_option with an unknown option"

            // With hdrcharset=UTF-8 the reader converts the names to the locale of the C runtime (the "C" locale):
            // the pure ASCII names are fine, the name with non-ASCII characters is returned with a warning.
            Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open with options"
            For iIndex from 0 to 2
                Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
                Send AssertIAreEqual ARCHIVE_OK iResult "ASCII entry with options"
            Loop
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertIAreEqual ARCHIVE_WARN iResult "entry with non-ASCII name with options"
            Send AssertIAreEqual AE_IFREG (archive_entry_filetype (pEntry)) "the entry is returned"
            Send AssertBIAreEqual 12 (archive_entry_size (pEntry)) "size of the returned entry"
            Delegate Get ReadEntryData pArchive to sName
            Send AssertSAreEqual "Unicode name" sName "data of the returned entry"
            Move (archive_read_free (pArchive)) to iResult

            // The filter option reaches an existing filter reader.
            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_filter_gzip (pArchive)) to iResult
            Move "gzip" to sModule
            Move "ignored" to sOption
            Move (archive_read_set_filter_option (pArchive, AddressOf (sModule), AddressOf (sOption), AddressOf (sValue))) to iResult
            Send AssertIAreEqual ARCHIVE_FAILED iResult "set_filter_option on gzip (no read options exist)"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    // ---- extraction ----------------------------------------------------------------------------------------------

    // Extracts the sample archive below a folder: the entry path names are rewritten to absolute paths.
    // iMode 0: archive_read_extract, 1: archive_read_extract2 with a write_disk handle.
    Procedure ExtractSample String sFolderName Integer iMode
        String sMsg
        String sDir sPath sName sData
        Pointer pArchive pEntry pDisk
        Integer iIndex iResult iFlags
        UChar[] ucZip
        Void_Type iVoid

        Get TempFolder to sDir
        Move (Replaces ("\", sDir, "/") + sFolderName + "/") to sDir
        Move (ARCHIVE_EXTRACT_TIME ior ARCHIVE_EXTRACT_PERM) to iFlags

        Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucZip) to iResult
        Send AssertIAreEqual ARCHIVE_OK iResult (sFolderName * "build sample zip")
        Get NewReaderAll to pArchive
        Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
        Send AssertArchiveOk iResult pArchive (sFolderName * "open")
        If (iMode = 1) Begin
            Move (archive_write_disk_new ()) to pDisk
            Move (archive_write_disk_set_options (pDisk, iFlags)) to iResult
            Send AssertArchiveOk iResult pDisk (sFolderName * "write_disk_set_options")
        End

        For iIndex from 0 to 3
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Get Msg (sFolderName * "next header") iIndex to sMsg
            Send AssertArchiveOk iResult pArchive sMsg
            Get SampleEntryName iIndex to sName
            Move (sDir + sName) to sPath
            Move (archive_entry_set_pathname_utf8 (pEntry, AddressOf (sPath))) to iVoid
            If (iMode = 0) Begin
                Move (archive_read_extract (pArchive, pEntry, iFlags)) to iResult
            End
            Else Begin
                Move (archive_read_extract2 (pArchive, pEntry, pDisk)) to iResult
            End
            Get Msg (sFolderName * "extract") iIndex to sMsg
            Send AssertArchiveOk iResult pArchive sMsg
        Loop
        Move (archive_read_free (pArchive)) to iResult
        If (iMode = 1) Begin
            Move (archive_write_free (pDisk)) to iResult
        End

        // The files are on disk.
        Get PathExists (sDir + "hello.txt") to iResult
        Send Assert iResult (sFolderName * "hello.txt exists")
        Get ReadTextFile (sDir + "hello.txt") to sData
        Send AssertSAreEqual "Hello Archive" sData (sFolderName * "content of hello.txt")
        Get PathExists (sDir + "docs") to iResult
        Send Assert iResult (sFolderName * "docs exists")
        Send AssertIAreEqual 1 (IsDirectory (sDir + "docs")) (sFolderName * "docs is a directory")
        Get ReadTextFile (sDir + "docs/nested.txt") to sData
        Send AssertSAreEqual "Nested content" sData (sFolderName * "content of nested.txt")
        Get SampleEntryName 3 to sName
        Get PathExists (sDir + sName) to iResult
        Send Assert iResult (sFolderName * "file with unicode name exists")
        Get ReadTextFile (sDir + sName) to sData
        Send AssertSAreEqual "Unicode name" sData (sFolderName * "content of the unicode file")

        // Clean up
        Send DeleteFileUtf8 (sDir + "hello.txt")
        Send DeleteFileUtf8 (sDir + "docs/nested.txt")
        Send DeleteFileUtf8 (sDir + sName)
        Send RemoveDirectoryUtf8 (sDir + "docs")
        Send RemoveDirectoryUtf8 sDir
    End_Procedure

    Object oExtractTest is a cTest
        Procedure Test
            Delegate Send ExtractSample "extract1" 0
        End_Procedure
    End_Object

    Object oExtract2Test is a cTest
        Procedure Test
            Delegate Send ExtractSample "extract2" 1
        End_Procedure
    End_Object

    // The skip file functions can be called; the Windows disk writer of libarchive 3.7.7 does not implement the check
    // (an entry with the registered device and inode is extracted anyway). The progress callback accepts 0.
    Object oExtractSkipFileTest is a cTest
        Procedure Test
            String sDir sPath
            Pointer pArchive pEntry pDisk
            Integer iResult
            UChar[] ucZip
            Void_Type iVoid
            BigInt iBig

            Delegate Get TempFolder to sDir
            Move (Replaces ("\", sDir, "/") + "extract3/") to sDir
            Move (sDir + "skipped.txt") to sPath
            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucZip) to iResult
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "open"
            Move (archive_read_extract_set_progress_callback (pArchive, 0, 0)) to iVoid
            Move (archive_read_extract_set_skip_file (pArchive, 7, 9)) to iVoid
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Move (archive_entry_set_pathname_utf8 (pEntry, AddressOf (sPath))) to iVoid
            Move (archive_entry_set_dev (pEntry, 7)) to iVoid
            Move (archive_entry_set_ino64 (pEntry, 9)) to iVoid
            Move (archive_read_extract (pArchive, pEntry, 0)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "read_extract with skip file (not honored by the Windows writer)"
            Delegate Get PathExists sPath to iResult
            Send Assert iResult "the entry is extracted although it is the skip file"
            Delegate Send DeleteFileUtf8 sPath

            Move (archive_write_disk_new ()) to pDisk
            Move (archive_write_disk_set_skip_file (pDisk, 7, 9)) to iResult
            Move (archive_entry_set_pathname_utf8 (pEntry, AddressOf (sPath))) to iVoid
            Move (archive_read_extract2 (pArchive, pEntry, pDisk)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "read_extract2 with skip file (not honored by the Windows writer)"
            Delegate Get PathExists sPath to iResult
            Send Assert iResult "the entry is extracted although it is the skip file (write_disk)"
            Move (archive_write_free (pDisk)) to iResult
            Move (archive_read_free (pArchive)) to iResult
            Delegate Send DeleteFileUtf8 sPath
            Delegate Send RemoveDirectoryUtf8 sDir
        End_Procedure
    End_Object

    // ---- close and free ------------------------------------------------------------------------------------------

    Object oCloseAndFreeTest is a cTest
        Procedure Test
            Pointer pArchive pEntry
            Integer iResult
            UChar[] ucZip

            Delegate Get BuildSampleArchiveMemory ARCHIVE_FORMAT_ZIP (&ucZip) to iResult
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Move (archive_read_close (pArchive)) to iResult
            Delegate Send AssertArchiveOk iResult pArchive "close"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "no header after close"
            Move (archive_read_free (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "free after close"

            // The deprecated synonym of archive_read_free.
            Delegate Get NewReaderAll to pArchive
            Move (archive_read_open_memory (pArchive, AddressOf (ucZip), SizeOfArray (ucZip))) to iResult
            Move (archive_read_finish (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "finish"
        End_Procedure
    End_Object
End_Object
