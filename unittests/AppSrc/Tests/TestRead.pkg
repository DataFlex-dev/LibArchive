            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_cab (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "cab reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_lha (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "lha reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_rar (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "rar reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_rar5 (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "rar5 reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_xar (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "xar reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_warc (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "warc reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_iso9660 (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "iso9660 reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_cpio (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "cpio reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_ar (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "ar reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_mtree (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "mtree reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_gnutar (pArchive)) to iResult
            Delegate Get OpenMemoryNextHeader pArchive (&ucZip) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "gnutar reader on zip data"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_zip (pArchive)) to iResult
