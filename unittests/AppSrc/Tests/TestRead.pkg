// Tests for the reader functions of ArchiveRead.h.pkg: support functions for formats and filters, open variants,
// entries and data, options, passphrases, extraction and the deprecated names.
//
// Callbacks cannot be created from DataFlex, so all callback taking functions are only called with 0 (NULL).
// File descriptors and FILE pointers must come from the C runtime that libarchive uses (the universal CRT), so
// _open/_close/_write/_wfopen/fclose are declared here from ucrtbase.dll and not from msvcrt.dll.
External_Function Read_CrtOpen "_open" ucrtbase.dll ;
    Pointer pPath ;
    Integer iFlags ;
    Integer iMode ;
    Returns Integer

External_Function Read_CrtClose "_close" ucrtbase.dll ;
    Integer iFd ;
    Returns Integer

External_Function Read_CrtWrite "_write" ucrtbase.dll ;
    Integer iFd ;
    Pointer pBuffer ;
    UInteger iCount ;
    Returns Integer

External_Function Read_CrtWFopen "_wfopen" ucrtbase.dll ;
    Pointer pPath ;
    Pointer pMode ;
    Returns Pointer

External_Function Read_CrtFclose "fclose" ucrtbase.dll ;
    Pointer pFile ;
    Returns Integer

External_Function Read_MoveMemory "RtlMoveMemory" ntdll.dll ;
    Pointer pDest ;
    Pointer pSource ;
    Longptr iLength ;
    Returns Void_Type

External_Function Read_DeleteFileW "DeleteFileW" kernel32.dll ;
    Pointer pPath ;
    Returns Integer

External_Function Read_RemoveDirectoryW "RemoveDirectoryW" kernel32.dll ;
    Pointer pPath ;
    Returns Integer

External_Function Read_GetFileAttributesW "GetFileAttributesW" kernel32.dll ;
    Pointer pPath ;
    Returns Integer

// Zero terminated array of 2 pointers (for archive_read_open_filenames and _w).
Struct tReadNamePointers
    Pointer pName1
    Pointer pName2
    Pointer pEnd
End_Struct

Object oReadTests is a cArchiveTestFixture
    Set psTestFixtureName to "Read"

    // Set by tests: skip the size check (streamed readers do not know the size at the header), expect directories
    // after the files (7zip) and the error text of the last failed BuildSingleFileArchive.
    Property Boolean pbSkipSizeCheck False
    Property Boolean pbDirsLast False
    Property Boolean pbSkipUnicodeName False
    Property Integer piExtraDataBytes 0
    Property String psBuildError ""

    // ---- helpers -------------------------------------------------------------------------------------------------

    // Message text with a number (the * operator multiplies when one operand is a number).
    Function Msg String sText Integer iNumber Returns String
        String sNumber
        Move iNumber to sNumber
        Function_Return (sText + " " + sNumber)
    End_Function

    // Copies iLength bytes of a UChar array into a string.
    Function BytesToString UChar[] ucData Integer iLength Returns String
        Integer iIndex
        String sResult
        Move "" to sResult
        For iIndex from 0 to (iLength - 1)
            Move (sResult + Character (ucData[iIndex])) to sResult
        Loop
        Function_Return sResult
    End_Function

    // Reads the complete data of the current entry with archive_read_data.
    Function ReadEntryData Pointer pArchive Returns String
        String sBytesToString
        UChar[] ucBuffer
        BigInt iRead
        String sResult

        Move "" to sResult
        Move (ResizeArray (ucBuffer, 4096)) to ucBuffer
        Move (archive_read_data (pArchive, AddressOf (ucBuffer), 4096)) to iRead
        While (iRead > 0)
            Get BytesToString ucBuffer iRead to sBytesToString
            Move (sResult + sBytesToString) to sResult
            Move (archive_read_data (pArchive, AddressOf (ucBuffer), 4096)) to iRead
        Loop
        Function_Return sResult
    End_Function

    // Returns the text of a file in the temp folder (read binary).
    Function ReadTextFile String sFile Returns String
        Integer iChannel
        String sData

        Move "" to sData
        Move (Seq_New_Channel ()) to iChannel
        Direct_Input channel iChannel ("binary:" + sFile)
        If (not (SeqEof)) Begin
            Read_Block channel iChannel sData 100000
        End
        Close_Input channel iChannel
        Send Seq_Release_Channel iChannel
        Function_Return sData
    End_Function

    // Creates a file with the given text (binary).
    Procedure WriteTextFile String sFile String sData
        Integer iChannel

        Move (Seq_New_Channel ()) to iChannel
        Direct_Output channel iChannel ("binary:" + sFile)
        Write channel iChannel sData
        Close_Output channel iChannel
        Send Seq_Release_Channel iChannel
    End_Procedure

    // Win32 file existence test that works with unicode (UTF-8 string) path names.
    Function PathExists String sPath Returns Boolean
        WString wsPath
        Move sPath to wsPath
        Function_Return (Read_GetFileAttributesW (AddressOf (wsPath)) <> -1)
    End_Function

    Procedure DeleteFileUtf8 String sPath
        WString wsPath
        Integer iResult
        Move sPath to wsPath
        Move (Read_DeleteFileW (AddressOf (wsPath))) to iResult
    End_Procedure

    Procedure RemoveDirectoryUtf8 String sPath
        WString wsPath
        Integer iResult
        Move sPath to wsPath
        Move (Read_RemoveDirectoryW (AddressOf (wsPath))) to iResult
    End_Procedure

    // Writes iCount bytes of the array, beginning at iFrom, to a new file.
    Function WriteBytesToFile String sFile UChar[] ucData Integer iFrom Integer iCount Returns Integer
        Integer iFd iWritten
        String sPath
        Pointer pPart

        Move sFile to sPath
        Move (Read_CrtOpen (AddressOf (sPath), 33537, 384)) to iFd
        If (iFd < 0) Begin
            Function_Return -1
        End
        Move (AddressOf (ucData) + iFrom) to pPart
        Move (Read_CrtWrite (iFd, pPart, iCount)) to iWritten
        Move (Read_CrtClose (iFd)) to iFd
        Function_Return iWritten
    End_Function

    // Writes a one file archive (formats that cannot store the sample directory like ar or warc).
    Function BuildSingleFileArchive String sFile Integer eFormat String sName String sContent Returns Integer
        BigInt biSampleMTime
        String sErrorText
        Pointer pArchive pEntry
        Integer iResult
        BigInt iWritten
        WString wsFile
        Void_Type iVoid

        Move sFile to wsFile
        Move (archive_write_new ()) to pArchive
        // archive_write_set_format does not know the ar variants
        If (eFormat = ARCHIVE_FORMAT_AR_GNU) Begin
            Move (archive_write_set_format_ar_svr4 (pArchive)) to iResult
        End
        Else If (eFormat = ARCHIVE_FORMAT_AR_BSD) Begin
            Move (archive_write_set_format_ar_bsd (pArchive)) to iResult
        End
        Else Begin
            Move (archive_write_set_format (pArchive, eFormat)) to iResult
        End
        If (iResult = ARCHIVE_OK) Begin
            Move (archive_write_open_filename_w (pArchive, AddressOf (wsFile))) to iResult
        End
        If (iResult = ARCHIVE_OK) Begin
            Move (archive_entry_new ()) to pEntry
            Move (archive_entry_set_pathname_utf8 (pEntry, AddressOf (sName))) to iVoid
            Move (archive_entry_set_filetype (pEntry, AE_IFREG)) to iVoid
            Move (archive_entry_set_perm (pEntry, 420)) to iVoid
            Get SampleMTime to biSampleMTime
            Move (archive_entry_set_mtime (pEntry, biSampleMTime, 0)) to iVoid
            Move (archive_entry_set_size (pEntry, SizeOfString (sContent))) to iVoid
            Move (archive_write_header (pArchive, pEntry)) to iResult
            If (iResult = ARCHIVE_OK) Begin
                Move (archive_write_data (pArchive, AddressOf (sContent), SizeOfString (sContent))) to iWritten
                If (iWritten <> SizeOfString (sContent)) Begin
                    Move ARCHIVE_FATAL to iResult
                End
            End
            Move (archive_entry_free (pEntry)) to iVoid
        End
        If (iResult = ARCHIVE_OK) Begin
            Move (archive_write_close (pArchive)) to iResult
        End
        If (iResult <> ARCHIVE_OK) Begin
            Get ErrorText pArchive to sErrorText
            Set psBuildError to sErrorText
        End
        Move (archive_write_free (pArchive)) to iVoid
        Function_Return iResult
    End_Function

    // Name of an entry as UTF-8 string, read from the wide (UTF-16) name: this works for all formats, while the
    // UTF-8 name of some readers is converted to the locale of the C runtime.
    Function EntryName Pointer pEntry Returns String
        Pointer pText
        WString wsName
        String sName

        Move (archive_entry_pathname_w (pEntry)) to pText
        If (pText = 0) Begin
            Function_Return ""
        End
        Move (PointerToWString (pText)) to wsName
        Move wsName to sName
        Function_Return sName
    End_Function

    // Reads all sample entries from an opened archive and checks names, types, sizes, times and data. With bFull
    // False (formats that do not store data, like mtree) only the number of entries is checked. The end of the
    // archive must follow after the last entry.
    Procedure VerifySample Pointer pArchive String sLabel Boolean bFull
        String sMsg
        Boolean bSampleEntryIsDirectory
        BigInt biSampleMTime
        Pointer pEntry
        Integer iIndex iCount iResult iType iPosition
        String sName sExpected sData
        BigInt iSize
        Boolean bDirsLast bSkipSize bSkipUnicode

        Get pbSkipUnicodeName to bSkipUnicode
        Get pbDirsLast to bDirsLast
        Get pbSkipSizeCheck to bSkipSize
        Get SampleEntryCount to iCount
        For iPosition from 0 to (iCount - 1)
            // 7zip stores the directory after the files
            Move iPosition to iIndex
            If bDirsLast Begin
                If (iPosition = 1) Begin
                    Move 2 to iIndex
                End
                If (iPosition = 2) Begin
                    Move 3 to iIndex
                End
                If (iPosition = 3) Begin
                    Move 1 to iIndex
                End
            End
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Get Msg (sLabel * "next header") iIndex to sMsg
            Send AssertArchiveOk iResult pArchive sMsg
            If (iResult <> ARCHIVE_OK) Begin
                Procedure_Return
            End
            If bFull Begin
                Get EntryName pEntry to sName
                If (Right (sName, 1) = "/") Begin
                    Move (Left (sName, Length (sName) - 1)) to sName
                End
                Get SampleEntryName iIndex to sExpected
                If (Right (sExpected, 1) = "/") Begin
                    Move (Left (sExpected, Length (sExpected) - 1)) to sExpected
                End
                If (bSkipUnicode = False or iIndex <> 3) Begin
                    Get Msg (sLabel * "name") iIndex to sMsg
                    Send AssertSAreEqual sExpected sName sMsg
                End

                Move (archive_entry_filetype (pEntry)) to iType
                Get SampleEntryIsDirectory iIndex to bSampleEntryIsDirectory
                If bSampleEntryIsDirectory Begin
                    Send AssertIAreEqual AE_IFDIR iType (sLabel * "type of" * sExpected)
                End
                Else Begin
                    Send AssertIAreEqual AE_IFREG iType (sLabel * "type of" * sExpected)
                    Get SampleEntryContent iIndex to sExpected
                    If (bSkipSize = False) Begin
                        Move (archive_entry_size (pEntry)) to iSize
                        Get Msg (sLabel * "size") iIndex to sMsg
                        Send AssertBIAreEqual (SizeOfString (sExpected)) iSize sMsg
                    End
                    Get ReadEntryData pArchive to sData
                    Get Msg (sLabel * "data") iIndex to sMsg
                    Send AssertSAreEqual sExpected sData sMsg
                End
                Get SampleMTime to biSampleMTime
                Get Msg (sLabel * "mtime") iIndex to sMsg
                Send AssertBIAreEqual biSampleMTime (archive_entry_mtime (pEntry)) sMsg
            End
        Loop
        Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
        Send AssertIAreEqual ARCHIVE_EOF iResult (sLabel * "end of archive")
    End_Procedure

    // Opens sFile with the (already configured) reader, verifies the sample entries and the format code and frees
    // the reader. The format code is compared after masking with iMask.
    Procedure VerifyFile Pointer pArchive String sFile String sLabel Boolean bFull Integer iExpectedFormat Integer iMask
        WString wsFile
        Integer iResult

        Move sFile to wsFile
        Move (archive_read_open_filename_w (pArchive, AddressOf (wsFile), 10240)) to iResult
        Send AssertArchiveOk iResult pArchive (sLabel * "open")
        If (iResult = ARCHIVE_OK) Begin
            Send VerifySample pArchive sLabel bFull
            Send AssertIAreEqual iExpectedFormat ((archive_format (pArchive)) iand iMask) (sLabel * "format code")
        End
        Move (archive_read_free (pArchive)) to iResult
        Send AssertIAreEqual ARCHIVE_OK iResult (sLabel * "free")
    End_Procedure

    // Opens a reader with all formats and filters.
    Function NewReaderAll Returns Pointer
        Pointer pArchive
        Integer iResult
        Move (archive_read_new ()) to pArchive
        Move (archive_read_support_format_all (pArchive)) to iResult
        Move (archive_read_support_filter_all (pArchive)) to iResult
        Function_Return pArchive
    End_Function

    // Enables one format reader (iWhich: 0 zip, 1 tar, 2 gnutar, 3 cpio, 4 7zip, 6 mtree, 7 zip streamable,
    // 8 zip seekable, 9 ar, 10 warc, 11 iso9660) by its specific function.
    Function SupportFormat Pointer pArchive Integer iWhich Returns Integer
        If (iWhich = 0) Function_Return (archive_read_support_format_zip (pArchive))
        If (iWhich = 1) Function_Return (archive_read_support_format_tar (pArchive))
        If (iWhich = 2) Function_Return (archive_read_support_format_gnutar (pArchive))
        If (iWhich = 3) Function_Return (archive_read_support_format_cpio (pArchive))
        If (iWhich = 4) Function_Return (archive_read_support_format_7zip (pArchive))
        If (iWhich = 6) Function_Return (archive_read_support_format_mtree (pArchive))
        If (iWhich = 7) Function_Return (archive_read_support_format_zip_streamable (pArchive))
        If (iWhich = 8) Function_Return (archive_read_support_format_zip_seekable (pArchive))
        If (iWhich = 9) Function_Return (archive_read_support_format_ar (pArchive))
        If (iWhich = 10) Function_Return (archive_read_support_format_warc (pArchive))
        If (iWhich = 11) Function_Return (archive_read_support_format_iso9660 (pArchive))
        Function_Return ARCHIVE_FATAL
    End_Function

    // Builds a sample archive file, reads it with a reader that only has the format reader iWhich and verifies it.
    Procedure FormatRoundTrip String sLabel Integer eWriteFormat Integer iWhich Boolean bFull Integer iExpectedFormat Integer iMask
        String sFile
        Pointer pArchive
        Integer iResult

        Get TempFile ("fmt-" + sLabel + ".bin") to sFile
        Get BuildSampleArchiveFile sFile eWriteFormat ARCHIVE_FILTER_NONE to iResult
        Send AssertIAreEqual ARCHIVE_OK iResult (sLabel * "build sample archive")
        If (iResult = ARCHIVE_OK) Begin
            Move (archive_read_new ()) to pArchive
            Get SupportFormat pArchive iWhich to iResult
            Send AssertArchiveOk iResult pArchive (sLabel * "support format")
            Send VerifyFile pArchive sFile sLabel bFull iExpectedFormat iMask
        End
        Send DeleteFileUtf8 sFile
    End_Procedure

    // Enables one filter reader by its specific function.
    Function SupportFilter Pointer pArchive Integer eFilter Returns Integer
        If (eFilter = ARCHIVE_FILTER_GZIP) Function_Return (archive_read_support_filter_gzip (pArchive))
        If (eFilter = ARCHIVE_FILTER_BZIP2) Function_Return (archive_read_support_filter_bzip2 (pArchive))
        If (eFilter = ARCHIVE_FILTER_COMPRESS) Function_Return (archive_read_support_filter_compress (pArchive))
        If (eFilter = ARCHIVE_FILTER_LZMA) Function_Return (archive_read_support_filter_lzma (pArchive))
        If (eFilter = ARCHIVE_FILTER_XZ) Function_Return (archive_read_support_filter_xz (pArchive))
        If (eFilter = ARCHIVE_FILTER_LZIP) Function_Return (archive_read_support_filter_lzip (pArchive))
        If (eFilter = ARCHIVE_FILTER_LZ4) Function_Return (archive_read_support_filter_lz4 (pArchive))
        If (eFilter = ARCHIVE_FILTER_ZSTD) Function_Return (archive_read_support_filter_zstd (pArchive))
        If (eFilter = ARCHIVE_FILTER_UU) Function_Return (archive_read_support_filter_uu (pArchive))
        Function_Return ARCHIVE_FATAL
    End_Function

    // Writes a tar with the filter, reads it three times: with the specific support function, with
    // support_filter_by_code and with append_filter (no detection). The filter code of filter 0 must match.
    Procedure FilterRoundTrip String sLabel Integer eFilter String sFilterName Boolean bAppend
        String sMsg
        String sFile
        Pointer pArchive
        Integer iResult iPass iLastPass
        WString wsFile

        Get TempFile ("flt-" + sLabel + ".bin") to sFile
        Get BuildSampleArchiveFile sFile ARCHIVE_FORMAT_TAR eFilter to iResult
        Send AssertIAreEqual ARCHIVE_OK iResult (sLabel * "build sample archive")
        If (iResult <> ARCHIVE_OK) Begin
            Send DeleteFileUtf8 sFile
            Procedure_Return
        End
        Move sFile to wsFile

        Move 2 to iLastPass
        If (bAppend = False) Begin
            Move 1 to iLastPass
        End
        For iPass from 0 to iLastPass
            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_tar (pArchive)) to iResult
            If (iPass = 0) Begin
                Get SupportFilter pArchive eFilter to iResult
                Send AssertArchiveOk iResult pArchive (sLabel * "support filter")
            End
            If (iPass = 1) Begin
                Move (archive_read_support_filter_by_code (pArchive, eFilter)) to iResult
                Send AssertArchiveOk iResult pArchive (sLabel * "support filter by code")
            End
            If (iPass = 2) Begin
                Move (archive_read_append_filter (pArchive, eFilter)) to iResult
                Send AssertArchiveOk iResult pArchive (sLabel * "append filter")
            End
            Move (archive_read_open_filename_w (pArchive, AddressOf (wsFile), 10240)) to iResult
            Get Msg (sLabel * "open pass") iPass to sMsg
            Send AssertArchiveOk iResult pArchive sMsg
            If (iResult = ARCHIVE_OK) Begin
                Get Msg (sLabel * "pass") iPass to sMsg
                Send VerifySample pArchive sMsg True
                Get Msg (sLabel * "filter code pass") iPass to sMsg
                Send AssertIAreEqual eFilter (archive_filter_code (pArchive, 0)) sMsg
                Get Msg (sLabel * "filter name pass") iPass to sMsg
                Send AssertSAreEqual sFilterName (PointerToString (archive_filter_name (pArchive, 0))) sMsg
            End
            Move (archive_read_free (pArchive)) to iResult
        Loop
        Send DeleteFileUtf8 sFile
    End_Procedure

    // Opens the zip bytes in memory and returns the result of the first archive_read_next_header.
    Function OpenMemoryNextHeader Pointer pArchive UChar[] ByRef ucData Returns Integer
        Pointer pEntry
        Integer iResult
        Move (archive_read_open_memory (pArchive, AddressOf (ucData), SizeOfArray (ucData))) to iResult
        If (iResult <> ARCHIVE_OK) Begin
            Function_Return iResult
        End
        Function_Return (archive_read_next_header (pArchive, AddressOf (pEntry)))
    End_Function

    // Writes the sample as zip with encrypted entries (traditional zip encryption, passphrase "secret").
    Function BuildEncryptedZip String sFile Returns Integer
        Pointer pArchive
        Integer iResult
        WString wsFile
        String sOptions sPassphrase
        Void_Type iVoid

        Move sFile to wsFile
        Move "zip:encryption=zipcrypt" to sOptions
        Move "secret" to sPassphrase
        Move (archive_write_new ()) to pArchive
        Move (archive_write_set_format (pArchive, ARCHIVE_FORMAT_ZIP)) to iResult
        If (iResult = ARCHIVE_OK) Begin
            Move (archive_write_set_options (pArchive, AddressOf (sOptions))) to iResult
        End
        If (iResult = ARCHIVE_OK) Begin
            Move (archive_write_set_passphrase (pArchive, AddressOf (sPassphrase))) to iResult
        End
        If (iResult = ARCHIVE_OK) Begin
            Move (archive_write_open_filename_w (pArchive, AddressOf (wsFile))) to iResult
        End
        If (iResult = ARCHIVE_OK) Begin
            Get WriteSampleEntries pArchive to iResult
        End
        If (iResult = ARCHIVE_OK) Begin
            Move (archive_write_close (pArchive)) to iResult
        End
        Move (archive_write_free (pArchive)) to iVoid
        Function_Return iResult
    End_Function

    // Writes a one file archive and reads it with the format reader iWhich (see SupportFormat).
    Procedure SingleFileRoundTrip String sLabel Integer eWriteFormat Integer iWhich String sName String sContent Integer iExpectedFormat
        String sFile sReadName sData sBuildError
        Pointer pArchive pEntry
        Integer iResult iExtra
        WString wsFile

        Get TempFile ("single-" + sLabel + ".bin") to sFile
        Get BuildSingleFileArchive sFile eWriteFormat sName sContent to iResult
        Get psBuildError to sBuildError
        Send AssertIAreEqual ARCHIVE_OK iResult (sLabel * "build archive" * sBuildError)
        If (iResult = ARCHIVE_OK) Begin
            Move sFile to wsFile
            Move (archive_read_new ()) to pArchive
            Get SupportFormat pArchive iWhich to iResult
            Send AssertArchiveOk iResult pArchive (sLabel * "support format")
            Move (archive_read_open_filename_w (pArchive, AddressOf (wsFile), 10240)) to iResult
            Send AssertArchiveOk iResult pArchive (sLabel * "open")
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            // iso9660 starts with the root directory
            While (iResult = ARCHIVE_OK and archive_entry_filetype (pEntry) <> AE_IFREG)
                Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Loop
            Send AssertArchiveOk iResult pArchive (sLabel * "next header")
            If (iResult = ARCHIVE_OK) Begin
                Get EntryName pEntry to sReadName
                Send Assert (Pos (sName, sReadName) > 0) (sLabel * "entry name" * sReadName)
                Send AssertBIAreEqual (SizeOfString (sContent)) (archive_entry_size (pEntry)) (sLabel * "entry size")
                Get ReadEntryData pArchive to sData
                Get piExtraDataBytes to iExtra
                Send AssertIAreEqual (SizeOfString (sContent) + iExtra) (SizeOfString (sData)) (sLabel * "data length")
                Send AssertSAreEqual sContent (Left (sData, SizeOfString (sContent))) (sLabel * "data")
                Send AssertIAreEqual iExpectedFormat ((archive_format (pArchive)) iand ARCHIVE_FORMAT_BASE_MASK) (sLabel * "format")
                Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
                Send AssertIAreEqual ARCHIVE_EOF iResult (sLabel * "end of archive")
            End
            Move (archive_read_free (pArchive)) to iResult
        End
        Send DeleteFileUtf8 sFile
    End_Procedure

    // Asserts that opening succeeded, verifies the sample entries (full check) and frees the reader.
    Procedure OpenAndVerify Pointer pArchive Integer iOpenResult String sLabel
        Integer iResult
        Send AssertArchiveOk iOpenResult pArchive (sLabel * "open")
        If (iOpenResult = ARCHIVE_OK) Begin
            Send VerifySample pArchive sLabel True
        End
        Move (archive_read_free (pArchive)) to iResult
    End_Procedure

    // ---- format support ------------------------------------------------------------------------------------------

    Object oFormatZipTest is a cTest
        Procedure Test
            Delegate Send FormatRoundTrip "zip" ARCHIVE_FORMAT_ZIP 0 True ARCHIVE_FORMAT_ZIP ARCHIVE_FORMAT_BASE_MASK
            // The streamable reader does not know the size of an entry before its data was read (data descriptors).
            Delegate Set pbSkipSizeCheck to True
            Delegate Send FormatRoundTrip "zip-streamable" ARCHIVE_FORMAT_ZIP 7 True ARCHIVE_FORMAT_ZIP ARCHIVE_FORMAT_BASE_MASK
            Delegate Set pbSkipSizeCheck to False
            Delegate Send FormatRoundTrip "zip-seekable" ARCHIVE_FORMAT_ZIP 8 True ARCHIVE_FORMAT_ZIP ARCHIVE_FORMAT_BASE_MASK
        End_Procedure
    End_Object

    Object oFormatTarTest is a cTest
        Procedure Test
            Delegate Send FormatRoundTrip "tar" ARCHIVE_FORMAT_TAR 1 True ARCHIVE_FORMAT_TAR ARCHIVE_FORMAT_BASE_MASK
            Delegate Send FormatRoundTrip "ustar" ARCHIVE_FORMAT_TAR_USTAR 1 True ARCHIVE_FORMAT_TAR_USTAR 16777215
            Delegate Send FormatRoundTrip "pax" ARCHIVE_FORMAT_TAR_PAX_INTERCHANGE 1 True ARCHIVE_FORMAT_TAR_PAX_INTERCHANGE 16777215
            Delegate Send FormatRoundTrip "gnutar" ARCHIVE_FORMAT_TAR_GNUTAR 2 True ARCHIVE_FORMAT_TAR_GNUTAR 16777215
            Delegate Send FormatRoundTrip "gnutar-by-tar" ARCHIVE_FORMAT_TAR_GNUTAR 1 True ARCHIVE_FORMAT_TAR_GNUTAR 16777215
        End_Procedure
    End_Object

    Object oFormatCpioTest is a cTest
        Procedure Test
            Delegate Send FormatRoundTrip "cpio" ARCHIVE_FORMAT_CPIO 3 True ARCHIVE_FORMAT_CPIO_POSIX 16777215
            Delegate Send FormatRoundTrip "cpio-newc" ARCHIVE_FORMAT_CPIO_SVR4_NOCRC 3 True ARCHIVE_FORMAT_CPIO_SVR4_NOCRC 16777215
        End_Procedure
    End_Object

    Object oFormat7ZipTest is a cTest
        Procedure Test
            // 7zip stores the directory entry after the file entries.
            // The names with non-ASCII characters are damaged by the 7zip writer in the "C" locale (the characters
            // are stored as 0xFFxx), so that name is not compared.
            Delegate Set pbDirsLast to True
            Delegate Set pbSkipUnicodeName to True
            Delegate Send FormatRoundTrip "7z" ARCHIVE_FORMAT_7ZIP 4 True ARCHIVE_FORMAT_7ZIP ARCHIVE_FORMAT_BASE_MASK
            Delegate Set pbDirsLast to False
            Delegate Set pbSkipUnicodeName to False
        End_Procedure
    End_Object

    // This archive.dll was built without xar support (libxml2/expat): the reader is not available.
    Object oFormatXarTest is a cTest
        Procedure Test
            Pointer pArchive
            Integer iResult
            String sMessage

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_xar (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_WARN iResult "support_format_xar"
            Delegate Get ErrorText pArchive to sMessage
            Send AssertSAreEqual "Xar not supported on this platform" sMessage "xar error text"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    Object oFormatMtreeTest is a cTest
        Procedure Test
            Delegate Send FormatRoundTrip "mtree" ARCHIVE_FORMAT_MTREE 6 False ARCHIVE_FORMAT_MTREE ARCHIVE_FORMAT_BASE_MASK
        End_Procedure
    End_Object

    Object oFormatArTest is a cTest
        Procedure Test
            Delegate Send SingleFileRoundTrip "ar" ARCHIVE_FORMAT_AR_GNU 9 "hello.txt" "Hello Archive" ARCHIVE_FORMAT_AR
            Delegate Send SingleFileRoundTrip "ar-bsd" ARCHIVE_FORMAT_AR_BSD 9 "hello.txt" "Hello Archive" ARCHIVE_FORMAT_AR
        End_Procedure
    End_Object

    Object oFormatWarcTest is a cTest
        Procedure Test
            // The warc reader delivers the 4 bytes (CR LF CR LF) that end the record after the data.
            Delegate Set piExtraDataBytes to 4
            Delegate Send SingleFileRoundTrip "warc" ARCHIVE_FORMAT_WARC 10 "hello.txt" "Hello Archive" ARCHIVE_FORMAT_WARC
            Delegate Set piExtraDataBytes to 0
        End_Procedure
    End_Object

    Object oFormatIso9660Test is a cTest
        Procedure Test
            Delegate Send SingleFileRoundTrip "iso" ARCHIVE_FORMAT_ISO9660 11 "hello.txt" "Hello Archive" ARCHIVE_FORMAT_ISO9660
        End_Procedure
    End_Object

    // The raw format presents any data as one entry named "data"; the empty format accepts a zero byte file.
    Object oFormatRawAndEmptyTest is a cTest
        Procedure Test
            Pointer pArchive pEntry
            Integer iResult
            String sFile sData sText
            WString wsFile
            UChar[] ucNothing

            Move "Just some plain text" to sText
            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_raw (pArchive)) to iResult
            Send AssertArchiveOk iResult pArchive "support raw"
            Move (archive_read_open_memory (pArchive, AddressOf (sText), SizeOfString (sText))) to iResult
            Send AssertArchiveOk iResult pArchive "open raw"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertArchiveOk iResult pArchive "raw header"
            Send AssertSAreEqual "data" (PointerToString (archive_entry_pathname (pEntry))) "raw entry name"
            Send AssertIAreEqual ARCHIVE_FORMAT_RAW ((archive_format (pArchive)) iand ARCHIVE_FORMAT_BASE_MASK) "raw format"
            Delegate Get ReadEntryData pArchive to sData
            Send AssertSAreEqual sText sData "raw data"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertIAreEqual ARCHIVE_EOF iResult "raw end"
            Move (archive_read_free (pArchive)) to iResult

            Delegate Get TempFile "empty.bin" to sFile
            Delegate Send WriteTextFile sFile ""
            Move sFile to wsFile
            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_empty (pArchive)) to iResult
            Send AssertArchiveOk iResult pArchive "support empty"
            Move (archive_read_open_filename_w (pArchive, AddressOf (wsFile), 10240)) to iResult
            Send AssertArchiveOk iResult pArchive "open empty"
            Move (archive_read_next_header (pArchive, AddressOf (pEntry))) to iResult
            Send AssertIAreEqual ARCHIVE_EOF iResult "empty file has no entries"
            Send AssertIAreEqual ARCHIVE_FORMAT_EMPTY ((archive_format (pArchive)) iand ARCHIVE_FORMAT_BASE_MASK) "empty format"
            Move (archive_read_free (pArchive)) to iResult
            Delegate Send DeleteFileUtf8 sFile
        End_Procedure
    End_Object

    // All support functions that only enable something: they must report ARCHIVE_OK. A reader has 16 slots for
    // format readers (the zip functions take two), therefore several readers are used.
    Object oSupportFormatCallsTest is a cTest
        Procedure Test
            Pointer pArchive
            Integer iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_7zip (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_7zip"
            Move (archive_read_support_format_ar (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_ar"
            Move (archive_read_support_format_cab (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_cab"
            Move (archive_read_support_format_cpio (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_cpio"
            Move (archive_read_support_format_empty (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_empty"
            Move (archive_read_support_format_gnutar (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_gnutar"
            Move (archive_read_support_format_iso9660 (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_iso9660"
            Move (archive_read_support_format_lha (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_lha"
            Move (archive_read_support_format_mtree (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_mtree"
            Move (archive_read_support_format_rar (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_rar"
            Move (archive_read_support_format_rar5 (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_rar5"
            Move (archive_read_support_format_raw (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_raw"
            Move (archive_read_support_format_tar (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_tar"
            Move (archive_read_support_format_warc (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_warc"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_xar (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_WARN iResult "format_xar (not built into this archive.dll)"
            Move (archive_read_support_format_zip (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_zip"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_zip_streamable (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_zip_streamable"
            Move (archive_read_support_format_zip_seekable (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_zip_seekable"
            Move (archive_read_free (pArchive)) to iResult

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_all (pArchive)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "format_all"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

    Object oSupportFormatByCodeTest is a cTest
        Procedure Test
            Pointer pArchive
            Integer iResult
            String sFile

            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_ZIP)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code zip"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_TAR)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code tar"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_CPIO)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code cpio"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_7ZIP)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code 7zip"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_AR)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code ar"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_XAR)) to iResult
            Send AssertIAreEqual ARCHIVE_WARN iResult "by code xar (not built into this archive.dll)"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_MTREE)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code mtree"
            Move (archive_read_free (pArchive)) to iResult
            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_ISO9660)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code iso9660"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_LHA)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code lha"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_CAB)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code cab"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_RAR)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code rar"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_RAR_V5)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code rar5"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_WARC)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code warc"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_RAW)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code raw"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_EMPTY)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "by code empty"
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_SHAR)) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "by code shar (no reader exists)"
            Move (archive_read_free (pArchive)) to iResult

            // A reader that only knows zip (by code) reads a zip archive.
            Delegate Get TempFile "bycode.zip" to sFile
            Delegate Get BuildSampleArchiveFile sFile ARCHIVE_FORMAT_ZIP ARCHIVE_FILTER_NONE to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample zip"
            Move (archive_read_new ()) to pArchive
            Move (archive_read_support_format_by_code (pArchive, ARCHIVE_FORMAT_ZIP)) to iResult
            Delegate Send VerifyFile pArchive sFile "by-code zip" True ARCHIVE_FORMAT_ZIP ARCHIVE_FORMAT_BASE_MASK
            Delegate Send DeleteFileUtf8 sFile
        End_Procedure
    End_Object

    // set_format selects exactly one format and bypasses the bidding.
    Object oSetFormatTest is a cTest
        Procedure Test
            Pointer pArchive
            Integer iResult
            String sFile

            Delegate Get TempFile "setformat.tar" to sFile
            Delegate Get BuildSampleArchiveFile sFile ARCHIVE_FORMAT_TAR ARCHIVE_FILTER_NONE to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "build sample tar"
            Move (archive_read_new ()) to pArchive
            Move (archive_read_set_format (pArchive, ARCHIVE_FORMAT_TAR)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_format tar"
            Delegate Send VerifyFile pArchive sFile "set_format tar" True ARCHIVE_FORMAT_TAR ARCHIVE_FORMAT_BASE_MASK
            Delegate Send DeleteFileUtf8 sFile

            Move (archive_read_new ()) to pArchive
            Move (archive_read_set_format (pArchive, ARCHIVE_FORMAT_ZIP)) to iResult
            Send AssertIAreEqual ARCHIVE_OK iResult "set_format zip"
            Move (archive_read_set_format (pArchive, ARCHIVE_FORMAT_SHAR)) to iResult
            Send AssertIAreEqual ARCHIVE_FATAL iResult "set_format with a format without reader"
            Move (archive_read_free (pArchive)) to iResult
        End_Procedure
    End_Object

